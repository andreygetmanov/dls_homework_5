[{"start": 62.66, "end": 66.14, "text": " Azog, he's trying to cut us off.", "words": [{"start": 62.66, "end": 63.1, "word": " Azog,"}, {"start": 64.66, "end": 65.1, "word": " he's"}, {"start": 65.1, "end": 65.3, "word": " trying"}, {"start": 65.3, "end": 65.46, "word": " to"}, {"start": 65.46, "end": 65.66, "word": " cut"}, {"start": 65.66, "end": 65.88, "word": " us"}, {"start": 65.88, "end": 66.14, "word": " off."}]}, {"start": 80.65, "end": 167.81, "text": " Where are my children?", "words": [{"start": 80.65, "end": 81.09, "word": " Where"}, {"start": 167.33, "end": 167.49, "word": " are"}, {"start": 167.49, "end": 167.55, "word": " my"}, {"start": 167.55, "end": 167.81, "word": " children?"}]}, {"start": 171.24, "end": 171.96, "text": " The market.", "words": [{"start": 171.24, "end": 171.68, "word": " The"}, {"start": 171.68, "end": 171.96, "word": " market."}]}, {"start": 173.04, "end": 173.92, "text": " Where are they now?", "words": [{"start": 173.04, "end": 173.48, "word": " Where"}, {"start": 173.48, "end": 173.6, "word": " are"}, {"start": 173.6, "end": 173.7, "word": " they"}, {"start": 173.7, "end": 173.92, "word": " now?"}]}, {"start": 174.84, "end": 175.12, "text": " Janna!", "words": [{"start": 174.84, "end": 175.12, "word": " Janna!"}]}, {"start": 175.84, "end": 176.28, "text": " Sigrid!", "words": [{"start": 175.84, "end": 176.28, "word": " Sigrid!"}]}, {"start": 176.68, "end": 178.94, "text": " Bard, orcs are storming over the causeway.", "words": [{"start": 176.68, "end": 176.98, "word": " Bard,"}, {"start": 177.14, "end": 177.74, "word": " orcs"}, {"start": 177.74, "end": 177.86, "word": " are"}, {"start": 177.86, "end": 178.2, "word": " storming"}, {"start": 178.2, "end": 178.34, "word": " over"}, {"start": 178.34, "end": 178.5, "word": " the"}, {"start": 178.5, "end": 178.94, "word": " causeway."}]}, {"start": 180.42, "end": 182.14, "text": " Get the bowmen to the eastern parapet.", "words": [{"start": 180.42, "end": 180.86, "word": " Get"}, {"start": 180.86, "end": 181.0, "word": " the"}, {"start": 181.0, "end": 181.24, "word": " bowmen"}, {"start": 181.24, "end": 181.38, "word": " to"}, {"start": 181.38, "end": 181.46, "word": " the"}, {"start": 181.46, "end": 181.68, "word": " eastern"}, {"start": 181.68, "end": 182.14, "word": " parapet."}]}, {"start": 182.3, "end": 183.66, "text": " Hold them off for as long as you can.", "words": [{"start": 182.3, "end": 182.64, "word": " Hold"}, {"start": 182.64, "end": 182.78, "word": " them"}, {"start": 182.78, "end": 182.9, "word": " off"}, {"start": 182.9, "end": 183.04, "word": " for"}, {"start": 183.04, "end": 183.14, "word": " as"}, {"start": 183.14, "end": 183.24, "word": " long"}, {"start": 183.24, "end": 183.36, "word": " as"}, {"start": 183.36, "end": 183.48, "word": " you"}, {"start": 183.48, "end": 183.66, "word": " can."}]}, {"start": 183.9, "end": 185.04, "text": " Archers, this way!", "words": [{"start": 183.9, "end": 184.34, "word": " Archers,"}, {"start": 184.42, "end": 184.86, "word": " this"}, {"start": 184.86, "end": 185.04, "word": " way!"}]}, {"start": 188.42, "end": 189.92, "text": " The market shall be right!", "words": [{"start": 188.42, "end": 188.76, "word": " The"}, {"start": 188.76, "end": 189.12, "word": " market"}, {"start": 189.12, "end": 189.44, "word": " shall"}, {"start": 189.44, "end": 189.58, "word": " be"}, {"start": 189.58, "end": 189.92, "word": " right!"}]}, {"start": 193.37, "end": 195.89, "text": " The rest of you, follow me!", "words": [{"start": 193.37, "end": 193.81, "word": " The"}, {"start": 193.81, "end": 193.99, "word": " rest"}, {"start": 193.99, "end": 194.09, "word": " of"}, {"start": 194.09, "end": 194.23, "word": " you,"}, {"start": 194.31, "end": 195.63, "word": " follow"}, {"start": 195.63, "end": 195.89, "word": " me!"}]}, {"start": 339.7, "end": 342.0, "text": " Listen, I need you to gather the women and children,", "words": [{"start": 339.7, "end": 340.14, "word": " Listen,"}, {"start": 340.14, "end": 340.58, "word": " I"}, {"start": 340.58, "end": 340.82, "word": " need"}, {"start": 340.82, "end": 340.96, "word": " you"}, {"start": 340.96, "end": 341.04, "word": " to"}, {"start": 341.04, "end": 341.28, "word": " gather"}, {"start": 341.28, "end": 341.42, "word": " the"}, {"start": 341.42, "end": 341.62, "word": " women"}, {"start": 341.62, "end": 341.74, "word": " and"}, {"start": 341.74, "end": 342.0, "word": " children,"}]}, {"start": 342.48, "end": 344.9, "text": " take them to the great hall and barricade the door.", "words": [{"start": 342.48, "end": 342.7, "word": " take"}, {"start": 342.7, "end": 342.86, "word": " them"}, {"start": 342.86, "end": 342.98, "word": " to"}, {"start": 342.98, "end": 343.06, "word": " the"}, {"start": 343.06, "end": 343.3, "word": " great"}, {"start": 343.3, "end": 343.52, "word": " hall"}, {"start": 343.52, "end": 344.04, "word": " and"}, {"start": 344.04, "end": 344.58, "word": " barricade"}, {"start": 344.58, "end": 344.72, "word": " the"}, {"start": 344.72, "end": 344.9, "word": " door."}]}, {"start": 345.62, "end": 346.38, "text": " You understand?", "words": [{"start": 345.62, "end": 346.06, "word": " You"}, {"start": 346.06, "end": 346.38, "word": " understand?"}]}, {"start": 348.0, "end": 350.04, "text": " He must not come out for any reason.", "words": [{"start": 348.0, "end": 348.44, "word": " He"}, {"start": 348.44, "end": 348.64, "word": " must"}, {"start": 348.64, "end": 348.84, "word": " not"}, {"start": 348.84, "end": 349.04, "word": " come"}, {"start": 349.04, "end": 349.24, "word": " out"}, {"start": 349.24, "end": 349.38, "word": " for"}, {"start": 349.38, "end": 349.62, "word": " any"}, {"start": 349.62, "end": 350.04, "word": " reason."}]}, {"start": 350.16, "end": 351.06, "text": " We want to stay with you.", "words": [{"start": 350.16, "end": 350.2, "word": " We"}, {"start": 350.2, "end": 350.34, "word": " want"}, {"start": 350.34, "end": 350.46, "word": " to"}, {"start": 350.46, "end": 350.64, "word": " stay"}, {"start": 350.64, "end": 350.84, "word": " with"}, {"start": 350.84, "end": 351.06, "word": " you."}]}, {"start": 351.38, "end": 353.34, "text": " Show your father some respect.", "words": [{"start": 351.38, "end": 351.66, "word": " Show"}, {"start": 351.66, "end": 351.98, "word": " your"}, {"start": 351.98, "end": 352.46, "word": " father"}, {"start": 352.46, "end": 352.76, "word": " some"}, {"start": 352.76, "end": 353.34, "word": " respect."}]}, {"start": 354.68, "end": 356.06, "text": " You leave it to me, sire.", "words": [{"start": 354.68, "end": 355.12, "word": " You"}, {"start": 355.12, "end": 355.3, "word": " leave"}, {"start": 355.3, "end": 355.42, "word": " it"}, {"start": 355.42, "end": 355.52, "word": " to"}, {"start": 355.52, "end": 355.7, "word": " me,"}, {"start": 355.8, "end": 356.06, "word": " sire."}]}, {"start": 356.28, "end": 358.38, "text": " You heard him. We make to the great hall.", "words": [{"start": 356.28, "end": 356.5, "word": " You"}, {"start": 356.5, "end": 356.68, "word": " heard"}, {"start": 356.68, "end": 356.9, "word": " him."}, {"start": 357.04, "end": 357.48, "word": " We"}, {"start": 357.48, "end": 357.68, "word": " make"}, {"start": 357.68, "end": 357.8, "word": " to"}, {"start": 357.8, "end": 357.92, "word": " the"}, {"start": 357.92, "end": 358.14, "word": " great"}, {"start": 358.14, "end": 358.38, "word": " hall."}]}, {"start": 358.72, "end": 359.16, "text": " Alfred!", "words": [{"start": 358.72, "end": 359.16, "word": " Alfred!"}]}, {"start": 360.78, "end": 362.26, "text": " Women and children only.", "words": [{"start": 360.78, "end": 361.22, "word": " Women"}, {"start": 361.22, "end": 361.66, "word": " and"}, {"start": 361.66, "end": 361.94, "word": " children"}, {"start": 361.94, "end": 362.26, "word": " only."}]}, {"start": 362.26, "end": 367.56, "text": " I need every man fighting. See that you return. I'll get them into safety, sir.", "words": [{"start": 362.26, "end": 362.74, "word": " I"}, {"start": 362.74, "end": 363.12, "word": " need"}, {"start": 363.12, "end": 363.38, "word": " every"}, {"start": 363.38, "end": 363.66, "word": " man"}, {"start": 363.66, "end": 364.04, "word": " fighting."}, {"start": 364.36, "end": 364.88, "word": " See"}, {"start": 364.88, "end": 365.06, "word": " that"}, {"start": 365.06, "end": 365.12, "word": " you"}, {"start": 365.12, "end": 365.3, "word": " return."}, {"start": 366.12, "end": 366.64, "word": " I'll"}, {"start": 366.64, "end": 366.76, "word": " get"}, {"start": 366.76, "end": 366.88, "word": " them"}, {"start": 366.88, "end": 366.98, "word": " into"}, {"start": 366.98, "end": 367.26, "word": " safety,"}, {"start": 367.4, "end": 367.56, "word": " sir."}]}, {"start": 369.47, "end": 374.81, "text": " If my sword is yours to command, get up! Look after them.", "words": [{"start": 369.47, "end": 369.99, "word": " If"}, {"start": 369.99, "end": 370.15, "word": " my"}, {"start": 370.15, "end": 370.39, "word": " sword"}, {"start": 370.39, "end": 370.53, "word": " is"}, {"start": 370.53, "end": 370.67, "word": " yours"}, {"start": 370.67, "end": 370.87, "word": " to"}, {"start": 370.87, "end": 371.11, "word": " command,"}, {"start": 371.33, "end": 372.57, "word": " get"}, {"start": 372.57, "end": 372.93, "word": " up!"}, {"start": 373.85, "end": 374.37, "word": " Look"}, {"start": 374.37, "end": 374.55, "word": " after"}, {"start": 374.55, "end": 374.81, "word": " them."}]}, {"start": 375.21, "end": 393.33, "text": " Shift it, granny! Make for the Great Hall!", "words": [{"start": 375.21, "end": 375.73, "word": " Shift"}, {"start": 378.7, "end": 379.34, "word": " it,"}, {"start": 379.38, "end": 379.62, "word": " granny!"}, {"start": 380.16, "end": 380.68, "word": " Make"}, {"start": 392.65, "end": 392.83, "word": " for"}, {"start": 392.83, "end": 392.85, "word": " the"}, {"start": 392.85, "end": 393.07, "word": " Great"}, {"start": 393.07, "end": 393.33, "word": " Hall!"}]}, {"start": 446.86, "end": 450.78, "text": " Thoraskir! Silly!", "words": [{"start": 446.86, "end": 447.38, "word": " Thoraskir!"}, {"start": 450.26, "end": 450.78, "word": " Silly!"}]}, {"start": 462.2, "end": 480.16, "text": " Buggles! We need him! Where is he?", "words": [{"start": 462.2, "end": 462.72, "word": " Buggles!"}, {"start": 462.94, "end": 463.46, "word": " We"}, {"start": 478.82, "end": 479.1, "word": " need"}, {"start": 479.1, "end": 479.32, "word": " him!"}, {"start": 479.42, "end": 479.7, "word": " Where"}, {"start": 479.7, "end": 479.98, "word": " is"}, {"start": 479.98, "end": 480.16, "word": " he?"}]}, {"start": 486.05, "end": 487.09, "text": " Aziz! Thoraskir!", "words": [{"start": 486.05, "end": 486.57, "word": " Aziz!"}, {"start": 486.57, "end": 487.09, "word": " Thoraskir!"}]}, {"start": 525.47, "end": 528.09, "text": " Since when do we forsake our own people?", "words": [{"start": 525.47, "end": 525.99, "word": " Since"}, {"start": 525.99, "end": 526.47, "word": " when"}, {"start": 526.47, "end": 526.69, "word": " do"}, {"start": 526.69, "end": 526.87, "word": " we"}, {"start": 526.87, "end": 527.35, "word": " forsake"}, {"start": 527.35, "end": 527.49, "word": " our"}, {"start": 527.49, "end": 527.71, "word": " own"}, {"start": 527.71, "end": 528.09, "word": " people?"}]}, {"start": 528.09, "end": 532.27, "text": " Oh, Thorin, they are dying out there.", "words": [{"start": 528.09, "end": 528.09, "word": " Oh,"}, {"start": 528.19, "end": 529.91, "word": " Thorin,"}, {"start": 530.01, "end": 531.19, "word": " they"}, {"start": 531.19, "end": 531.37, "word": " are"}, {"start": 531.37, "end": 531.77, "word": " dying"}, {"start": 531.77, "end": 532.03, "word": " out"}, {"start": 532.03, "end": 532.27, "word": " there."}]}, {"start": 532.51, "end": 548.88, "text": " In this mountain, we can fortify, shore up, make safe.", "words": [{"start": 532.51, "end": 532.87, "word": " In"}, {"start": 540.52, "end": 540.76, "word": " this"}, {"start": 540.76, "end": 541.18, "word": " mountain,"}, {"start": 541.4, "end": 541.7, "word": " we"}, {"start": 544.77, "end": 544.93, "word": " can"}, {"start": 544.93, "end": 545.59, "word": " fortify,"}, {"start": 545.69, "end": 546.49, "word": " shore"}, {"start": 547.8, "end": 548.24, "word": " up,"}, {"start": 548.26, "end": 548.5, "word": " make"}, {"start": 548.5, "end": 548.88, "word": " safe."}]}, {"start": 549.12, "end": 559.0, "text": " Yes, we must move the gold further underground to safety.", "words": [{"start": 549.12, "end": 549.64, "word": " Yes,"}, {"start": 549.74, "end": 550.56, "word": " we"}, {"start": 556.68, "end": 556.92, "word": " must"}, {"start": 556.92, "end": 557.12, "word": " move"}, {"start": 557.12, "end": 557.36, "word": " the"}, {"start": 557.36, "end": 557.58, "word": " gold"}, {"start": 557.58, "end": 557.84, "word": " further"}, {"start": 557.84, "end": 558.24, "word": " underground"}, {"start": 558.24, "end": 558.7, "word": " to"}, {"start": 558.7, "end": 559.0, "word": " safety."}]}, {"start": 559.36, "end": 560.16, "text": " Did you not hear me?", "words": [{"start": 559.36, "end": 559.54, "word": " Did"}, {"start": 559.54, "end": 559.66, "word": " you"}, {"start": 559.66, "end": 559.78, "word": " not"}, {"start": 559.78, "end": 559.96, "word": " hear"}, {"start": 559.96, "end": 560.16, "word": " me?"}]}, {"start": 560.58, "end": 561.72, "text": " Dean is surrounded.", "words": [{"start": 560.58, "end": 560.92, "word": " Dean"}, {"start": 560.92, "end": 561.22, "word": " is"}, {"start": 561.22, "end": 561.72, "word": " surrounded."}]}, {"start": 562.32, "end": 563.78, "text": " They'll be slaughtered, Thorin.", "words": [{"start": 562.32, "end": 562.84, "word": " They'll"}, {"start": 562.84, "end": 562.98, "word": " be"}, {"start": 562.98, "end": 563.42, "word": " slaughtered,"}, {"start": 563.52, "end": 563.78, "word": " Thorin."}]}, {"start": 566.75, "end": 567.91, "text": " Many die in war.", "words": [{"start": 566.75, "end": 567.27, "word": " Many"}, {"start": 567.27, "end": 567.51, "word": " die"}, {"start": 567.51, "end": 567.69, "word": " in"}, {"start": 567.69, "end": 567.91, "word": " war."}]}, {"start": 569.45, "end": 570.51, "text": " Life is cheap.", "words": [{"start": 569.45, "end": 569.97, "word": " Life"}, {"start": 569.97, "end": 570.19, "word": " is"}, {"start": 570.19, "end": 570.51, "word": " cheap."}]}, {"start": 576.04, "end": 577.96, "text": " Cannot be counted in lives lost.", "words": [{"start": 576.04, "end": 576.54, "word": " Cannot"}, {"start": 576.54, "end": 576.64, "word": " be"}, {"start": 576.64, "end": 577.0, "word": " counted"}, {"start": 577.0, "end": 577.28, "word": " in"}, {"start": 577.28, "end": 577.58, "word": " lives"}, {"start": 577.58, "end": 577.96, "word": " lost."}]}, {"start": 578.2, "end": 585.04, "text": " But blood we can spend.", "words": [{"start": 578.2, "end": 578.5, "word": " But"}, {"start": 583.78, "end": 584.12, "word": " blood"}, {"start": 584.12, "end": 584.3, "word": " we"}, {"start": 584.3, "end": 584.48, "word": " can"}, {"start": 584.48, "end": 585.04, "word": " spend."}]}, {"start": 585.04, "end": 595.85, "text": " You sit here in these vast halls, with a crown upon your head, and yet you are lesser now than you have ever been.", "words": [{"start": 585.04, "end": 585.78, "word": " You"}, {"start": 587.61, "end": 587.97, "word": " sit"}, {"start": 587.97, "end": 588.29, "word": " here"}, {"start": 588.29, "end": 588.51, "word": " in"}, {"start": 588.51, "end": 588.71, "word": " these"}, {"start": 588.71, "end": 589.01, "word": " vast"}, {"start": 589.01, "end": 589.45, "word": " halls,"}, {"start": 589.77, "end": 590.35, "word": " with"}, {"start": 590.35, "end": 590.49, "word": " a"}, {"start": 590.49, "end": 590.83, "word": " crown"}, {"start": 590.83, "end": 591.35, "word": " upon"}, {"start": 591.35, "end": 591.57, "word": " your"}, {"start": 591.57, "end": 591.87, "word": " head,"}, {"start": 591.99, "end": 592.31, "word": " and"}, {"start": 593.59, "end": 593.81, "word": " yet"}, {"start": 593.81, "end": 593.99, "word": " you"}, {"start": 593.99, "end": 594.13, "word": " are"}, {"start": 594.13, "end": 594.45, "word": " lesser"}, {"start": 594.45, "end": 594.71, "word": " now"}, {"start": 594.71, "end": 594.97, "word": " than"}, {"start": 594.97, "end": 595.13, "word": " you"}, {"start": 595.13, "end": 595.29, "word": " have"}, {"start": 595.29, "end": 595.55, "word": " ever"}, {"start": 595.55, "end": 595.85, "word": " been."}]}]