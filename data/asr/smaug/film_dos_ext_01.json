": 84.61, "word": " the"}, {"start": 84.61, "end": 84.87, "word": " man"}, {"start": 84.87, "end": 85.17, "word": " can"}, {"start": 85.17, "end": 85.39, "word": " be"}, {"start": 85.39, "end": 85.81, "word": " reasoned"}, {"start": 85.81, "end": 86.01, "word": " with"}]}, {"start": 86.01, "end": 86.57, "text": " however", "words": [{"start": 86.01, "end": 86.57, "word": " however"}]}, {"start": 86.57, "end": 89.73, "text": " he is not over fond of dwarves", "words": [{"start": 86.57, "end": 87.57, "word": " he"}, {"start": 87.57, "end": 87.73, "word": " is"}, {"start": 87.73, "end": 87.93, "word": " not"}, {"start": 87.93, "end": 88.27, "word": " over"}, {"start": 88.27, "end": 88.61, "word": " fond"}, {"start": 88.61, "end": 88.91, "word": " of"}, {"start": 88.91, "end": 89.73, "word": " dwarves"}]}, {"start": 89.73, "end": 93.97, "text": " he's leaving", "words": [{"start": 89.73, "end": 90.73, "word": " he's"}, {"start": 93.61, "end": 93.97, "word": " leaving"}]}, {"start": 93.97, "end": 96.15, "text": " come away from there", "words": [{"start": 93.97, "end": 94.91, "word": " come"}, {"start": 94.91, "end": 95.41, "word": " away"}, {"start": 95.41, "end": 95.89, "word": " from"}, {"start": 95.89, "end": 96.15, "word": " there"}]}, {"start": 96.15, "end": 97.93, "text": " it's not natural", "words": [{"start": 96.15, "end": 97.23, "word": " it's"}, {"start": 97.23, "end": 97.41, "word": " not"}, {"start": 97.41, "end": 97.93, "word": " natural"}]}, {"start": 97.93, "end": 102.51, "text": " None of it. It's obvious. He's under some dark spell.", "words": [{"start": 97.93, "end": 98.47, "word": " None"}, {"start": 98.47, "end": 98.67, "word": " of"}, {"start": 98.67, "end": 98.83, "word": " it."}, {"start": 99.41, "end": 99.99, "word": " It's"}, {"start": 99.99, "end": 100.19, "word": " obvious."}, {"start": 100.65, "end": 101.23, "word": " He's"}, {"start": 101.23, "end": 101.37, "word": " under"}, {"start": 101.37, "end": 101.63, "word": " some"}, {"start": 101.63, "end": 102.01, "word": " dark"}, {"start": 102.01, "end": 102.51, "word": " spell."}]}, {"start": 102.83, "end": 105.97, "text": " Don't be a fool. He's under no enchantment but his own.", "words": [{"start": 102.83, "end": 103.23, "word": " Don't"}, {"start": 103.23, "end": 103.31, "word": " be"}, {"start": 103.31, "end": 103.45, "word": " a"}, {"start": 103.45, "end": 103.77, "word": " fool."}, {"start": 104.13, "end": 104.59, "word": " He's"}, {"start": 104.59, "end": 104.73, "word": " under"}, {"start": 104.73, "end": 104.95, "word": " no"}, {"start": 104.95, "end": 105.49, "word": " enchantment"}, {"start": 105.49, "end": 105.61, "word": " but"}, {"start": 105.61, "end": 105.75, "word": " his"}, {"start": 105.75, "end": 105.97, "word": " own."}]}, {"start": 107.05, "end": 112.03, "text": " Right, now, get some sleep, all of you. You'll be safe here tonight.", "words": [{"start": 107.05, "end": 107.63, "word": " Right,"}, {"start": 107.73, "end": 107.89, "word": " now,"}, {"start": 108.05, "end": 108.69, "word": " get"}, {"start": 108.69, "end": 109.03, "word": " some"}, {"start": 109.03, "end": 109.47, "word": " sleep,"}, {"start": 109.51, "end": 109.69, "word": " all"}, {"start": 109.69, "end": 109.85, "word": " of"}, {"start": 109.85, "end": 109.95, "word": " you."}, {"start": 110.13, "end": 110.71, "word": " You'll"}, {"start": 110.71, "end": 110.79, "word": " be"}, {"start": 110.79, "end": 111.13, "word": " safe"}, {"start": 111.13, "end": 111.45, "word": " here"}, {"start": 111.45, "end": 112.03, "word": " tonight."}]}, {"start": 392.84, "end": 397.2, "text": " there is no point in arguing we cannot pass through the", "words": [{"start": 392.84, "end": 393.48, "word": " there"}, {"start": 393.48, "end": 394.12, "word": " is"}, {"start": 394.12, "end": 394.26, "word": " no"}, {"start": 394.26, "end": 394.62, "word": " point"}, {"start": 394.62, "end": 394.8, "word": " in"}, {"start": 394.8, "end": 395.2, "word": " arguing"}, {"start": 395.2, "end": 396.28, "word": " we"}, {"start": 396.28, "end": 396.5, "word": " cannot"}, {"start": 396.5, "end": 396.82, "word": " pass"}, {"start": 396.82, "end": 397.04, "word": " through"}, {"start": 397.04, "end": 397.2, "word": " the"}]}, {"start": 397.2, "end": 398.66, "text": " in the wilderland without Bhaon's help.", "words": [{"start": 397.2, "end": 397.2, "word": " in"}, {"start": 397.2, "end": 397.2, "word": " the"}, {"start": 397.2, "end": 397.62, "word": " wilderland"}, {"start": 397.62, "end": 397.88, "word": " without"}, {"start": 397.88, "end": 398.42, "word": " Bhaon's"}, {"start": 398.42, "end": 398.66, "word": " help."}]}, {"start": 399.66, "end": 402.66, "text": " We'll be hunted down before we ever get to the forest.", "words": [{"start": 399.66, "end": 400.14, "word": " We'll"}, {"start": 400.14, "end": 400.2, "word": " be"}, {"start": 400.2, "end": 400.38, "word": " hunted"}, {"start": 400.38, "end": 400.74, "word": " down"}, {"start": 400.74, "end": 401.68, "word": " before"}, {"start": 401.68, "end": 401.9, "word": " we"}, {"start": 401.9, "end": 402.0, "word": " ever"}, {"start": 402.0, "end": 402.16, "word": " get"}, {"start": 402.16, "end": 402.26, "word": " to"}, {"start": 402.26, "end": 402.32, "word": " the"}, {"start": 402.32, "end": 402.66, "word": " forest."}]}, {"start": 403.74, "end": 405.0, "text": " Bilbo, there you are.", "words": [{"start": 403.74, "end": 404.22, "word": " Bilbo,"}, {"start": 404.38, "end": 404.64, "word": " there"}, {"start": 404.64, "end": 404.8, "word": " you"}, {"start": 404.8, "end": 405.0, "word": " are."}]}, {"start": 405.42, "end": 409.0, "text": " Now, this will require some delicate handling.", "words": [{"start": 405.42, "end": 405.9, "word": " Now,"}, {"start": 406.0, "end": 406.52, "word": " this"}, {"start": 406.52, "end": 406.74, "word": " will"}, {"start": 406.74, "end": 407.14, "word": " require"}, {"start": 407.14, "end": 407.82, "word": " some"}, {"start": 407.82, "end": 408.3, "word": " delicate"}, {"start": 408.3, "end": 409.0, "word": " handling."}]}, {"start": 409.42, "end": 411.12, "text": " We must tread very carefully.", "words": [{"start": 409.42, "end": 409.9, "word": " We"}, {"start": 409.9, "end": 410.08, "word": " must"}, {"start": 410.08, "end": 410.32, "word": " tread"}, {"start": 410.32, "end": 410.58, "word": " very"}, {"start": 410.58, "end": 411.12, "word": " carefully."}]}, {"start": 411.46, "end": 418.87, "text": " The last person to have startled him, I will go first.", "words": [{"start": 411.46, "end": 411.94, "word": " The"}, {"start": 411.94, "end": 412.18, "word": " last"}, {"start": 412.18, "end": 412.68, "word": " person"}, {"start": 412.68, "end": 412.92, "word": " to"}, {"start": 412.92, "end": 413.08, "word": " have"}, {"start": 413.08, "end": 413.42, "word": " startled"}, {"start": 413.42, "end": 413.7, "word": " him,"}, {"start": 413.8, "end": 414.3, "word": " I"}, {"start": 418.11, "end": 418.33, "word": " will"}, {"start": 418.33, "end": 418.49, "word": " go"}, {"start": 418.49, "end": 418.87, "word": " first."}]}, {"start": 419.31, "end": 421.17, "text": " Bilbo, you come with me.", "words": [{"start": 419.31, "end": 419.79, "word": " Bilbo,"}, {"start": 420.05, "end": 420.63, "word": " you"}, {"start": 420.63, "end": 420.85, "word": " come"}, {"start": 420.85, "end": 421.03, "word": " with"}, {"start": 421.03, "end": 421.17, "word": " me."}]}, {"start": 423.88, "end": 425.82, "text": " Is this a good idea?", "words": [{"start": 423.88, "end": 424.36, "word": " Is"}, {"start": 424.36, "end": 424.84, "word": " this"}, {"start": 424.84, "end": 425.4, "word": " a"}, {"start": 425.4, "end": 425.56, "word": " good"}, {"start": 425.56, "end": 425.82, "word": " idea?"}]}, {"start": 426.08, "end": 428.3, "text": " Yes. Now, the rest of you, you just wait here", "words": [{"start": 426.08, "end": 426.38, "word": " Yes."}, {"start": 426.46, "end": 426.68, "word": " Now,"}, {"start": 426.72, "end": 426.8, "word": " the"}, {"start": 426.8, "end": 427.02, "word": " rest"}, {"start": 427.02, "end": 427.16, "word": " of"}, {"start": 427.16, "end": 427.34, "word": " you,"}, {"start": 427.38, "end": 427.52, "word": " you"}, {"start": 427.52, "end": 427.72, "word": " just"}, {"start": 427.72, "end": 428.0, "word": " wait"}, {"start": 428.0, "end": 428.3, "word": " here"}]}, {"start": 428.3, "end": 431.32, "text": " and don't come out until I give the signal.", "words": [{"start": 428.3, "end": 428.96, "word": " and"}, {"start": 428.96, "end": 429.48, "word": " don't"}, {"start": 429.48, "end": 429.64, "word": " come"}, {"start": 429.64, "end": 429.9, "word": " out"}, {"start": 429.9, "end": 430.54, "word": " until"}, {"start": 430.54, "end": 430.76, "word": " I"}, {"start": 430.76, "end": 430.92, "word": " give"}, {"start": 430.92, "end": 431.04, "word": " the"}, {"start": 431.04, "end": 431.32, "word": " signal."}]}, {"start": 431.32, "end": 432.64, "text": " Right. Wait for the signal.", "words": [{"start": 431.32, "end": 431.64, "word": " Right."}, {"start": 431.74, "end": 432.14, "word": " Wait"}, {"start": 432.14, "end": 432.3, "word": " for"}, {"start": 432.3, "end": 432.38, "word": " the"}, {"start": 432.38, "end": 432.64, "word": " signal."}]}, {"start": 432.82, "end": 436.22, "text": " No sudden moves or loud noises, and don't overcrowd him.", "words": [{"start": 432.82, "end": 433.12, "word": " No"}, {"start": 433.12, "end": 433.48, "word": " sudden"}, {"start": 433.48, "end": 433.86, "word": " moves"}, {"start": 433.86, "end": 434.16, "word": " or"}, {"start": 434.16, "end": 434.46, "word": " loud"}, {"start": 434.46, "end": 434.96, "word": " noises,"}, {"start": 435.1, "end": 435.24, "word": " and"}, {"start": 435.24, "end": 435.52, "word": " don't"}, {"start": 435.52, "end": 435.96, "word": " overcrowd"}, {"start": 435.96, "end": 436.22, "word": " him."}]}, {"start": 436.84, "end": 444.58, "text": " Only come out. You can't just do so. You should come out alone.", "words": [{"start": 436.84, "end":