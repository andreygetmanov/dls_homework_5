28, "end": 103.46, "word": " were"}, {"start": 103.46, "end": 103.82, "word": " many."}]}, {"start": 105.12, "end": 105.9, "text": " And now?", "words": [{"start": 105.12, "end": 105.58, "word": " And"}, {"start": 105.58, "end": 105.9, "word": " now?"}]}, {"start": 106.12, "end": 116.31, "text": " Now there is only one. We need to reach the mountain before the last days of autumn.", "words": [{"start": 106.12, "end": 106.48, "word": " Now"}, {"start": 108.27, "end": 108.49, "word": " there"}, {"start": 108.49, "end": 108.63, "word": " is"}, {"start": 108.63, "end": 108.91, "word": " only"}, {"start": 108.91, "end": 109.25, "word": " one."}, {"start": 109.39, "end": 109.43, "word": " We"}, {"start": 112.79, "end": 112.85, "word": " need"}, {"start": 112.85, "end": 112.95, "word": " to"}, {"start": 112.95, "end": 113.21, "word": " reach"}, {"start": 113.21, "end": 113.53, "word": " the"}, {"start": 113.53, "end": 113.87, "word": " mountain"}, {"start": 113.87, "end": 114.79, "word": " before"}, {"start": 114.79, "end": 114.97, "word": " the"}, {"start": 114.97, "end": 115.27, "word": " last"}, {"start": 115.27, "end": 115.65, "word": " days"}, {"start": 115.65, "end": 115.93, "word": " of"}, {"start": 115.93, "end": 116.31, "word": " autumn."}]}, {"start": 116.73, "end": 118.35, "text": " Before Dorian's Day falls?", "words": [{"start": 116.73, "end": 117.13, "word": " Before"}, {"start": 117.13, "end": 117.83, "word": " Dorian's"}, {"start": 117.83, "end": 117.95, "word": " Day"}, {"start": 117.95, "end": 118.35, "word": " falls?"}]}, {"start": 118.69, "end": 119.01, "text": " Yes.", "words": [{"start": 118.69, "end": 119.01, "word": " Yes."}]}, {"start": 121.66, "end": 124.18, "text": " Which is why we must go through Mechwood.", "words": [{"start": 121.66, "end": 122.3, "word": " Which"}, {"start": 122.3, "end": 122.42, "word": " is"}, {"start": 122.42, "end": 122.64, "word": " why"}, {"start": 122.64, "end": 122.78, "word": " we"}, {"start": 122.78, "end": 122.98,