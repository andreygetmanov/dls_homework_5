[{"start": 1.52, "end": 4.88, "text": " Oh, and here are some more of our happy troop.", "words": [{"start": 1.52, "end": 2.1, "word": " Oh,"}, {"start": 2.1, "end": 2.3, "word": " and"}, {"start": 2.3, "end": 2.56, "word": " here"}, {"start": 2.56, "end": 2.78, "word": " are"}, {"start": 2.78, "end": 3.18, "word": " some"}, {"start": 3.18, "end": 3.4, "word": " more"}, {"start": 3.4, "end": 3.56, "word": " of"}, {"start": 3.56, "end": 3.82, "word": " our"}, {"start": 3.82, "end": 4.4, "word": " happy"}, {"start": 4.4, "end": 4.88, "word": " troop."}]}, {"start": 5.39, "end": 7.6, "text": " And do you call six a troop?", "words": [{"start": 5.39, "end": 5.72, "word": " And"}, {"start": 5.72, "end": 5.84, "word": " do"}, {"start": 5.84, "end": 5.92, "word": " you"}, {"start": 5.92, "end": 6.14, "word": " call"}, {"start": 6.14, "end": 6.56, "word": " six"}, {"start": 6.56, "end": 7.18, "word": " a"}, {"start": 7.18, "end": 7.6, "word": " troop?"}]}, {"start": 8.36, "end": 10.74, "text": " What are you, a traveling circus?", "words": [{"start": 8.36, "end": 9.02, "word": " What"}, {"start": 9.02, "end": 9.26, "word": " are"}, {"start": 9.26, "end": 9.58, "word": " you,"}, {"start": 9.66, "end": 9.96, "word": " a"}, {"start": 9.96, "end": 10.34, "word": " traveling"}, {"start": 10.34, "end": 10.74, "word": " circus?"}]}, {"start": 17.33, "end": 21.33, "text": " Nore and Ore, at your service.", "words": [{"start": 17.33, "end": 17.99, "word": " Nore"}, {"start": 17.99, "end": 18.31, "word": " and"}, {"start": 18.31, "end": 19.03, "word": " Ore,"}, {"start": 19.21, "end": 20.43, "word": " at"}, {"start": 20.43, "end": 20.69, "word": " your"}, {"start": 20.69, "end": 21.33, "word": " service."}]}, {"start": 21.55, "end": 22.95, "text": " I don't want your service.", "words": [{"start": 21.55, "end": 21.73, "word": " I"}, {"start": 21.73, "end": 21.97, "word": " don't"}, {"start": 21.97, "end": 22.17, "word": " want"}, {"start": 22.17, "end": 22.37, "word": " your"}, {"start": 22.37, "end": 22.95, "word": " service."}]}, {"start": 23.17, "end": 24.37, "text": " Absolutely understandable.", "words": [{"start": 23.17, "end": 23.57, "word": " Absolutely"}, {"start": 23.57, "end": 24.37, "word": " understandable."}]}, {"start": 28.78, "end": 31.48, "text": " Oh, Phoebe and Keely have quite forgotten.", "words": [{"start": 28.78, "end": 29.14, "word": " Oh,"}, {"start": 29.5, "end": 29.94, "word": " Phoebe"}, {"start": 29.94, "end": 30.1, "word": " and"}, {"start": 30.1, "end": 30.46, "word": " Keely"}, {"start": 30.46, "end": 30.94, "word": " have"}, {"start": 30.94, "end": 31.14, "word": " quite"}, {"start": 31.14, "end": 31.48, "word": " forgotten."}]}, {"start": 32.18, "end": 36.24, "text": " Oh, yes, and Nore, both before.", "words": [{"start": 32.18, "end": 32.84, "word": " Oh,"}, {"start": 32.88, "end": 33.4, "word": " yes,"}, {"start": 33.5, "end": 33.72, "word": " and"}, {"start": 33.72, "end": 35.02, "word": " Nore,"}, {"start": 35.04, "end": 35.34, "word": " both"}, {"start": 35.34, "end": 36.24, "word": " before."}]}, {"start": 36.9, "end": 47.07, "text": " Is that it? Are there any more?", "words": [{"start": 36.9, "end": 37.28, "word": " Is"}, {"start": 42.05, "end": 42.25, "word": " that"}, {"start": 42.25, "end": 42.59, "word": " it?"}, {"start": 45.83, "end": 46.43, "word": " Are"}, {"start": 46.43, "end": 46.65, "word": " there"}, {"start": 46.65, "end": 46.81, "word": " any"}, {"start": 46.81, "end": 47.07, "word": " more?"}]}, {"start": 47.07, "end": 63.08, "text": " You are the one they call Lucan Shield.", "words": [{"start": 47.07, "end": 47.71, "word": " You"}, {"start": 60.42, "end": 60.9, "word": " are"}, {"start": 60.9, "end": 61.14, "word": " the"}, {"start": 61.14, "end": 61.38, "word": " one"}, {"start": 61.38, "end": 61.62, "word": " they"}, {"start": 61.62, "end": 61.96, "word": " call"}, {"start": 61.96, "end": 62.72, "word": " Lucan"}, {"start": 62.72, "end": 63.08, "word": " Shield."}]}, {"start": 63.5, 