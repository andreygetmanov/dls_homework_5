[{"start": 1.71, "end": 3.07, "text": " What took you so long?", "words": [{"start": 1.71, "end": 2.15, "word": " What"}, {"start": 2.15, "end": 2.43, "word": " took"}, {"start": 2.43, "end": 2.61, "word": " you"}, {"start": 2.61, "end": 2.79, "word": " so"}, {"start": 2.79, "end": 3.07, "word": " long?"}]}, {"start": 7.37, "end": 9.63, "text": " There's too many of these buggers, Thorin.", "words": [{"start": 7.37, "end": 7.85, "word": " There's"}, {"start": 7.85, "end": 7.95, "word": " too"}, {"start": 7.95, "end": 8.37, "word": " many"}, {"start": 8.37, "end": 8.51, "word": " of"}, {"start": 8.51, "end": 8.67, "word": " these"}, {"start": 8.67, "end": 9.25, "word": " buggers,"}, {"start": 9.25, "end": 9.63, "word": " Thorin."}]}, {"start": 10.63, "end": 12.19, "text": " I hope you've got a plan.", "words": [{"start": 10.63, "end": 11.11, "word": " I"}, {"start": 11.11, "end": 11.33, "word": " hope"}, {"start": 11.33, "end": 11.59, "word": " you've"}, {"start": 11.59, "end": 11.75, "word": " got"}, {"start": 11.75, "end": 11.91, "word": " a"}, {"start": 11.91, "end": 12.19, "word": " plan."}]}, {"start": 13.57, "end": 14.03, "text": " Aye.", "words": [{"start": 13.57, "end": 14.03, "word": " Aye."}]}, {"start": 14.87, "end": 16.65, "text": " We're going to take out their leader.", "words": [{"start": 14.87, "end": 15.35, "word": " We're"}, {"start": 15.35, "end": 15.53, "word": " going"}, {"start": 15.53, "end": 15.71, "word": " to"}, {"start": 15.71, "end": 15.97, "word": " take"}, {"start": 15.97, "end": 16.19, "word": " out"}, {"start": 16.19, "end": 16.35, "word": " their"}, {"start": 16.35, "end": 16.65, "word": " leader."}]}, {"start": 18.37, "end": 18.85, "text": " Azog.", "words": [{"start": 18.37, "end": 18.85, "word": " Azog."}]}, {"start": 22.8, "end": 24.92, "text": " I'm going to kill that piece of filth.", "words": [{"start": 22.8, "end": 23.28, "word": " I'm"}, {"start": 23.28, "end": 23.32, "word": " going"}, {"start": 23.32, "end": 23.46, "word": " to"}, {"start": 23.46, "end": 23.76, "word": " kill"}, {"start": 23.76, "end": 23.88, "word": " that"}, {"start": 23.88, "end": 24.16, "word": " piece"}, {"start": 24.16, "end": 24.34, "word": " of"}, {"start": 24.34, "end": 24.92, "word": " filth."}]}, {"start": 25.22, "end": 26.94, "text": " Thorin, you cannot do this.", "words": [{"start": 25.22, "end": 25.7, "word": " Thorin,"}, {"start": 25.78, "end": 25.9, "word": " you"}, {"start": 25.9, "end": 26.24, "word": " cannot"}, {"start": 26.24, "end": 26.58, "word": " do"}, {"start": 26.58, "end": 26.94, "word": " this."}]}, {"start": 27.18, "end": 28.34, "text": " You are our king.", "words": [{"start": 27.18, "end": 27.66, "word": " You"}, {"start": 27.66, "end": 27.8, "word": " are"}, {"start": 27.8, "end": 28.0, "word": " our"}, {"start": 28.0, "end": 28.34, "word": " king."}]}, {"start": 28.96, "end": 30.52, "text": " That is why I must do it.", "words": [{"start": 28.96, "end": 29.44, "word": " That"}, {"start": 29.44, "end": 29.56, "word": " is"}, {"start": 29.56, "end": 29.78, "word": " why"}, {"start": 29.78, "end": 29.98, "word": " I"}, {"start": 29.98, "end": 30.16, "word": " must"}, {"start": 30.16, "end": 30.34, "word": " do"}, {"start": 30.34, "end": 30.52, "word": " it."}]}, {"start": 31.64, "end": 35.32, "text": " And how do you plan to fight your way single-handed to Ravenhill?", "words": [{"start": 31.64, "end": 32.12, "word": " And"}, {"start": 32.12, "end": 32.28, "word": " how"}, {"start": 32.28, "end": 32.42, "word": " do"}, {"start": 32.42, "end": 32.58, "word": " you"}, {"start": 32.58, "end": 32.78, "word": " plan"}, {"start": 32.78, "end": 33.0, "word": " to"}, {"start": 33.0, "end": 33.28, "word": " fight"}, {"start": 33.28, "end": 33.5, "word": " your"}, {"start": 33.5, "end": 33.7, "word": " way"}, {"start": 33.7, "end": 34.08, "word": " single"}, {"start": 34.08, "end": 34.46, "word": "-handed"}, {"start": 34.46, "end": 34.7, "word": " to"}, {"start": 34.7, "end": 35.32, "word": " Ravenhill?"}]}, {"start": 43.92, "end": 45.48, "text": " Well, it's been a while since I've done this.", "words": [{"start": 43.92, "end": 44.4, "word": " Well,"}, {"start": 44.42, "end": 44.5, "word": " it's"}, {"start": 44.5, "end": 44.56, "word": " been"}, {"start": 44.56, "end": 44.66, "word": " a"}, {"start": 44.66, "end": 44.78, "word": " while"}, {"start": 44.78, "end": 44.94, "word": " since"}, {"start": 44.94, "end": 45.12, "word": " I've"}, {"start": 45.12, "end": 45.26, "word": " done"}, {"start": 45.26, "end": 45.48, "word": " this."}]}, {"start": 47.94, "end": 48.42, "text": " Ravenhill!", "words": [{"start": 47.94, "end": 48.42, "word": " Ravenhill!"}]}, {"start": 49.22, "end": 50.18, "text": " Hold tight, lads.", "words": [{"start": 49.22, "end": 49.5, "word": " Hold"}, {"start": 49.5, "end": 49.72, "word": " tight,"}, {"start": 49.76, "end": 50.18, "word": " lads."}]}, {"start": 50.82, "end": 52.5, "text": " You're all mad bastards.", "words": [{"start": 50.82, "end": 51.3, "word": " You're"}, {"start": 51.3, "end": 51.48, "word": " all"}, {"start": 51.48, "end": 51.8, "word": " mad"}, {"start": 51.8, "end": 52.5, "word": " bastards."}]}, {"start": 54.04, "end": 55.26, "text": " I like it.", "words": [{"start": 54.04, "end": 54.52, "word": " I"}, {"start": 54.52, "end": 54.98, "word": " like"}, {"start": 54.98, "end": 55.26, "word": " it."}]}, {"start": 57.4, "end": 59.16, "text": " May Durin save you all.", "words": [{"start": 57.4, "end": 57.86, "word": " May"}, {"start": 57.86, "end": 58.42, "word": " Durin"}, {"start": 58.42, "end": 58.7, "word": " save"}, {"start": 58.7, "end": 58.94, "word": " you"}, {"start": 58.94, "end": 59.16, "word": " all."}]}, {"start": 64.78, "end": 148.12, "text": " But it's not bad.", "words": [{"start": 64.78, "end": 65.26, "word": " But"}, {"start": 147.44, "end": 147.72, "word": " it's"}, {"start": 147.72, "end": 147.76, "word": " not"}, {"start": 147.76, "end": 148.12, "word": " bad."}]}, {"start": 151.4, "end": 237.29, "text": " Pulling too much weight.", "words": [{"start": 151.4, "end": 151.88, "word": " Pulling"}, {"start": 236.71, "end": 236.85, "word": " too"}, {"start": 236.85, "end": 237.07, "word": " much"}, {"start": 237.07, "end": 237.29, "word": " weight."}]}, {"start": 237.55, "end": 238.73, "text": " We won't make it.", "words": [{"start": 237.55, "end": 238.03, "word": " We"}, {"start": 238.03, "end": 238.29, "word": " won't"}, {"start": 238.29, "end": 238.51, "word": " make"}, {"start": 238.51, "end": 238.73, "word": " it."}]}, {"start": 239.29, "end": 240.29, "text": " Cut the tracers.", "words": [{"start": 239.29, "end": 239.77, "word": " Cut"}, {"start": 239.77, "end": 239.91, "word": " the"}, {"start": 239.91, "end": 240.29, "word": " tracers."}]}, {"start": 242.17, "end": 243.45, "text": " Ride them to Ravenhill.", "words": [{"start": 242.17, "end": 242.65, "word": " Ride"}, {"start": 242.65, "end": 242.81, "word": " them"}, {"start": 242.81, "end": 242.95, "word": " to"}, {"start": 242.95, "end": 243.45, "word": " Ravenhill."}]}, {"start": 244.55, "end": 245.51, "text": " No problem.", "words": [{"start": 244.55, "end": 245.11, "word": " No"}, {"start": 245.11, "end": 245.51, "word": " problem."}]}, {"start": 247.5, "end": 249.14, "text": " My co-priding days are over.", "words": [{"start": 247.5, "end": 247.78, "word": " My"}, {"start": 247.78, "end": 248.06, "word": " co"}, {"start": 248.06, "end": 248.34, "word": "-priding"}, {"start": 248.34, "end": 248.68, "word": " days"}, {"start": 248.68, "end": 248.9, "word": " are"}, {"start": 248.9, "end": 249.14, "word": " over."}]}, {"start": 251.53, "end": 253.01, "text": " Do and be with you, brother.", "words": [{"start": 251.53, "end": 252.09, "word": " Do"}, {"start": 252.09, "end": 252.31, "word": " and"}, {"start": 252.31, "end": 252.43, "word": " be"}, {"start": 252.43, "end": 252.59, "word": " with"}, {"start": 252.59, "end": 252.77, "word": " you,"}, {"start": 252.83, "end": 253.01, "word": " brother."}]}, {"start": 253.27, "end": 284.7, "text": " I am too old for this.", "words": [{"start": 253.27, "end": 253.83, "word": " I"}, {"start": 282.6, "end": 282.76, "word": " am"}, {"start": 282.76, "end": 283.14, "word": " too"}, {"start": 283.14, "end": 284.02, "word": " old"}, {"start": 284.02, "end": 284.36, "word": " for"}, {"start": 284.36, "end": 284.7, "word": " this."}]}, {"start": 284.94, "end": 289.79, "text": " We die!", "words": [{"start": 284.94, "end": 285.44, "word": " We"}, {"start": 289.47, "end": 289.79, "word": " die!"}]}, {"start": 321.9, "end": 323.02, "text": " Get up.", "words": [{"start": 321.9, "end": 322.46, "word": " Get"}, {"start": 322.46, "end": 323.02, "word": " up."}]}, {"start": 323.46, "end": 325.0, "text": " Get away from me.", "words": [{"start": 323.46, "end": 324.02, "word": " Get"}, {"start": 324.02, "end": 324.36, "word": " away"}, {"start": 324.36, "end": 324.7, "word": " from"}, {"start": 324.7, "end": 325.0, "word": " me."}]}, {"start": 325.4, "end": 327.1, "text": " I don't take orders from you.", "words": [{"start": 325.4, "end": 325.96, "word": " I"}, {"start": 325.96, "end": 326.16, "word": " don't"}, {"start": 326.16, "end": 326.36, "word": " take"}, {"start": 326.36, "end": 326.6, "word": " orders"}, {"start": 326.6, "end": 326.88, "word": " from"}, {"start": 326.88, "end": 327.1, "word": " you."}]}, {"start": 327.26, "end": 328.44, "text": " People trusted you.", "words": [{"start": 327.26, "end": 327.82, "word": " People"}, {"start": 327.82, "end": 328.22, "word": " trusted"}, {"start": 328.22, "end": 328.44, "word": " you."}]}, {"start": 328.48, "end": 329.44, "text": " They listened to you.", "words": [{"start": 328.48, "end": 328.72, "word": " They"}, {"start": 328.72, "end": 329.04, "word": " listened"}, {"start": 329.04, "end": 329.26, "word": " to"}, {"start": 329.26, "end": 329.44, "word": " you."}]}, {"start": 329.96, "end": 332.48, "text": " The master's mantle was there for the taking.", "words": [{"start": 329.96, "end": 330.24, "word": " The"}, {"start": 330.24, "end": 330.82, "word": " master's"}, {"start": 330.82, "end": 331.04, "word": " mantle"}, {"start": 331.04, "end": 331.62, "word": " was"}, {"start": 331.62, "end": 331.84, "word": " there"}, {"start": 331.84, "end": 332.02, "word": " for"}, {"start": 332.02, "end": 332.12, "word": " the"}, {"start": 332.12, "end": 332.48, "word": " taking."}]}, {"start": 333.64, "end": 335.18, "text": " And you threw it all away.", "words": [{"start": 333.64, "end": 334.2, "word": " And"}, {"start": 334.2, "end": 334.34, "word": " you"}, {"start": 334.34, "end": 334.56, "word": " threw"}, {"start": 334.56, "end": 334.7, "word": " it"}, {"start": 334.7, "end": 334.86, "word": " all"}, {"start": 334.86, "end": 335.18, "word": " away."}]}, {"start": 336.22, "end": 337.12, "text": " For what?", "words": [{"start": 336.22, "end": 336.78, "word": " For"}, {"start": 336.78, "end": 337.12, "word": " what?"}]}, {"start": 346.52, "end": 347.08, "text": " Alfred.", "words": [{"start": 346.52, "end": 347.08, "word": " Alfred."}]}, {"start": 347.08, "end": 348.98, "text": " Your slip is showing.", "words": [{"start": 347.08, "end": 348.34, "word": " Your"}, {"start": 348.34, "end": 348.62, "word": " slip"}, {"start": 348.62, "end": 348.74, "word": " is"}, {"start": 348.74, "end": 348.98, "word": " showing."}]}, {"start": 426.52, "end": 440.65, "text": " We may yet survive this.", "words": [{"start": 426.52, "end": 427.24, "word": " We"}, {"start": 438.73, "end": 439.45, "word": " may"}, {"start": 439.45, "end": 439.71, "word": " yet"}, {"start": 439.71, "end": 440.13, "word": " survive"}, {"start": 440.13, "end": 440.65, "word": " this."}]}, {"start": 451.51, "end": 452.17, "text": " It's Thorin!", "words": [{"start": 451.51, "end": 451.85, "word": " It's"}, {"start": 451.85, "end": 452.17, "word": " Thorin!"}]}, {"start": 452.81, "end": 455.61, "text": " And Filii, Kilii, and Dwalin.", "words": [{"start": 452.81, "end": 453.53, "word": " And"}, {"start": 453.53, "end": 454.05, "word": " Filii,"}, {"start": 454.05, "end": 454.43, "word": " Kilii,"}, {"start": 454.47, "end": 455.25, "word": " and"}, {"start": 455.25, "end": 455.61, "word": " Dwalin."}]}, {"start": 456.43, "end": 458.71, "text": " He's taking his best warriors.", "words": [{"start": 456.43, "end": 457.15, "word": " He's"}, {"start": 457.15, "end": 457.51, "word": " taking"}, {"start": 457.51, "end": 457.85, "word": " his"}, {"start": 457.85, "end": 458.17, "word": " best"}, {"start": 458.17, "end": 458.71, "word": " warriors."}]}, {"start": 459.19, "end": 460.19, "text": " To do what?", "words": [{"start": 459.19, "end": 459.89, "word": " To"}, {"start": 459.89, "end": 459.95, "word": " do"}, {"start": 459.95, "end": 460.19, "word": " what?"}]}, {"start": 461.21, "end": 463.19, "text": " To cut the head off the snake.", "words": [{"start": 461.21, "end": 461.93, "word": " To"}, {"start": 461.93, "end": 462.17, "word": " cut"}, {"start": 462.17, "end": 462.31, "word": " the"}, {"start": 462.31, "end": 462.49, "word": " head"}, {"start": 462.49, "end": 462.63, "word": " off"}, {"start": 462.63, "end": 462.77, "word": " the"}, {"start": 462.77, "end": 463.19, "word": " snake."}]}, {"start": 509.84, "end": 511.18, "text": " Legolas Greenleaf!", "words": [{"start": 509.84, "end": 510.56, "word": " Legolas"}, {"start": 510.56, "end": 511.18, "word": " Greenleaf!"}]}, {"start": 511.92, "end": 513.24, "text": " There is a second army.", "words": [{"start": 511.92, "end": 512.4, "word": " There"}, {"start": 512.4, "end": 512.54, "word": " is"}, {"start": 512.54, "end": 512.6, "word": " a"}, {"start": 512.6, "end": 512.92, "word": " second"}, {"start": 512.92, "end": 513.24, "word": " army."}]}, {"start": 513.54, "end": 515.54, "text": " Borg leads a force of Gundabad orcs.", "words": [{"start": 513.54, "end": 514.02, "word": " Borg"}, {"start": 514.02, "end": 514.26, "word": " leads"}, {"start": 514.26, "end": 514.42, "word": " a"}, {"start": 514.42, "end": 514.62, "word": " force"}, {"start": 514.62, "end": 514.78, "word": " of"}, {"start": 514.78, "end": 515.12, "word": " Gundabad"}, {"start": 515.12, "end": 515.54, "word": " orcs."}]}, {"start": 515.62, "end": 516.7, "text": " They are almost upon us.", "words": [{"start": 515.62, "end": 515.78, "word": " They"}, {"start": 515.78, "end": 515.88, "word": " are"}, {"start": 515.88, "end": 516.18, "word": " almost"}, {"start": 516.18, "end": 516.46, "word": " upon"}, {"start": 516.46, "end": 516.7, "word": " us."}]}, {"start": 516.84, "end": 517.3, "text": " Gundabad?", "words": [{"start": 516.84, "end": 517.3, "word": " Gundabad?"}]}, {"start": 517.84, "end": 520.98, "text": " This was their plan all along.", "words": [{"start": 517.84, "end": 518.32, "word": " This"}, {"start": 519.8, "end": 519.92, "word": " was"}, {"start": 519.92, "end": 520.12, "word": " their"}, {"start": 520.12, "end": 520.4, "word": " plan"}, {"start": 520.4, "end": 520.62, "word": " all"}, {"start": 520.62, "end": 520.98, "word": " along."}]}, {"start": 523.16, "end": 527.32, "text": " Azog engages our forces, then Borg seeps in from the north.", "words": [{"start": 523.16, "end": 523.64, "word": " Azog"}, {"start": 523.64, "end": 524.0, "word": " engages"}, {"start": 524.0, "end": 524.4, "word": " our"}, {"start": 524.4, "end": 524.9, "word": " forces,"}, {"start": 524.96, "end": 525.2, "word": " then"}, {"start": 525.2, "end": 525.76, "word": " Borg"}, {"start": 525.76, "end": 526.4, "word": " seeps"}, {"start": 526.4, "end": 526.68, "word": " in"}, {"start": 526.68, "end": 526.88, "word": " from"}, {"start": 526.88, "end": 527.04, "word": " the"}, {"start": 527.04, "end": 527.32, "word": " north."}]}, {"start": 528.0, "end": 528.96, "text": " The north?", "words": [{"start": 528.0, "end": 528.48, "word": " The"}, {"start": 528.48, "end": 528.96, "word": " north?"}]}, {"start": 529.14, "end": 530.24, "text": " Where is the north?", "words": [{"start": 529.14, "end": 529.38