, "end": 49.03, "word": " quiet."}, {"start": 49.23, "end": 49.47, "word": " I"}, {"start": 49.47, "end": 49.73, "word": " can't"}, {"start": 49.73, "end": 49.95, "word": " hear"}, {"start": 49.95, "end": 50.11, "word": " when"}, {"start": 50.11, "end": 50.31, "word": " you're"}, {"start": 50.31, "end": 50.53, "word": " thumping."}]}, {"start": 50.85, "end": 51.71, "text": " I can't find it.", "words": [{"start": 50.85, "end": 51.11, "word": " I"}, {"start": 51.11, "end": 51.39, "word": " can't"}, {"start": 51.39, "end": 51.55, "word": " find"}, {"start": 51.55, "end": 51.71, "word": " it."}]}, {"start": 53.21, "end": 55.81, "text": " It's not here! It's not here!", "words": [{"start": 53.21, "end": 53.77, "word": " It's"}, {"start": 53.77, "end": 53.95, "word": " not"}, {"start": 53.95, "end": 54.21, "word": " here!"}, {"start": 54.75, "end": 55.13, "word": " It's"}, {"start": 55.13, "end": 55.23, "word": " not"}, {"start": 55.23, "end": 55.81, "word": " here!"}]}, {"start": 57.31, "end": 58.33, "text": " Break it down!", "words": [{"start": 57.31, "end": 57.87, "word": " Break"}, {"start": 57.87, "end": 58.07, "word": " it"}, {"start": 58.07, "end": 58.33, "word": " down!"}]}, {"start": 66.87, "end": 70.77, "text": " It's no good! The door's sealed! It can't be opened before us!", "words": [{"start": 66.87, "end": 67.39, "word": " It's"}, {"start": 67.39, "end": 67.41, "word": " no"}, {"start": 67.41, "end": 67.67, "word": " good!"}, {"start": 67.93, "end": 68.33, "word": " The"}, {"start": 68.33, "end": 68.75, "word": " door's"}, {"start": 68.75, "end": 69.09, "word": " sealed!"}, {"start": 69.29, "end": 69.73, "word": " It"}, {"start": 69.73, "end": 70.01, "word": " can't"}, {"start": 70.01, "end": 70.07, "word": " be"}, {"start": 70.07, "end": 70.25, "word": " opened"}, {"start": 70.25, "end": 70.53, "word": " before"}, {"start": 70.53, "end": 70.77, "word": " us!"}]}, {"start": 72.77, "end": 74.03, "text": " Powerful magic, aren't it?", "words": [{"start": 72.