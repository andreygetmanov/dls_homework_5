.94, "word": " done."}, {"start": 122.84, "end": 123.36, "word": " We"}, {"start": 123.36, "end": 123.58, "word": " had"}, {"start": 123.58, "end": 123.74, "word": " but"}, {"start": 123.74, "end": 123.94, "word": " one"}, {"start": 123.94, "end": 124.3, "word": " chance."}]}, {"start": 124.3, "end": 128.52, "text": " Lance, come away, Lance.", "words": [{"start": 124.3, "end": 124.5, "word": " Lance,"}, {"start": 124.58, "end": 125.44, "word": " come"}, {"start": 127.94, "end": 128.16, "word": " away,"}, {"start": 128.22, "end": 128.52, "word": " Lance."}]}, {"start": 129.12, "end": 129.86, "text": " It's over.", "words": [{"start": 129.12, "end": 129.68, "word": " It's"}, {"start": 129.68, "end": 129.86, "word": " over."}]}, {"start": 131.78, "end": 132.56, "text": " Wait a minute.", "words": [{"start": 131.78, "end": 132.34, "word": " Wait"}, {"start": 132.34, "end": 132.44, "word": " a"}, {"start": 132.44, "end": 132.56, "word": " minute."}]}, {"start": 132.68, "end": 136.33, "text": " Where are they going?", "words": [{"start": 132.68, "end": 133.08, "word": " Where"}, {"start": 133.08, "end": 133.52, "word": " are"}, {"start": 133.52, "end": 134.58, "word": " they"}, {"start": 136.11, "end": 136.33, "word": " going?"}]}, {"start": 139.56, "end": 140.98, "text": " You can't give up now!", "words": [{"start": 139.56, "end": 140.12, "word": " You"}, {"start": 140.12, "end": 140.36, "word": " can't"}, {"start": 140.36, "end": 140.52, "word": " give"}, {"start": 140.52, "end": 140.7, "word": " up"}, {"start": 140.7, "end": 140.98, "word": " now!"}]}, {"start": 156.6, "end": 160.88, "text": " Horan, you can't give up now.", "words": [{"start": 156.6, "end": 157.08, "word": " Horan,"}, {"start": 157.14, "end": 158.08, "word": " you"}, {"start": 160.06, "end": 160.38, "word": " can't"}, {"start": 160.38, "end": 160.5, "word": " give"}, {"start": 160.5, "end": 160.64, "word": " up"}, {"start": 160.64, "end": 160.88, "word": " now."}]}, {"start": 161.2, "end": 174.65, "