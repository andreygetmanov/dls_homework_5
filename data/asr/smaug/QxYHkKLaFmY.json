, "end": 206.41, "text": " I ate his people like a wolf among sheep.", "words": [{"start": 202.37, "end": 203.17, "word": " I"}, {"start": 203.17, "end": 203.55, "word": " ate"}, {"start": 203.55, "end": 203.77, "word": " his"}, {"start": 203.77, "end": 204.21, "word": " people"}, {"start": 204.21, "end": 204.91, "word": " like"}, {"start": 204.91, "end": 205.09, "word": " a"}, {"start": 205.09, "end": 205.45, "word": " wolf"}, {"start": 205.45, "end": 205.89, "word": " among"}, {"start": 205.89, "end": 206.41, "word": " sheep."}]}, {"start": 206.65, "end": 214.72, "text": " I kill where I wish, when I wish.", "words": [{"start": 206.65, "end": 206.99, "word": " I"}, {"start": 210.7, "end": 211.06, "word": " kill"}, {"start": 211.06, "end": 211.52, "word": " where"}, {"start": 211.52, "end": 211.92, "word": " I"}, {"start": 211.92, "end": 212.5, "word": " wish,"}, {"start": 212.7, "end": 213.2, "word": " when"}, {"start": 213.2, "end": 214.0, "word": " I"}, {"start": 214.0, "end": 214.72, "word": " wish."}]}, {"start": 214.72, "end": 218.1, "text": " My armor is iron.", "words": [{"start": 214.72, "end": 215.9, "word": " My"}, {"start": 215.9, "end": 216.68, "word": " armor"}, {"start": 216.68, "end": 217.52, "word": " is"}, {"start": 217.52, "end": 218.1, "word": " iron."}]}, {"start": 218.99, "end": 229.95, "text": " Aid can pierce me.", "words": [{"start": 218.99, "end": 219.4, "word": " Aid"}, {"start": 228.39, "end": 228.87, "word": " can"}, {"start": 228.87, "end": 229.71, "word": " pierce"}, {"start": 229.71, "end": 229.95, "word": " me."}]}, {"start": 232.62, "end": 233.87, "text": " So concealed.", "words": [{"start": 232.62, "end": 233.03, "word": " So"}, {"start": 233.03, "end": 233.87, "word": " concealed."}]}, {"start": 235.12, "end": 237.61, "text": " That filthy dwarfish usurper.", "words": [{"start": 235.12, "end": 235.53, "word": " That"}, {"start": 235.53, "end": 235.97, "word": " filthy"}, {"start": 235.97, "end": 236.83, "word": " dwarfish"}, {"s