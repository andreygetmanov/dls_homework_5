rd": " seeps"}, {"start": 336.74, "end": 336.86, "word": " into"}, {"start": 336.86, "end": 336.98, "word": " the"}, {"start": 336.98, "end": 337.24, "word": " hearts"}, {"start": 337.24, "end": 337.36, "word": " of"}, {"start": 337.36, "end": 337.5, "word": " all"}, {"start": 337.5, "end": 337.62, "word": " who"}, {"start": 337.62, "end": 337.78, "word": " come"}, {"start": 337.78, "end": 337.92, "word": " near"}, {"start": 337.92, "end": 338.08, "word": " this"}, {"start": 338.08, "end": 338.36, "word": " mountain"}, {"start": 338.36, "end": 339.2, "word": " you"}, {"start": 345.34, "end": 345.54, "word": " there"}]}, {"start": 346.18, "end": 347.44, "text": " Find this hobbit a bed", "words": [{"start": 346.18, "end": 346.58, "word": " Find"}, {"start": 346.58, "end": 346.88, "word": " this"}, {"start": 346.88, "end": 347.18, "word": " hobbit"}, {"start": 347.18, "end": 347.26, "word": " a"}, {"start": 347.26, "end": 347.44, "word": " bed"}]}, {"start": 348.5, "end": 353.42, "text": " and fill his belly with hot food, he's earned it.", "words": [{"start": 348.5, "end": 348.66, "word": " and"}, {"start": 348.66, "end": 349.38, "word": " fill"}, {"start": 349.38, "end": 349.54, "word": " his"}, {"start": 349.54, "end": 349.82, "word": " belly"}, {"start": 349.82, "end": 350.08, "word": " with"}, {"start": 350.08, "end": 350.24, "word": " hot"}, {"start": 350.24, "end": 350.66, "word": " food,"}, {"start": 350.86, "end": 353.0, "word": " he's"}, {"start": 353.0, "end": 353.22, "word": " earned"}, {"start": 353.22, "end": 353.42, "word": " it."}]}, {"start": 353.52, "end": 362.2, "text": " If he should try to leave, tell me.", "words": [{"start": 353.52, "end": 353.84, "word": " If"}, {"start": 360.34, "end": 360.42, "word": " he"}, {"start": 360.42, "end": 360.54, "word": " should"}, {"start": 360.54, "end": 360.76, "word": " try"}, {"start": 360.76, "end": 360.86, "word": " to"}, {"start": 360.86, "end": 361.18, "word": " leave,"}, {"start": 361.4, "end": 361.86, "