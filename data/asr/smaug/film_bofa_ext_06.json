[{"start": 10.27, "end": 11.65, "text": " Dean Matthews, are you fine?", "words": [{"start": 10.27, "end": 10.79, "word": " Dean"}, {"start": 10.79, "end": 11.23, "word": " Matthews,"}, {"start": 11.23, "end": 11.29, "word": " are"}, {"start": 11.29, "end": 11.41, "word": " you"}, {"start": 11.41, "end": 11.65, "word": " fine?"}]}, {"start": 12.37, "end": 13.07, "text": " Penny blue.", "words": [{"start": 12.37, "end": 12.89, "word": " Penny"}, {"start": 12.89, "end": 13.07, "word": " blue."}]}, {"start": 13.97, "end": 14.49, "text": " Tolo.", "words": [{"start": 13.97, "end": 14.49, "word": " Tolo."}]}, {"start": 16.19, "end": 16.71, "text": " Go!", "words": [{"start": 16.19, "end": 16.71, "word": " Go!"}]}, {"start": 28.5, "end": 29.02, "text": " Sharpened.", "words": [{"start": 28.5, "end": 29.02, "word": " Sharpened."}]}, {"start": 29.1, "end": 52.75, "text": " You should be inside.", "words": [{"start": 29.1, "end": 29.62, "word": " You"}, {"start": 31.67, "end": 32.43, "word": " should"}, {"start": 51.37, "end": 52.41, "word": " be"}, {"start": 52.41, "end": 52.75, "word": " inside."}]}, {"start": 54.43, "end": 55.41, "text": " Out of the wind.", "words": [{"start": 54.43, "end": 54.95, "word": " Out"}, {"start": 54.95, "end": 55.07, "word": " of"}, {"start": 55.07, "end": 55.15, "word": " the"}, {"start": 55.15, "end": 55.41, "word": " wind."}]}, {"start": 56.61, "end": 60.75, "text": " I, uh, needed some air.", "words": [{"start": 56.61, "end": 57.13, "word": " I,"}, {"start": 57.35, "end": 57.45, "word": " uh,"}, {"start": 57.57, "end": 58.53, "word": " needed"}, {"start": 60.29, "end": 60.53, "word": " some"}, {"start": 60.53, "end": 60.75, "word": " air."}]}, {"start": 60.83, "end": 62.47, "text": " Place still stinks of dragon.", "words": [{"start": 60.83, "end": 61.25, "word": " Place"}, {"start": 61.25, "end": 61.43, "word": " still"}, {"start": 61.43, "end": 61.95, "word": " stinks"}, {"start": 61.95, "end": 62.21, "word": " of"}, {"start": 62.21, "end": 62.47, "word": " dragon."}]}, {"start": 69.34, "end": 71.9, "text": " The elves have been moving their archers into position.", "words": [{"start": 69.34, "end": 69.86, "word": " The"}, {"start": 69.86, "end": 70.24, "word": " elves"}, {"start": 70.24, "end": 70.4, "word": " have"}, {"start": 70.4, "end": 70.54, "word": " been"}, {"start": 70.54, "end": 70.8, "word": " moving"}, {"start": 70.8, "end": 70.98, "word": " their"}, {"start": 70.98, "end": 71.4, "word": " archers"}, {"start": 71.4, "end": 71.58, "word": " into"}, {"start": 71.58, "end": 71.9, "word": " position."}]}, {"start": 72.74, "end": 77.31, "text": " The battle will be over by tomorrow's eve.", "words": [{"start": 72.74, "end": 73.26, "word": " The"}, {"start": 75.47, "end": 75.99, "word": " battle"}, {"start": 75.99, "end": 76.13, "word": " will"}, {"start": 76.13, "end": 76.27, "word": " be"}, {"start": 76.27, "end": 76.45, "word": " over"}, {"start": 76.45, "end": 76.67, "word": " by"}, {"start": 76.67, "end": 77.17, "word": " tomorrow's"}, {"start": 77.17, "end": 77.31, "word": " eve."}]}, {"start": 78.65, "end": 96.1, "text": " though I doubt we will live to see it now these are dark days dark days indeed no one could blame", "words": [{"start": 78.65, "end": 79.09, "word": " though"}, {"start": 79.09, "end": 79.19, "word": " I"}, {"start": 79.19, "end": 79.41, "word": " doubt"}, {"start": 79.41, "end": 79.57, "word": " we"}, {"start": 79.57, "end": 79.73, "word": " will"}, {"start": 79.73, "end": 79.87, "word": " live"}, {"start": 79.87, "end": 79.95, "word": " to"}, {"start": 79.95, "end": 80.19, "word": " see"}, {"start": 80.19, "end": 80.41, "word": " it"}, {"start": 80.41, "end": 81.11, "word": " now"}, {"start": 83.35, "end": 83.57, "word": " these"}, {"start": 83.57, "end": 83.77, "word": " are"}, {"start": 83.77, "end": 85.51, "word": " dark"}, {"start": 85.51, "end": 85.73, "word": " days"}, {"start": 85.73, "end": 86.87, "word": " dark"}, {"start": 88.66, "end": 89.0, "word": " days"}, {"start": 89.0, "end": 89.36, "word": " indeed"}, {"start": 89.36, "end": 90.52, "word": " no"}, {"start": 95.32, "end": 95.6, "word": " one"}, {"start": 95.6, "end": 95.84, "word": " could"}, {"start": 95.84, "end": 96.1, "word": " blame"}]}, {"start": 96.1, "end": 107.7, "text": " a soul for wishing themselves elsewhere what's been here midnight bombers get the next watch", "words": [{"start": 96.1, "end": 96.24, "word": " a"}, {"start": 96.24, "end": 96.52, "word": " soul"}, {"start": 96.52, "end": 96.74, "word": " for"}, {"start": 96.74, "end": 96.94, "word": " wishing"}, {"start": 96.94, "end": 97.26, "word": " themselves"}, {"start": 97.26, "end": 97.92, "word": " elsewhere"}, {"start": 97.92, "end": 98.86, "word": " what's"}, {"start": 104.68, "end": 104.78, "word": " been"}, {"start": 104.78, "end": 104.9, "word": " here"}, {"start": 104.9, "end": 105.04, "word": " midnight"}, {"start": 105.04, "end": 106.8, "word": " bombers"}, {"start": 106.8, "end": 107.08, "word": " get"}, {"start": 107.08, "end": 107.18, "word": " the"}, {"start": 107.18, "end": 107.38, "word": " next"}, {"start": 107.38, "end": 107.7, "word": " watch"}]}, {"start": 108.8, "end": 168.14, "text": " it'll take a bit to wake him Bofa I'll see you in the morning goodbye Bobo since when has my", "words": [{"start": 108.8, "end": 109.24, "word": " it'll"}, {"start": 109.24, "end": 109.46, "word": " take"}, {"start": 109.46, "end": 109.6, "word": " a"}, {"start": 109.6, "end": 109.74, "word": " bit"}, {"start": 109.74, "end": 109.88, "word": " to"}, {"start": 109.88, "end": 110.06, "word": " wake"}, {"start": 110.06, "end": 110.26, "word": " him"}, {"start": 112.57, "end": 113.71, "word": " Bofa"}, {"start": 113.71, "end": 114.45, "word": " I'll"}, {"start": 117.74, "end": 117.94, "word": " see"}, {"start": 117.94, "end": 118.22, "word": " you"}, {"start": 118.22, "end": 118.34, "word": " in"}, {"start": 118.34, "end": 118.44, "word": " the"}, {"start": 118.44, "end": 118.66, "word": " morning"}, {"start": 118.66, "end": 119.72, "word": " goodbye"}, {"start": 121.87, "end": 122.45, "word": " Bobo"}, {"start": 163.18, "end": 167.54, "word": " since"}, {"start": 167.54, "end": 167.82, "word": " when"}, {"start": 167.82, "end": 168.0, "word": " has"}, {"start": 168.0, "end": 168.14, "word": " my"}]}, {"start": 168.14, "end": 170.2, "text": " My counsel counted for so little.", "words": [{"start": 168.14, "end": 168.24, "word": " My"}, {"start": 168.24, "end": 168.66, "word": " counsel"}, {"start": 168.66, "end": 169.3, "word": " counted"}, {"start": 169.3, "end": 169.76, "word": " for"}, {"start": 169.76, "end": 169.94, "word": " so"}, {"start": 169.94, "end": 170.2, "word": " little."}]}, {"start": 170.74, "end": 172.22, "text": " What do you think I'm trying to do?", "words": [{"start": 170.74, "end": 171.26, "word": " What"}, {"start": 171.26, "end": 171.36, "word": " do"}, {"start": 171.36, "end": 171.38, "word": " you"}, {"start": 171.38, "end": 171.6, "word": " think"}, {"start": 171.6, "end": 171.76, "word": " I'm"}, {"start": 171.76, "end": 171.88, "word": " trying"}, {"start": 171.88, "end": 172.0, "word": " to"}, {"start": 172.0, "end": 172.22, "word": " do?"}]}, {"start": 172.38, "end": 174.3, "text": " I think you're trying to save your dwarvish friends.", "words": [{"start": 172.38, "end": 172.46, "word": " I"}, {"start": 172.46, "end": 172.62, "word": " think"}, {"start": 172.62, "end": 172.76, "word": " you're"}, {"start": 172.76, "end": 172.98, "word": " trying"}, {"start": 172.98, "end": 173.12, "word": " to"}, {"start": 173.12, "end": 173.38, "word": " save"}, {"start": 173.38, "end": 173.56, "word": " your"}, {"start": 173.56, "end": 173.98, "word": " dwarvish"}, {"start": 173.98, "end": 174.3, "word": " friends."}]}, {"start": 174.64, "end": 177.1, "text": " And I admire your loyalty to them.", "words": [{"start": 174.64, "end": 175.16, "word": " And"}, {"start": 175.16, "end": 175.28, "word": " I"}, {"start": 175.28, "end": 175.62, "word": " admire"}, {"start": 175.62, "end": 176.04, "word": " your"}, {"start": 176.04, "end": 176.44, "word": " loyalty"}, {"start": 176.44, "end": 176.86, "word": " to"}, {"start": 176.86, "end": 177.1, "word": " them."}]}, {"start": 177.24, "end": 180.06, "text": " But it does not dissuade me from my course.", "words": [{"start": 177.24, "end": 177.72, "word": " But"}, {"start": 177.72, "end": 177.86, "word": " it"}, {"start": 177.86, "end": 178.02, "word": " does"}, {"start": 178.02, "end": 178.34, "word": " not"}, {"start": 178.34, "end": 178.88, "word": " dissuade"}, {"start": 178.88, "end": 179.1, "word": " me"}, {"start": 179.1, "end": 179.4, "word": " from"}, {"start": 179.4, "end": 179.64, "word": " my"}, {"start": 179.64, "end": 180.06, "word": " course."}]}, {"start": 181.04, "end": 183.44, "text": " You started this, Mithrandir.", "words": [{"start": 181.04, "end": 181.56, "word": " You"}, {"start": 181.56, "end": 182.04, "word": " started"}, {"start": 182.04, "end": 182.46, "word": " this,"}, {"start": 182.48, "end": 183.44, "word": " Mithrandir."}]}, {"start": 184.3, "end": 187.12, "text": " You will forgive me if I finish it.", "words": [{"start": 184.3, "end": 184.82, "word": " You"}, {"start": 184.82, "end": 185.02, "word": " will"}, {"start": 185.02, "end": 185.3, "word": " forgive"}, {"start": 185.3, "end": 185.62, "word": " me"}, {"start": 185.62, "end": 186.24, "word": " if"}, {"start": 186.24, "end": 186.4, "word": " I"}, {"start": 186.4, "end": 186.8, "word": " finish"}, {"start": 186.8, "end": 187.12, "word": " it."}]}, {"start": 187.46, "end": 188.8, "text": " Are the archers in position?", "words": [{"start": 187.46, "end": 187.98, "word": " Are"}, {"start": 187.98, "end": 188.12, "word": " the"}, {"start": 188.12, "end": 188.44, "word": " archers"}, {"start": 188.44, "end": 188.54, "word": " in"}, {"start": 188.54, "end": 188.8, "word": " position?"}]}, {"start": 189.78, "end": 190.6, "text": " Yes, my lord.", "words": [{"start": 189.78, "end": 190.3, "word": " Yes,"}, {"start": 190.3, "end": 190.42, "word": " my"}, {"start": 190.42, "end": 190.6, "word": " lord."}]}, {"start": 191.18, "end": 192.02, "text": " Give the order.", "words": [{"start": 191.18, "end": 191.7, "word": " Give"}, {"start": 191.7, "end": 191.8, "word": " the"}, {"start": 191.8, "end": 192.02, "word": " order."}]}, {"start": 192.74, "end": 196.16, "text": " If anything moves on that mountain, kill it.", "words": [{"start": 192.74, "end": 193.26, "word": " If"}, {"start": 193.26, "end": 193.54, "word": " anything"}, {"start": 193.54, "end": 193.98, "word": " moves"}, {"start": 193.98, "end": 194.16, "word": " on"}, {"start": 194.16, "end": 194.34, "word": " that"}, {"start": 194.34, "end": 194.66, "word": " mountain,"}, {"start": 194.9, "end": 196.02, "word": " kill"}, {"start": 196.02, "end": 196.16, "word": " it."}]}, {"start": 196.16, "end": 201.2, "text": " The dwarves are out of time.", "words": [{"start": 196.16, "end": 197.04, "word": " The"}, {"start": 199.86, "end": 200.36, "word": " dwarves"}, {"start": 200.36, "end": 200.48, "word": " are"}, {"start": 200.48, "end": 200.7, "word": " out"}, {"start": 200.7, "end": 200.86, "word": " of"}, {"start": 200.86, "end": 201.2, "word": " time."}]}, {"start": 202.44, "end": 202.94, "text": " Berman!", "words": [{"start": 202.44, "end": 202.94, "word": " Berman!"}]}, {"start": 204.04, "end": 205.52, "text": " Don't you agree with this?", "words": [{"start": 204.04, "end": 204.54, "word": " Don't"}, {"start": 204.54, "end": 204.6, "word": " you"}, {"start": 204.6, "end": 204.98, "word": " agree"}, {"start": 204.98, "end": 205.26, "word": " with"}, {"start": 205.26, "end": 205.52, "word": " this?"}]}, {"start": 205.76, "end": 208.02, "text": " Is gold so important to you?", "words": [{"start": 205.76, "end": 206.26, "word": " Is"}, {"start": 206.26, "end": 206.66, "word": " gold"}, {"start": 206.66, "end": 207.06, "word": " so"}, {"start": 207.06, "end": 207.72, "word": " important"}, {"start": 207.72, "end": 207.98, "word": " to"}, {"start": 207.98, "end": 208.02, "word": " you?"}]}, {"start": 208.7, "end": 210.7, "text": " Would you buy it with the blood of dwarves?", "words": [{"start": 208.7, "end": 209.2, "word": " Would"}, {"start": 209.2, "end": 209.32, "word": " you"}, {"start": 209.32, "end": 209.52, "word": " buy"}, {"start": 209.52, "end": 209.7, "word": " it"}, {"start": 209.7, "end": 209.8, "word": " with"}, {"start": 209.8, "end": 209.9, "word": " the"}, {"start": 209.9, "end": 210.1, "word": " blood"}, {"start": 210.1, "end": 210.22, "word": " of"}, {"start": 210.22, "end": 210.7, "word": " dwarves?"}]}, {"start": 211.42, "end": 212.98, "text": " It will not come to that.", "words": [{"start": 211.42, "end": 211.92, "word": " It"}, {"start": 211.92, "end": 212.08, "word": " will"}, {"start": 212.08, "end": 212.34, "word": " not"}, {"start": 212.34, "end": 212.6, "word": " come"}, {"start": 212.6, "end": 212.78, "word": " to"}, {"start": 212.78, "end": 212.98, "word": " that."}]}, {"start": 213.16, "end": 214.96, "text": " This is a fight they cannot win.", "words": [{"start": 213.16, "end": 213.54, "word": " This"}, {"start": 213.54, "end": 213.64, "word": " is"}, {"start": 213.64, "end": 213.76, "word": " a"}, {"start": 213.76, "end": 214.08, "word": " fight"}, {"start": 214.08, "end": 214.24, "word": " they"}, {"start": 214.24, "end": 214.54, "word": " cannot"}, {"start": 214.54, "end": 214.96, "word": " win."}]}, {"start": 215.18, "end": 215.94, "text": " That won't stop them.", "words": [{"start": 215.18, "end": 215.28, "word": " That"}, {"start": 215.28, "end": 215.56, "word": " won't"}, {"start": 215.56, "end": 215.78, "word": " stop"}, {"start": 215.78, "end": 215.94, "word": " them."}]}, {"start": 216.4, "end": 218.82, "text": " You think the dwarves will surrender?", "words": [{"start": 216.4, "end": 216.9, "word": " You"}, {"start": 216.9, "end": 217.24, "word": " think"}, {"start": 217.24, "end": 217.94, "word": " the"}, {"start": 217.94, "end": 218.34, "word": " dwarves"}, {"start": 218.34, "end": 218.46, "word": " will"}, {"start": 218.46, "end": 218.82, "word": " surrender?"}]}, {"start": 218.96, "end": 221.18, "text": " They won't. They will fight to the death to defend their own.", "words": [{"start": 218.96, "end": 219.16, "word": " They"}, {"start": 219.16, "end": 219.48, "word": " won't."}, {"start": 219.48, "end": 219.6, "word": " They"}, {"start": 219.6, "end": 219.7, "word": " will"}, {"start": 219.7, "end": 219.9, "word": " fight"}, {"start": 219.9, "end": 220.04, "word": " to"}, {"start": 220.04, "end": 220.14, "word": " the"}, {"start": 220.14, "end": 220.38, "word": " death"}, {"start": 220.38, "end": 220.58, "word": " to"}, {"start": 220.58, "end": 220.74, "word": " defend"}, {"start": 220.74, "end": 220.98, "word": " their"}, {"start": 220.98, "end": 221.18, "word": " own."}]}, {"start": 221.7, "end": 223.14, "text": " Lil' Berm beckons.", "words": [{"start": 221.7, "end": 222.08, "word": " Lil'"}, {"start": 222.08, "end": 222.46, "word": " Berm"}, {"start": 222.46, "end": 223.14, "word": " beckons."}]}, {"start": 223.94, "end": 230.54, "text": " If I'm not mistaken, this is the halfling who stole the keys to my dungeons from under the nose of my guards.", "words": [{"start": 223.94, "end": 224.38, "word": " If"}, {"start": 224.38, "end": 224.58, "word": " I'm"}, {"start": 224.58, "end": 224.72, "word": " not"}, {"start": 224.72, "end": 225.3, "word": " mistaken,"}, {"start": 225.52, "end": 225.98, "word": " this"}, {"start": 225.98, "end": 226.26, "word": " is"}, {"start": 226.26, "end": 226.44, "word": " the"}, {"start": 226.44, "end": 226.98, "word": " halfling"}, {"start": 226.98, "end": 227.18, "word": " who"}, {"start": 227.18, "end": 227.52, "word": " stole"}, {"start": 227.52, "end": 227.7, "word": " the"}, {"start": 227.7, "end": 227.96, "word": " keys"}, {"start": 227.96, "end": 228.12, "word": " to"}, {"start": 228.12, "end": 228.28, "word": " my"}, {"start": 228.28, "end": 228.7, "word": " dungeons"}, {"start": 228.7, "end": 229.08, "word": " from"}, {"start": 229.08, "end": 229.3, "word": " under"}, {"start": 229.3, "end": 229.5, "word": " the"}, {"start": 229.5, "end": 229.76, "word": " nose"}, {"start": 229.76, "end": 229.92, "word": " of"}, {"start": 229.92, "end": 230.06, "word": " my"}, {"start": 230.06, "end": 230.54, "word": " guards."}]}, {"start": 234.16, "end": 234.6, "text": " Yeesh.", "words": [{"start": 234.16, "end": 234.6, "word": " Yeesh."}]}, {"start": 236.38, "end": 237.16, "text": " Sorry about that.", "words": [{"start": 236.38, "end": 236.82, "word": " Sorry"}, {"start": 236.82, "end": 237.0, "word": " about"}, {"start": 237.0, "end": 237.16, "word": " that."}]}, {"start": 237.44, "end": 242.9, "text": " I came to give you this.", "words": [{"start": 237.44, "end": 237.88, "word": " I"}, {"start": 239.68, "end": 240.0, "word": " came"}, {"start": 240.0, "end": 240.94, "word": " to"}, {"start": 240.94, "end": 242.36, "word": " give"}, {"start": 242.36, "end": 242.52, "word": " you"}, {"start": 242.52, "end": 242.9, "word": " this."}]}, {"start": 243.12, "end": 252.7, "text": " King's jewel.", "words": [{"start": 243.12, "end": 243.56, "word": " King's"}, {"start": 252.36, "end": 252.7, "word": " jewel."}]}, {"start": 253.0, "end": 256.51, "text": " And worth a king's ransom.", "words": [{"start": 253.0, "end": 253.26, "word": " And"}, {"start": 255.43, "end": 255.65, "word": " worth"}, {"start": 255.65, "end": 255.77, "word": " a"}, {"start": 255.77, "end": 256.19, "word": " king's"}, {"start": 256.19, "end": 256.51, "word": " ransom."}]}, {"start": 259.32, "end": 260.66, "text": " How is this yours to give?", "words": [{"start": 259.32, "end": 259.76, "word": " How"}, {"start": 259.76, "end": 259.98, "word": " is"}, {"start": 259.98, "end": 260.12, "word": " this"}, {"start": 260.12, "end": 260.34, "word": " yours"}, {"start": 260.34, "end": 260.5, "word": " to"}, {"start": 260.5, "end": 260.66, "word": " give?"}]}, {"start": 261.28, "end": 263.2, "text": " I took it as my 14th share of the treasure.", "words": [{"start": 261.28, "end": 261.72, "word": " I"}, {"start": 261.72, "end": 261.9, "word": " took"}, {"start": 261.9, "end": 261.98, "word": " it"}, {"start": 261.98, "end": 262.08, "word": " as"}, {"start": 262.08, "end": 262.2, "word": " my"}, {"start": 262.2, "end": 262.64, "word": " 14th"}, {"start": 262.64, "end": 262.78, "word": " share"}, {"start": 262.78, "end": 262.88, "word": " of"}, {"start": 262.88, "end": 262.96, "word": " the"}, {"start": 262.96, "end": 263.2, "word": " treasure."}]}, {"start": 263.52, "end": 266.04, "text": " Why would you do this?", "words": [{"start": 263.52, "end": 263.96, "word": " Why"}, {"start": 265.4, "end": 265.56, "word": " would"}, {"start": 265.56, "end": 265.72, "word": " you"}, {"start": 265.72, "end": 265.86, "word": " do"}, {"start": 265.86, "end": 266.04, "word": " this?"}]}, {"start": 266.56, "end": 267.84, "text": " You owe us no loyalty.", "words": [{"start": 266.56, "end": 267.0, "word": " You"}, {"start": 267.0, "end": 267.14, "word": " owe"}, {"start": 267.14, "end": 267.34, "word": " us"}, {"start": 267.34, "end": 267.46, "word": " no"}, {"start": 267.46, "end": 267.84, "word": " loyalty."}]}, {"start": 268.14, "end": 269.1, "text": " I'm not doing it for you.", "words": [{"start": 268.14, "end": 268.36, "word": " I'm"}, {"start": 268.36, "end": 268.46, "word": " not"}, {"start": 268.46, "end": 268.7, "word": " doing"}, {"start": 268.7, "end": 268.84, "word": " it"}, {"start": 268.84, "end": 268.96, "word": " for"}, {"start": 268.96, "end": 269.1, "word": " you."}]}, {"start": 271.03, "end": 273.09, "text": " I know that dwarves can be obstinate.", "words": [{"start": 271.03, "end": 271.47, "word": " I"}, {"start": 271.47, "end": 271.71, "word": " know"}, {"start": 271.71, "end": 271.93, "word": " that"}, {"start": 271.93, "end": 272.37, "word": " dwarves"}, {"start": 272.37, "end": 27