rd": " fault."}]}, {"start": 289.35, "end": 292.21, "text": " I've grown very fond of them, and I would save them if I can.", "words": [{"start": 289.35, "end": 289.83, "word": " I've"}, {"start": 289.83, "end": 289.95, "word": " grown"}, {"start": 289.95, "end": 290.15, "word": " very"}, {"start": 290.15, "end": 290.41, "word": " fond"}, {"start": 290.41, "end": 290.53, "word": " of"}, {"start": 290.53, "end": 290.67, "word": " them,"}, {"start": 290.73, "end": 290.97, "word": " and"}, {"start": 290.97, "end": 291.09, "word": " I"}, {"start": 291.09, "end": 291.31, "word": " would"}, {"start": 291.31, "end": 291.57, "word": " save"}, {"start": 291.57, "end": 291.73, "word": " them"}, {"start": 291.73, "end": 291.87, "word": " if"}, {"start": 291.87, "end": 291.97, "word": " I"}, {"start": 291.97, "end": 292.21, "word": " can."}]}, {"start": 293.57, "end": 296.47, "text": " A Thorin values this stone above all else.", "words": [{"start": 293.57, "end": 294.05, "word": " A"}, {"start": 294.05, "end": 294.39, "word": " Thorin"}, {"start": 294.39, "end": 295.09, "word": " values"}, {"start": 295.09, "end": 295.47, "word": " this"}, {"start": 295.47, "end": 295.73, "word": " stone"}, {"start": 295.73, "end": 295.95, "word": " above"}, {"start": 295.95, "end": 296.17, "word": " all"}, {"start": 296.17, "end": 296.47, "word": " else."}]}, {"start": 297.45, "end": 301.03, "text": " In exchange for its return, I believe he will give you what you are owed.", "words": [{"start": 297.45, "end": 297.93, "word": " In"}, {"start": 297.93, "end": 298.23, "word": " exchange"}, {"start": 298.23, "end": 298.55, "word": " for"}, {"start": 298.55, "end": 298.67, "word": " its"}, {"start": 298.67, "end": 298.97, "word": " return,"}, {"start": 299.13, "end": 299.29, "word": " I"}, {"start": 299.29, "end": 299.59, "word": " believe"}, {"start": 299.59, "end": 299.83, "word": " he"}, {"start": 299.83, "end": 300.05, "word": " will"}, {"start": 300.05, "end": 300.27, "word": " give"}, {"start": 300.27, "end": 300.41, "word": " you"}, {"start": 300.41, "end": 300.55, "word": " what"}, {"start": 300.55, "end": 300.71, "word": " you"}, {"start": 300.71, "end": 300.81, "word": " are"}, {"start": 300.81, "end": 301.03, "word": " owed."}]}, {"start": 301.29, "end": 303.01, "text": " There will be no need for war.", "words": [{"start": 301.29, "end": 301.77, "word": " There"}, {"start": 301.77, "end": 301.93, "word": " will"}, {"start": 301.93, "end": 302.11, "word": " be"}, {"start": 302.11, "end": 302.35, "word": " no"}, {"start": 302.35, "end": 302.57, "word": " need"}, {"start": 302.57, "end": 302.79, "word": " for"}, {"start": 302.79, "end": 303.01, "word": " war."}]}, {"start": 309.64, "end": 312.24, "text": " Rest up tonight. You must leave on the morrow.", "words": [{"start": 309.64, "end": 310.12, "word": " Rest"}, {"start": 310.12, "end": 310.32, "word": " up"}, {"start": 310.32, "end": 310.62, "word": " tonight."}, {"start": 310.9, "end": 311.38, "word": " You"}, {"start": 311.38, "end": 311.54, "word": " must"}, {"start": 311.54, "end": 311.74, "word": " leave"}, {"start": 311.74, "end": 311.88, "word": " on"}, {"start": 311.88, "end": 311.94, "word": " the"}, {"start": 311.94, "end": 312.24, "word": " morrow."}]}, {"start": 312.36, "end": 315.64, "text": " What get us far away from here as possible, and I'm not leaving", "words": [{"start": 312.36, "end": 312.74, "word": " What"}, {"start": 312.74, "end": 313.18, "word": " get"}, {"start": 313.18, "end": 313.36, "word": " us"}, {"start": 313.36, "end": 313.58, "word": " far"}, {"start": 313.58, "end": 313.84, "word": " away"}, {"start": 313.84, "end": 314.02, "word": " from"}, {"start": 314.02, "end": 314.2, "word": " here"}, {"start": 314.2, "end": 314.34, "word": " as"}, {"start": 314.34, "end": 314.64, "word": " possible,"}, {"start": 314.76, "end": 315.06, "word": " and"}, {"start": 315.06, "end": 315.26, "word": " I'm"}, {"start": 315.26, "end": 315.4, "word": " not"}, {"start": 315.4, "end": 315.64, "word": " leaving"}]}, {"start": 315.64, "end": 319.56, "text": " You picked me as the 14th man. I'm not about to leave the company now", "words": [{"start": 315.64, "end": 316.32, "word": " You"}, {"start": 316.32, "end": 316.96, "word": " picked"}, {"start": 316.96, "end": 317.12, "word": " me"}, {"start": 317.12, "end": 317.26, "word": " as"}, {"start": 317.26, "end": 317.34, "word": " the"}, {"start": 317.34, "end": 317.82, "word": " 14th"}, {"start": 317.82, "end": 318.0, "word": " man."}, {"start": 318.1, "end": 318.26, "word": " I'm"}, {"start": 318.26, "end": 318.3, "word": " not"}, {"start": 318.3, "end": 318.46, "word": " about"}, {"start": 318.46, "end": 318.62, "word": " to"}, {"start": 318.62, "end": 318.8, "word": " leave"}, {"start": 318.8, "end": 318.98, "word": " the"}, {"start": 318.98, "end": 319.28, "word": " company"}, {"start": 319.28, "end": 319.56, "word": " now"}]}, {"start": 319.56, "end": 321.28, "text": " There is no company not anymore", "words": [{"start": 319.56, "end": 319.76, "word": " There"}, {"start": 319.76, "end": 319.94, "word": " is"}, {"start": 319.94, "end": 320.1, "word": " no"}, {"start": 320.1, "end": 320.46, "word": " company"}, {"start": 320.46, "end": 320.96, "word": " not"}, {"start": 320.96, "end": 321.28, "word": " anymore"}]}, {"start": 321.28, "end": 325.72, "text": " And I don't like to think what Thorin will do when he finds out what you've done. I'm not afraid of Thorin", "words": [{"start": 321.28, "end": 321.88, "word": " And"}, {"start": 321.88, "end": 322.16, "word": " I"}, {"start": 322.16, "end": 322.38, "word": " don't"}, {"start": 322.38, "end": 322.42, "word": " like"}, {"start": 322.42, "end": 322.54, "word": " to"}, {"start": 322.54, "end": 322.66, "word": " think"}, {"start": 322.66, "end": 322.8, "word": " what"}, {"start": 322.8, "end": 323.1, "word": " Thorin"}, {"start": 323.1, "end": 323.22, "word": " will"}, {"start": 323.22, "end": 323.38, "word": " do"}, {"start": 323.38, "end": 3