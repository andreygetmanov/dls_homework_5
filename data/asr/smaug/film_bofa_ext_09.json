 the"}, {"start": 71.61, "end": 71.87, "word": " king?"}]}, {"start": 83.75, "end": 85.89, "text": " He could not see beyond his own desire.", "words": [{"start": 83.75, "end": 84.31, "word": " He"}, {"start": 84.31, "end": 84.49, "word": " could"}, {"start": 84.49, "end": 84.65, "word": " not"}, {"start": 84.65, "end": 84.93, "word": " see"}, {"start": 84.93, "end": 85.23, "word": " beyond"}, {"start": 85.23, "end": 85.43, "word": " his"}, {"start": 85.43, "end": 85.63, "word": " own"}, {"start": 85.63, "end": 85.89, "word": " desire."}]}, {"start": 85.89, "end": 87.99, "text": " As if I was some lowly dwarf lord.", "words": [{"start": 85.89, "end": 85.89, "word": " As"}, {"start": 85.89, "end": 86.05, "word": " if"}, {"start": 86.05, "end": 86.25, "word": " I"}, {"start": 86.25, "end": 86.43, "word": " was"}, {"start": 86.43, "end": 86.67, "word": " some"}, {"start": 86.67, "end": 87.23, "word": " lowly"}, {"start": 87.23, "end": 87.49, "word": " dwarf"}, {"start": 87.49, "end": 87.99, "word": " lord."}]}, {"start": 91.16, "end": 93.7, "text": " Sickness which drove your grandfather mad.", "words": [{"start": 91.16, "end": 91.72, "word": " Sickness"}, {"start": 91.72, "end": 91.9, "word": " which"}, {"start": 91.9, "end": 92.22, "word": " drove"}, {"start": 92.22, "end": 92.54, "word": " your"}, {"start": 92.54, "end": 93.08, "word": " grandfather"}, {"start": 93.08, "end": 93.7, "word": " mad."}]}, {"start": 94.7, "end": 96.16, "text": " This is Thorin.", "words": [{"start": 94.7, "end": 95.26, "word": " This"}, {"start": 95.26, "end": 95.66, "word": " is"}, {"start": 95.66, "end": 96.16, "word": " Thorin."}]}, {"start": 96.62, "end": 98.0, "text": " Son of Thrain.", "words": [{"start": 96.62, "end": 97.18, "word": " Son"}, {"start": 97.18, "end": 97.56, "word": " of"}, {"start": 97.56, "end": 98.0, "word": " Thrain."}]}, {"start": 98.7, "end": 99.88, "text": " Son of Throne.", "words": [{"start": 98.7, "end": 99.26, "word": " Son"}, {"start": 99.26, "end": 99.6, "word": " of"}, {"start": 99.6, "end": 99.88, "word": " Throne."}]}, {"start": 99.92, "end": 101.0, "text": " I am not my grandfather.", "words": [{"start": 99.92, "end": 100.1, "word": " I"}, {"start": 100.1, "end": 100.24, "word": " am"}, {"start": 100.24, "end": 100.42, "word": " not"}, {"start": 100.42, "end": 100.58, "word": " my"}, {"start": 100.58, "end": 101.0, "word": " grandfather."}]}, {"start": 101.28, "end": 102.16, "text": " You are my grandfather.", "words": [{"start": 101.28, "end": 101.52, "word": " You"}, {"start": 101.52, "end": 101.62, "word": " are"}, {"start": 101.62, "end": 101.7, "word": " my"}, {"start": 101.7, "end": 102.16, "word": " grandfather."}]}, {"start": 102.4, "end": 104.34, "text": " You are the heir to the throne of Dorian.", "words": [{"start": 102.4, "end": 102.52, "word": " You"}, {"start": 102.52, "end": 102.7, "word": " are"}, {"start": 102.7, "end": 102.82, "word": " the"}, {"start": 102.82, "end": 103.02, "word": " heir"}, {"start": 103.02, "end": 103.3, "word": " to"}, {"start": 103.3, "end": 103.42, "word": " the"}, {"start": 103.42, "end": 103.7, "word": " throne"}, {"start": 103.7, "end": 103.9, "word": " of"}, {"start": 103.9, "end": 104.34, "word": " Dorian."}]}, {"start": 105.9, "end": 107.7, "text": " Take back Erebor.", "words": [{"start": 105.9, "end": 106.46, "word": " Take"}, {"start": 106.46, "end": 106.98, "word": " back"}, {"start": 106.98, "end": 107.7, "word": " Erebor."}]}, {"start": 108.0, "end": 115.27, "text": " Take back your homeland.", "words": [{"start": 108.0, "end": 108.42, "word": " Take"}, {"start": 108.42, "end": 110.52, "word": " back"}, {"start": 113.75, "end": 114.61, "word": " your"}, {"start": 114.61, "end": 115.27, "word": " homeland."}]}, {"start": 120.73, "end": 124.11, "text": " Is this treasure truly worth more than your honor?", "words": [{"start": 120.73, "end": 121.29, "word": " Is"}, {"start": 121.29, "end": 121.55, "word": " this"}, {"start": 121.55, "end": 122.19, "word": " tr