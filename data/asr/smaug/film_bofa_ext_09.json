, "end": 387.66, "text": " The door!", "words": [{"start": 387.12, "end": 387.48, "word": " The"}, {"start": 387.48, "end": 387.66, "word": " door!"}]}, {"start": 387.88, "end": 408.14, "text": " The doors?", "words": [{"start": 387.88, "end": 388.52, "word": " The"}, {"start": 407.88, "end": 408.14, "word": " doors?"}]}, {"start": 408.94, "end": 410.34, "text": " They're rallying.", "words": [{"start": 408.94, "end": 409.68, "word": " They're"}, {"start": 409.68, "end": 410.34, "word": " rallying."}]}, {"start": 413.25, "end": 415.27, "text": " They're rallying to the king.", "words": [{"start": 413.25, "end": 413.99, "word": " They're"}, {"start": 413.99, "end": 414.61, "word": " rallying"}, {"start": 414.61, "end": 414.85, "word": " to"}, {"start": 414.85, "end": 414.93, "word": " the"}, {"start": 414.93, "end": 415.27, "word": " king."}]}, {"start": 415.79, "end": 432.8, "text": " Any man who wants to give their last,", "words": [{"start": 415.79, "end": 416.43, "word": " Any"}, {"start": 431.06, "end": 431.36, "word": " man"}, {"start": 431.36, "end": 431.66, "word": " who"}, {"start": 431.66, "end": 431.86, "word": " wants"}, {"start": 431.86, "end": 432.02, "word": " to"}, {"start": 432.02, "end": 432.24, "word": " give"}, {"start": 432.24, "end": 432.48, "word": " their"}, {"start": 432.48, "end": 432.8, "word": " last,"}]}, {"start": 433.7, "end": 434.74, "text": " follow me!", "words": [{"start": 433.7, "end": 434.44, "word": " follow"}, {"start": 434.44, "end": 434.74, "word": " me!"}]}, {"start": 441.24, "end": 445.02, "text": " Come on bomber, get it up!", "words": [{"start": 441.24, "end": 441.98, "word": " Come"}, {"start": 443.52, "end": 443.62, "word": " on"}, {"start": 443.62, "end": 444.0, "word": " bomber,"}, {"start": 444.1, "end": 444.5, "word": " get"}, {"start": 444.5, "end": 444.86, "word": " it"}, {"start": 444.86, "end": 445.02, "word": " up!"}]}, {"start": 490.05, "end": 531.27, "text": " You're not a man in life.", "words": [{"start": 49