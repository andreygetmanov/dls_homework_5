[{"start": 1.74, "end": 4.08, "text": " As if I was some lowly dwarf lord.", "words": [{"start": 1.74, "end": 2.14, "word": " As"}, {"start": 2.14, "end": 2.3, "word": " if"}, {"start": 2.3, "end": 2.46, "word": " I"}, {"start": 2.46, "end": 2.64, "word": " was"}, {"start": 2.64, "end": 2.82, "word": " some"}, {"start": 2.82, "end": 3.36, "word": " lowly"}, {"start": 3.36, "end": 3.6, "word": " dwarf"}, {"start": 3.6, "end": 4.08, "word": " lord."}]}, {"start": 5.5, "end": 15.49, "text": " As if I were still good shield.", "words": [{"start": 5.5, "end": 6.06, "word": " As"}, {"start": 6.06, "end": 6.26, "word": " if"}, {"start": 6.26, "end": 7.06, "word": " I"}, {"start": 7.06, "end": 7.62, "word": " were"}, {"start": 7.62, "end": 8.84, "word": " still"}, {"start": 8.84, "end": 9.62, "word": " good"}, {"start": 15.03, "end": 15.49, "word": " shield."}]}, {"start": 15.95, "end": 19.13, "text": " I am your king!", "words": [{"start": 15.95, "end": 16.21, "word": " I"}, {"start": 18.23, "end": 18.43, "word": " am"}, {"start": 18.43, "end": 18.67, "word": " your"}, {"start": 18.67, "end": 19.13, "word": " king!"}]}, {"start": 19.51, "end": 20.71, "text": " You were always my king.", "words": [{"start": 19.51, "end": 19.69, "word": " You"}, {"start": 19.69, "end": 19.81, "word": " were"}, {"start": 19.81, "end": 20.07, "word": " always"}, {"start": 20.07, "end": 20.39, "word": " my"}, {"start": 20.39, "end": 20.71, "word": " king."}]}, {"start": 21.17, "end": 22.73, "text": " You used to know that once.", "words": [{"start": 21.17, "end": 21.73, "word": " You"}, {"start": 21.73, "end": 21.95, "word": " used"}, {"start": 21.95, "end": 22.11, "word": " to"}, {"start": 22.11, "end": 22.25, "word": " know"}, {"start": 22.25, "end": 22.41, "word": " that"}, {"start": 22.41, "end": 22.73, "word": " once."}]}, {"start": 24.6, "end": 26.64, "text": " You cannot see what you have become.", "words": [{"start": 24.6, "end": 24.98, "word": " You"}, {"start": 24.98, "end": 25.32, "w