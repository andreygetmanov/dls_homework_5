: " combat."}]}, {"start": 108.7, "end": 114.7, "text": " It's undoubtedly", "words": [{"start": 108.7, "end": 109.38, "word": " It's"}, {"start": 114.18, "end": 114.7, "word": " undoubtedly"}]}, {"start": 114.7, "end": 116.0, "text": " a trap.", "words": [{"start": 114.7, "end": 115.46, "word": " a"}, {"start": 115.46, "end": 116.0, "word": " trap."}]}, {"start": 116.64, "end": 161.42, "text": " Anything? Nothing!", "words": [{"start": 116.64, "end": 117.32, "word": " Anything?"}, {"start": 160.74, "end": 161.42, "word": " Nothing!"}]}, {"start": 161.7, "end": 167.5, "text": " If the map is true,", "words": [{"start": 161.7, "end": 162.38, "word": " If"}, {"start": 166.6, "end": 166.84, "word": " the"}, {"start": 166.84, "end": 167.02, "word": " map"}, {"start": 167.02, "end": 167.16, "word": " is"}, {"start": 167.16, "end": 167.5, "word": " true,"}]}, {"start": 167.7, "end": 169.62, "text": " the hidden door lies directly", "words": [{"start": 167.7, "end": 168.68, "word": " the"}, {"start": 168.68, "end": 168.9, "word": " hidden"}, {"start": 168.9, "end": 169.16, "word": " door"}, {"start": 169.16, "end": 169.38, "word": " lies"}, {"start": 169.38, "end": 169.62, "word": " directly"}]}, {"start": 169.62, "end": 170.22, "text": " above us.", "words": [{"start": 169.62, "end": 169.88, "word": " above"}, {"start": 169.88, "end": 170.22, "word": " us."}]}, {"start": 279.91, "end": 420.63, "text": " I'm so sorry, I will fight with you and you will see him again my friend come we must", "words": [{"start": 279.91, "end": 280.63, "word": " I'm"}, {"start": 280.63, "end": 281.35, "word": " so"}, {"start": 397.7, "end": 398.28, "word": " sorry,"}, {"start": 398.4, "end": 398.76, "word": " I"}, {"start": 407.76, "end": 408.04, "word": " will"}, {"start": 408.04, "end": 408.4, "word": " fight"}, {"start": 408.4, "end": 408.7, "word": " with"}, {"start": 408.7, "end": 409.14, "word": " you"}, {"start": 409.14, "end": 409.7, "word": " and"}, {"start": 416.77, "end": 417.05, "word": " you"}, {"start": 417.05, "end": 417.31, "word": " will"}, {"start": 417.31, "end": 417.57, "word": " see"}, {"start": 417.57, "end": 417.77, "word": " him"}, {"start": 417.77, "end": 418.13, "word": " again"}, {"start": 418.13, "end": 418.67, "word": " my"}, {"start": 418.67, "end": 418.97, "word": " friend"}, {"start": 418.97, "end": 419.89, "word": " come"}, {"start": 419.89, "end": 420.43, "word": " we"}, {"start": 420.43, "end": 420.63, "word": " must"}]}, {"start": 420.63, "end": 420.95, "text": " leave", "words": [{"start": 420.63, "end": 420.95, "word": " leave"}]}, {"start": 422.13, "end": 430.6, "text": " The Orcs had taken Moria. War. We were at war. I was surrounded.", "words": [{"start": 422.13, "end": 422.69, "word": " The"}, {"start": 422.69, "end": 423.25, "word": " Orcs"}, {"start": 423.25, "end": 423.43, "word": " had"}, {"start": 423.43, "end": 423.81, "word": " taken"}, {"start": 423.81, "end": 424.31, "word": " Moria."}, {"start": 424.91, "end": 425.47, "word": " War."}, {"start": 426.21, "end": 426.77, "word": " We"}, {"start": 426.77, "end": 427.11, "word": " were"}, {"start": 427.11, "end": 427.35, "word": " at"}, {"start": 427.35, "end": 427.69, "word": " war."}, {"start": 428.07, "end": 428.57, "word": " I"}, {"start": 429.88, "end": 430.1, "word": " was"}, {"start": 430.1, "end": 430.6, "word": " surrounded."}]}, {"start": 431.08, "end": 500.16, "text": " Go on, let's get you out of here.", "words": [{"start": 431.08, "end": 431.4, "word": " Go"}, {"start": 499.14, "end": 499.32, "word": " on,"}, {"start": 499.32, "end": 499.46, "word": " let's"}, {"start": 499.46, "end": 499.58, "word": " get"}, {"start": 499.58, "end": 499.7, "word": " you"}, {"start": 499.7, "end": 499.86, "word": " out"}, {"start": 499.86, "end": 500.0, "word": " of"}, {"start": 500.0, "end": 500.16, "word": " here."}]}, {"start": 500.44, "end": 508.89, "text": " There is no way out! They will stop you! The Serpents will stop you!", "words": [{"start": 500.44, 