he helpless.", "words": [{"start": 514.83, "end": 515.23, "word": " To"}, {"start": 515.23, "end": 515.37, "word": " the"}, {"start": 515.37, "end": 515.65, "word": " sick"}, {"start": 515.65, "end": 516.31, "word": " and"}, {"start": 516.31, "end": 516.45, "word": " the"}, {"start": 516.45, "end": 516.81, "word": " helpless."}]}, {"start": 518.01, "end": 520.15, "text": " Those who can stand, tend to the wounded.", "words": [{"start": 518.01, "end": 518.41, "word": " Those"}, {"start": 518.41, "end": 518.57, "word": " who"}, {"start": 518.57, "end": 518.69, "word": " can"}, {"start": 518.69, "end": 519.13, "word": " stand,"}, {"start": 519.19, "end": 519.55, "word": " tend"}, {"start": 519.55, "end": 519.75, "word": " to"}, {"start": 519.75, "end": 519.81, "word": " the"}, {"start": 519.81, "end": 520.15, "word": " wounded."}]}, {"start": 520.43, "end": 522.23, "text": " And those who have strength left, follow me.", "words": [{"start": 520.43, "end": 520.83, "word": " And"}, {"start": 520.83, "end": 521.01, "word": " those"}, {"start": 521.01, "end": 521.11, "word": " who"}, {"start": 521.11, "end": 521.23, "word": " have"}, {"start": 521.23, "end": 521.55, "word": " strength"}, {"start": 521.55, "end": 521.75, "word": " left,"}, {"start": 521.83, "end": 522.03, "word": " follow"}, {"start": 522.03, "end": 522.23, "word": " me."}]}, {"start": 522.95, "end": 524.39, "text": " We must salvage what we can.", "words": [{"start": 522.95, "end": 523.35, "word": " We"}, {"start": 523.35, "end": 523.51, "word": " must"}, {"start": 523.51, "end": 523.97, "word": " salvage"}, {"start": 523.97, "end": 524.05, "word": " what"}, {"start": 524.05, "end": 524.21, "word": " we"}, {"start": 524.21, "end": 524.39, "word": " can."}]}, {"start": 524.63, "end": 526.19, "text": " What then? What do we do then?", "words": [{"start": 524.63, "end": 525.03, "word": " What"}, {"start": 525.03, "end": 525.25, "word": " then?"}, {"start": 525.37, "end": 525.71, "word": " What"}, {"start": 52