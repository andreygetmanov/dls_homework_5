}, {"start": 340.14, "end": 340.44, "word": " lord"}, {"start": 340.44, "end": 340.74, "word": " who"}, {"start": 340.74, "end": 340.86, "word": " will"}, {"start": 340.86, "end": 341.08, "word": " pay"}, {"start": 341.08, "end": 341.26, "word": " a"}, {"start": 341.26, "end": 341.54, "word": " pretty"}, {"start": 341.54, "end": 342.02, "word": " price"}, {"start": 342.02, "end": 342.18, "word": " for"}, {"start": 342.18, "end": 342.42, "word": " these"}]}, {"start": 342.42, "end": 358.04, "text": " please wait you would go to war over a handful of gems the heirlooms of my people are not", "words": [{"start": 342.42, "end": 343.16, "word": " please"}, {"start": 349.88, "end": 350.22, "word": " wait"}, {"start": 350.22, "end": 351.24, "word": " you"}, {"start": 353.64, "end": 353.78, "word": " would"}, {"start": 353.78, "end": 353.92, "word": " go"}, {"start": 353.92, "end": 354.08, "word": " to"}, {"start": 354.08, "end": 354.26, "word": " war"}, {"start": 354.26, "end": 354.64, "word": " over"}, {"start": 354.64, "end": 354.8, "word": " a"}, {"start": 354.8, "end": 355.14, "word": " handful"}, {"start": 355.14, "end": 355.38, "word": " of"}, {"start": 355.38, "end": 355.68, "word": " gems"}, {"start": 355.68, "end": 356.14, "word": " the"}, {"start": 356.14, "end": 356.64, "word": " heirlooms"}, {"start": 356.64, "end": 356.94, "word": " of"}, {"start": 356.94, "end": 357.1, "word": " my"}, {"start": 357.1, "end": 357.54, "word": " people"}, {"start": 357.54, "end": 357.84, "word": " are"}, {"start": 357.84, "end": 358.04, "word": " not"}]}, {"start": 358.04, "end": 365.94, "text": " lightly forsaken we are allies in this my people also have a claim upon the riches in that mountain", "words": [{"start": 358.04, "end": 358.5, "word": " lightly"}, {"start": 358.5, "end": 359.36, "word": " forsaken"}, {"start": 359.36, "end": 360.12, "word": " we"}, {"start": 360.12, "end": 360.24, "word": " are"}, {"start": 360.24, "end": 360.64, "word": " allies"}, {"start": 360.64,