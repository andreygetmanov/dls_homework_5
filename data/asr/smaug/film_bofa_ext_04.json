.74, "word": " you"}, {"start": 428.74, "end": 429.86, "word": " but"}, {"start": 429.86, "end": 429.98, "word": " to"}, {"start": 429.98, "end": 430.28, "word": " seek"}, {"start": 430.28, "end": 430.5, "word": " fair"}, {"start": 430.5, "end": 431.02, "word": " settlement"}, {"start": 431.02, "end": 432.56, "word": " will"}, {"start": 432.56, "end": 432.74, "word": " you"}, {"start": 432.74, "end": 432.92, "word": " not"}, {"start": 432.92, "end": 433.22, "word": " speak"}, {"start": 433.22, "end": 433.46, "word": " with"}, {"start": 433.46, "end": 433.66, "word": " me"}, {"start": 433.66, "end": 433.9, "word": " on"}]}, {"start": 472.01, "end": 478.11, "text": " behalf of the people of Lake Town I ask that you honor your pledge a share of the treasure so that", "words": [{"start": 472.01, "end": 472.27, "word": " behalf"}, {"start": 472.27, "end": 472.49, "word": " of"}, {"start": 472.49, "end": 472.61, "word": " the"}, {"start": 472.61, "end": 472.81, "word": " people"}, {"start": 472.81, "end": 472.97, "word": " of"}, {"start": 472.97, "end": 473.13, "word": " Lake"}, {"start": 473.13, "end": 473.31, "word": " Town"}, {"start": 473.31, "end": 473.73, "word": " I"}, {"start": 473.73, "end": 474.33, "word": " ask"}, {"start": 474.33, "end": 474.57, "word": " that"}, {"start": 474.57, "end": 474.75, "word": " you"}, {"start": 474.75, "end": 475.07, "word": " honor"}, {"start": 475.07, "end": 475.31, "word": " your"}, {"start": 475.31, "end": 475.73, "word": " pledge"}, {"start": 475.73, "end": 476.81, "word": " a"}, {"start": 476.81, "end": 477.05, "word": " share"}, {"start": 477.05, "end": 477.29, "word": " of"}, {"start": 477.29, "end": 477.41, "word": " the"}, {"start": 477.41, "end": 477.71, "word": " treasure"}, {"start": 477.71, "end": 477.97, "word": " so"}, {"start": 477.97, "end": 478.11, "word": " that"}]}, {"start": 478.11, "end": 486.76, "text": " they might rebuild their lives not treat with any man while an armed host lies before my door that", "wor