3, "end": 94.67, "word": " survived."}]}, {"start": 96.11, "end": 96.59, "text": " Survived?", "words": [{"start": 96.11, "end": 96.59, "word": " Survived?"}]}, {"start": 97.49, "end": 99.93, "text": " You mean there's a bunch of dwarves in there with all that gold?", "words": [{"start": 97.49, "end": 97.97, "word": " You"}, {"start": 97.97, "end": 98.15, "word": " mean"}, {"start": 98.15, "end": 98.31, "word": " there's"}, {"start": 98.31, "end": 98.37, "word": " a"}, {"start": 98.37, "end": 98.57, "word": " bunch"}, {"start": 98.57, "end": 98.69, "word": " of"}, {"start": 98.69, "end": 98.99, "word": " dwarves"}, {"start": 98.99, "end": 99.11, "word": " in"}, {"start": 99.11, "end": 99.25, "word": " there"}, {"start": 99.25, "end": 99.39, "word": " with"}, {"start": 99.39, "end": 99.51, "word": " all"}, {"start": 99.51, "end": 99.65, "word": " that"}, {"start": 99.65, "end": 99.93, "word": " gold?"}]}, {"start": 101.33, "end": 102.53, "text": " They shouldn't worry, Alfred.", "words": [{"start": 101.33, "end": 101.81, "word": " They"}, {"start": 101.81, "end": 102.11, "word": " shouldn't"}, {"start": 102.11, "end": 102.25, "word": " worry,"}, {"start": 102.39, "end": 102.53, "word": " Alfred."}]}, {"start": 103.65, "end": 105.53, "text": " There's gold enough in that mountain for all.", "words": [{"start": 103.65, "end": 104.13, "word": " There's"}, {"start": 104.13, "end": 104.29, "word": " gold"}, {"start": 104.29, "end": 104.53, "word": " enough"}, {"start": 104.53, "end": 104.65, "word": " in"}, {"start": 104.65, "end": 104.75, "word": " that"}, {"start": 104.75, "end": 105.07, "word": " mountain"}, {"start": 105.07, "end": 105.29, "word": " for"}, {"start": 105.29, "end": 105.53, "word": " all."}]}, {"start": 106.31, "end": 107.41, "text": " Make camp here tonight.", "words": [{"start": 106.31, "end": 106.79, "word": " Make"}, {"start": 106.79, "end": 106.99, "word": " camp"}, {"start": 106.99, "end": 107.15, "word": " here"}, {"start": 107.15, "end": 107.41, "word": " tonight."}]}, {"start": 108.33, "end": 109.59, "text": " Find what shelter you can.", "words": [{"start": 108.33, "end": 108.81, "word": " Find"}, {"start": 108.81, "end": 108.95, "word": " what"}, {"start": 108.95, "end": 109.19, "word": " shelter"}, {"start": 109.19, "end": 109.39, "word": " you"}, {"start": 109.39, "end": 109.59, "word": " can."}]}, {"start": 110.03, "end": 111.23, "text": " Get some fires going.", "words": [{"start": 110.03, "end": 110.51, "word": " Get"}, {"start": 110.51, "end": 110.67, "word": " some"}, {"start": 110.67, "end": 110.99, "word": " fires"}, {"start": 110.99, "end": 111.23, "word": " going."}]}, {"start": 114.15, "end": 115.77, "text": " Alfred, you take the night watch.", "words": [{"start": 114.15, "end": 114.63, "word": " Alfred,"}, {"start": 114.63, "end": 115.11, "word": " you"}, {"start": 115.11, "end": 115.29, "word": " take"}, {"start": 115.29, "end": 115.43, "word": " the"}, {"start": 115.43, "end": 115.55, "word": " night"}, {"start": 115.55, "end": 115.77, "word": " watch."}]}, {"start": 116.21, "end": 137.27, "text": " I want this fortress made safe by Sonop.", "words": [{"start": 116.21, "end": 116.69, "word": " I"}, {"start": 135.41, "end": 135.53, "word": " want"}, {"start": 135.53, "end": 135.67, "word": " this"}, {"start": 135.67, "end": 136.05, "word": " fortress"}, {"start": 136.05, "end": 136.31, "word": " made"}, {"start": 136.31, "end": 136.61, "word": " safe"}, {"start": 136.61, "end": 136.83, "word": " by"}, {"start": 136.83, "end": 137.27, "word": " Sonop."}]}, {"start": 138.09, "end": 141.63, "text": " This mountain was hard won. I will not see it taken again.", "words": [{"start": 138.09, "end": 138.65, "word": " This"}, {"start": 138.65, "end": 139.01, "word": " mountain"}, {"start": 139.01, "end": 139.25, "word": " was"}, {"start": 139.25, "end": 139.51, "word": " hard"}, {"start": 139.51, "end": 139.77, "word": " won."}, {"start": 139.95, "end": 140.51, "word": " I"}, {"start": 140.51, "en