 The"}, {"start": 198.04, "end": 198.04, "word": " children"}, {"start": 198.04, "end": 198.04, "word": " are"}, {"start": 198.04, "end": 198.6, "word": " starving."}, {"start": 198.84, "end": 199.3, "word": " We"}, {"start": 199.3, "end": 199.44, "word": " need"}, {"start": 199.44, "end": 199.88, "word": " food."}]}, {"start": 200.08, "end": 201.52, "text": " We've all lost three days.", "words": [{"start": 200.08, "end": 200.54, "word": " We've"}, {"start": 200.54, "end": 200.58, "word": " all"}, {"start": 200.58, "end": 200.88, "word": " lost"}, {"start": 200.88, "end": 201.14, "word": " three"}, {"start": 201.14, "end": 201.52, "word": " days."}]}, {"start": 201.94, "end": 203.12, "text": " Bard, we don't have enough.", "words": [{"start": 201.94, "end": 202.42, "word": " Bard,"}, {"start": 202.56, "end": 202.72, "word": " we"}, {"start": 202.72, "end": 202.84, "word": " don't"}, {"start": 202.84, "end": 202.96, "word": " have"}, {"start": 202.96, "end": 203.12, "word": " enough."}]}, {"start": 203.48, "end": 204.62, "text": " Do what you can, Percy.", "words": [{"start": 203.48, "end": 203.96, "word": " Do"}, {"start": 203.96, "end": 204.12, "word": " what"}, {"start": 204.12, "end": 204.2, "word": " you"}, {"start": 204.2, "end": 204.38, "word": " can,"}, {"start": 204.42, "end": 204.62, "word": " Percy."}]}, {"start": 210.42, "end": 212.94, "text": " The children, the wounded, and the women come first.", "words": [{"start": 210.42, "end": 210.9, "word": " The"}, {"start": 210.9, "end": 211.38, "word": " children,"}, {"start": 211.54, "end": 211.66, "word": " the"}, {"start": 211.66, "end": 211.9, "word": " wounded,"}, {"start": 211.92, "end": 212.08, "word": " and"}, {"start": 212.08, "end": 212.14, "word": " the"}, {"start": 212.14, "end": 212.34, "word": " women"}, {"start": 212.34, "end": 212.58, "word": " come"}, {"start": 212.58, "end": 212.94, "word": " first."}]}, {"start": 215.57, "end": 216.31, "text": " Morning, Alfred.", "words": [{"start": 215.57, "end": 216.05, "word": " Morning,"}, {"start": 216.13, "end": 216.31, "word": " Alfred."}]}, {"start": 217.31, "end": 218.67, "text": " What news from the Night Watch?", "words": [{"start": 217.31, "end": 217.79, "word": " What"}, {"start": 217.79, "end": 218.03, "word": " news"}, {"start": 218.03, "end": 218.19, "word": " from"}, {"start": 218.19, "end": 218.33, "word": " the"}, {"start": 218.33, "end": 218.45, "word": " Night"}, {"start": 218.45, "end": 218.67, "word": " Watch?"}]}, {"start": 219.03, "end": 221.21, "text": " All quiet, sire. Not much to report.", "words": [{"start": 219.03, "end": 219.47, "word": " All"}, {"start": 219.47, "end": 219.79, "word": " quiet,"}, {"start": 219.93, "end": 220.19, "word": " sire."}, {"start": 220.37, "end": 220.69, "word": " Not"}, {"start": 220.69, "end": 220.85, "word": " much"}, {"start": 220.85, "end": 221.01, "word": " to"}, {"start": 221.01, "end": 221.21, "word": " report."}]}, {"start": 222.19, "end": 223.41, "text": " Nothing gets past me.", "words": [{"start": 222.19, "end": 222.67, "word": " Nothing"}, {"start": 222.67, "end": 222.91, "word": " gets"}, {"start": 222.91, "end": 223.23, "word": " past"}, {"start": 223.23, "end": 223.41, "word": " me."}]}, {"start": 231.15, "end": 233.85, "text": " Except an army of elves, it would seem.", "words": [{"start": 231.15, "end": 231.63, "word": " Except"}, {"start": 231.63, "end": 231.95, "word": " an"}, {"start": 231.95, "end": 232.19, "word": " army"}, {"start": 232.19, "end": 232.37, "word": " of"}, {"start": 232.37, "end": 232.69, "word": " elves,"}, {"start": 232.83, "end": 233.41, "word": " it"}, {"start": 233.41, "end": 233.59, "word": " would"}, {"start": 233.59, "end": 233.85, "word": " seem."}]}, {"start": 233.85, "end": 278.18, "text": " My Lord Frandu, we did not look to see you here.", "words": [{"start": 233.85, "end": 234.87, "word": " My"}, {"start": 275.26, "end": 275.46, "word": " Lord"}, {"start": 275.46, "end": 275.84, "word": " Frandu,"}, {"start": 275.92, "end": 277.12, "word": " we"}, {"start": 277.12, "end": 277.26, "word": " did"}, {"start": 277.26, "end": 277.42, "word": " not"}, {"start": 277.42, "end": 277.58, "word": " look"}, {"start": 277.58, "end": 277.7, "word": " to"}, {"start": 277.7, "end": 277.88, "word": " see"}, {"start": 277.88, "end": 277.98, "word": " you"}, {"start": 277.98, "end": 278.18, "word": " here."}]}, {"start": 278.3, "end": 279.5, "text": " I heard you needed aid.", "words": [{"start": 278.3, "end": 278.5, "word": " I"}, {"start": 278.5, "end": 278.76, "word": " heard"}, {"start": 278.76, "end": 278.92, "word": " you"}, {"start": 278.92, "end": 279.16, "word": " needed"}, {"start": 279.16, "end": 279.5, "word": " aid."}]}, {"start": 308.42, "end": 312.14, "text": " You have saved us. I do not know how to thank you.", "words": [{"start": 308.42, "end": 308.94, "word": " You"}, {"start": 308.94, "end": 309.08, "word": " have"}, {"start": 309.08, "end": 309.4, "word": " saved"}, {"start": 309.4, "end": 309.64, "word": " us."}, {"start": 310.52, "end": 311.04, "word": " I"}, {"start": 311.04, "end": 311.16, "word": " do"}, {"start": 311.16, "end": 311.34, "word": " not"}, {"start": 311.34, "end": 311.48, "word": " know"}, {"start": 311.48, "end": 311.64, "word": " how"}, {"start": 311.64, "end": 311.74, "word": " to"}, {"start": 311.74, "end": 311.94, "word": " thank"}, {"start": 311.94, "end": 312.14, "word": " you."}]}, {"start": 312.32, "end": 319.14, "text": " Your gratitude is misplaced. I did not come on your behalf. I came to reclaim something of mine.", "words": [{"start": 312.32, "end": 312.52, "word": " Your"}, {"start": 312.52, "end": 312.98, "word": " gratitude"}, {"start": 312.98, "end": 313.24, "word": " is"}, {"start": 313.24, "end": 313.9, "word": " misplaced."}, {"start": 314.4, "end": 314.92, "word": " I"}, {"start": 314.92, "end": 315.06, "word": " did"}, {"start": 315.06, "end": 315.2, "word": " not"}, {"start": 315.2, "end": 315.4, "word": " come"}, {"start": 