": 378.14, "word": " work."}]}, {"start": 380.48, "end": 381.14, "text": " Come on.", "words": [{"start": 380.48, "end": 380.96, "word": " Come"}, {"start": 380.96, "end": 381.14, "word": " on."}]}, {"start": 405.86, "end": 409.58, "text": " Son of Thrain, we are glad to find you alive beyond hope.", "words": [{"start": 405.86, "end": 406.34, "word": " Son"}, {"start": 406.34, "end": 406.58, "word": " of"}, {"start": 406.58, "end": 406.88, "word": " Thrain,"}, {"start": 407.0, "end": 407.74, "word": " we"}, {"start": 407.74, "end": 407.84, "word": " are"}, {"start": 407.84, "end": 408.1, "word": " glad"}, {"start": 408.1, "end": 408.24, "word": " to"}, {"start": 408.24, "end": 408.48, "word": " find"}, {"start": 408.48, "end": 408.64, "word": " you"}, {"start": 408.64, "end": 408.82, "word": " alive"}, {"start": 408.82, "end": 409.22, "word": " beyond"}, {"start": 409.22, "end": 409.58, "word": " hope."}]}, {"start": 410.16, "end": 413.72, "text": " Why do you come to the gates of the King Under the Mountain armed for war?", "words": [{"start": 410.16, "end": 410.64, "word": " Why"}, {"start": 410.64, "end": 410.84, "word": " do"}, {"start": 410.84, "end": 410.96, "word": " you"}, {"start": 410.96, "end": 411.16, "word": " come"}, {"start": 411.16, "end": 411.3, "word": " to"}, {"start": 411.3, "end": 411.4, "word": " the"}, {"start": 411.4, "end": 411.72, "word": " gates"}, {"start": 411.72, "end": 411.84, "word": " of"}, {"start": 411.84, "end": 411.92, "word": " the"}, {"start": 411.92, "end": 412.14, "word": " King"}, {"start": 412.14, "end": 412.3, "word": " Under"}, {"start": 412.3, "end": 412.44, "word": " the"}, {"start": 412.44, "end": 412.78, "word": " Mountain"}, {"start": 412.78, "end": 413.12, "word": " armed"}, {"start": 413.12, "end": 413.4, "word": " for"}, {"start": 413.4, "end": 413.72, "word": " war?"}]}, {"start": 414.56, "end": 419.78, "text": " Why does the King Under the Mountain fence himself in, like a robber in his hole?", "words": [{"start