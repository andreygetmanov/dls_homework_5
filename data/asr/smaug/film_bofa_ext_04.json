"}, {"start": 492.5, "end": 492.68, "word": " do"}, {"start": 492.68, "end": 492.9, "word": " not"}, {"start": 492.9, "end": 493.16, "word": " sway"}, {"start": 493.16, "end": 493.42, "word": " me."}]}, {"start": 495.92, "end": 497.12, "text": " What of your conscience?", "words": [{"start": 495.92, "end": 496.44, "word": " What"}, {"start": 496.44, "end": 496.6, "word": " of"}, {"start": 496.6, "end": 496.7, "word": " your"}, {"start": 496.7, "end": 497.12, "word": " conscience?"}]}, {"start": 497.92, "end": 500.22, "text": " Does it not tell you our cause is just?", "words": [{"start": 497.92, "end": 498.44, "word": " Does"}, {"start": 498.44, "end": 498.6, "word": " it"}, {"start": 498.6, "end": 498.76, "word": " not"}, {"start": 498.76, "end": 499.0, "word": " tell"}, {"start": 499.0, "end": 499.2, "word": " you"}, {"start": 499.2, "end": 499.32, "word": " our"}, {"start": 499.32, "end": 499.64, "word": " cause"}, {"start": 499.64, "end": 499.82, "word": " is"}, {"start": 499.82, "end": 500.22, "word": " just?"}]}, {"start": 502.02, "end": 504.42, "text": " My people offered you help,", "words": [{"start": 502.02, "end": 502.54, "word": " My"}, {"start": 502.54, "end": 502.96, "word": " people"}, {"start": 502.96, "end": 503.7, "word": " offered"}, {"start": 503.7, "end": 504.0, "word": " you"}, {"start": 504.0, "end": 504.42, "word": " help,"}]}, {"start": 504.64, "end": 510.09, "text": " and in return you brought upon them only ruin and death.", "words": [{"start": 504.64, "end": 505.22, "word": " and"}, {"start": 506.69, "end": 506.85, "word": " in"}, {"start": 506.85, "end": 507.21, "word": " return"}, {"start": 507.21, "end": 507.69, "word": " you"}, {"start": 507.69, "end": 507.95, "word": " brought"}, {"start": 507.95, "end": 508.23, "word": " upon"}, {"start": 508.23, "end": 508.57, "word": " them"}, {"start": 508.57, "end": 508.87, "word": " only"}, {"start": 508.87, "end": 509.31, "word": " ruin"}, {"start": 509.31, "end": 509.65, "word": " and"}, {"st