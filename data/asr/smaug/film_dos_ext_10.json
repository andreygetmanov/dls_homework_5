": 274.89, "end": 275.21, "word": " to"}, {"start": 275.21, "end": 275.35, "word": " the"}, {"start": 275.35, "end": 275.65, "word": " master"}, {"start": 275.65, "end": 275.85, "word": " of"}, {"start": 275.85, "end": 275.93, "word": " the"}, {"start": 275.93, "end": 276.15, "word": " men"}, {"start": 276.15, "end": 276.25, "word": " of"}, {"start": 276.25, "end": 276.33, "word": " the"}, {"start": 276.33, "end": 276.65, "word": " lake."}, {"start": 277.21, "end": 277.81, "word": " Will"}, {"start": 277.81, "end": 277.91, "word": " you"}, {"start": 277.91, "end": 278.17, "word": " see"}, {"start": 278.17, "end": 278.29, "word": " the"}, {"start": 278.29, "end": 278.65, "word": " prophecy"}, {"start": 278.65, "end": 279.05, "word": " fulfilled?"}]}, {"start": 279.39, "end": 285.65, "text": " And the great wealth of our people.", "words": [{"start": 279.39, "end": 279.87, "word": " And"}, {"start": 284.19, "end": 284.29, "word": " the"}, {"start": 284.29, "end": 284.55, "word": " great"}, {"start": 284.55, "end": 284.93, "word": " wealth"}, {"start": 284.93, "end": 285.13, "word": " of"}, {"start": 285.13, "end": 285.23, "word": " our"}, {"start": 285.23, "end": 285.65, "word": " people."}]}, {"start": 290.74, "end": 291.8, "text": " What say you?", "words": [{"start": 290.74, "end": 291.28, "word": " What"}, {"start": 291.28, "end": 291.56, "word": " say"}, {"start": 291.56, "end": 291.8, "word": " you?"}]}, {"start": 296.16, "end": 307.15, "text": " I say unto you, welcome, welcome, king under the mountain.", "words": [{"start": 296.16, "end": 296.76, "word": " I"}, {"start": 296.76, "end": 297.28, "word": " say"}, {"start": 297.28, "end": 297.84, "word": " unto"}, {"start": 297.84, "end": 298.36, "word": " you,"}, {"start": 298.5, "end": 299.12, "word": " welcome,"}, {"start": 301.4, "end": 302.04, "word": " welcome,"}, {"start": 305.21, "end": 305.83, "word": " king"}, {"start": 305.83, "end": 306.61, "word": " under"}, {"start": 306.61, "end": 306.83, "word": " the"}, {"start": 306.83, "end": 307.15, "word": " mountain."}]}, {"start": 307.75, "end": 321.85, "text": " You do know we're one short. Where's Bofa?", "words": [{"start": 307.75, "end": 308.19, "word": " You"}, {"start": 319.77, "end": 319.91, "word": " do"}, {"start": 319.91, "end": 320.09, "word": " know"}, {"start": 320.09, "end": 320.27, "word": " we're"}, {"start": 320.27, "end": 320.37, "word": " one"}, {"start": 320.37, "end": 320.71, "word": " short."}, {"start": 320.99, "end": 321.51, "word": " Where's"}, {"start": 321.51, "end": 321.85, "word": " Bofa?"}]}, {"start": 321.95, "end": 323.23, "text": " He's not here. We'll leave him behind.", "words": [{"start": 321.95, "end": 322.35, "word": " He's"}, {"start": 322.35, "end": 322.43, "word": " not"}, {"start": 322.43, "end": 322.63, "word": " here."}, {"start": 322.63, "end": 322.77, "word": " We'll"}, {"start": 322.77, "end": 322.89, "word": " leave"}, {"start": 322.89, "end": 322.97, "word": " him"}, {"start": 322.97, "end": 323.23, "word": " behind."}]}, {"start": 323.75, "end": 328.21, "text": " We'll have to. If we're to find the door before nightfall, we can risk no more delays.", "words": [{"start": 323.75, "end": 324.05, "word": " We'll"}, {"start": 324.05, "end": 324.25, "word": " have"}, {"start": 324.25, "end": 324.43, "word": " to."}, {"start": 324.71, "end": 325.07, "word": " If"}, {"start": 325.07, "end": 325.21, "word": " we're"}, {"start": 325.21, "end": 325.25, "word": " to"}, {"start": 325.25, "end": 325.49, "word": " find"}, {"start": 325.49, "end": 325.63, "word": " the"}, {"start": 325.63, "end": 325.81, "word": " door"}, {"start": 325.81, "end": 326.03, "word": " before"}, {"start": 326.03, "end": 326.61, "word": " nightfall,"}, {"start": 326.75, "end": 327.11, "word": " we"}, {"start": 327.11, "end": 327.25, "word": " can"}, {"start": 327.25, "end": 327.49, "word": " risk"}, {"start": 327.49, "end": 327.69, "word": " no"}, {"start": 327.69, "end": 327.91, "word": " more"}, {"start": 327.91, "end": 328.21, "word": " delays."}]}, {"start": 333.27, "end": 336.63, "text": " Nor you. We must travel at speed. You will slow us down.", "words": [{"start": 333.27, "end": 333.63, "word": " Nor"}, {"start": 333.63, "end": 333.81, "word": " you."}, {"start": 334.65, "end": 335.01, "word": " We"}, {"start": 335.01, "end": 335.19, "word": " must"}, {"start": 335.19, "end": 335.45, "word": " travel"}, {"start": 335.45, "end": 335.55, "word": " at"}, {"start": 335.55, "end": 335.75, "word": " speed."}, {"start": 335.89, "end": 336.01, "word": " You"}, {"start": 336.01, "end": 336.09, "word": " will"}, {"start": 336.09, "end": 336.33, "word": " slow"}, {"start": 336.33, "end": 336.47, "word": " us"}, {"start": 336.47, "end": 336.63, "word": " down."}]}, {"start": 338.29, "end": 339.89, "text": " What are you talking about? I'm coming with you.", "words": [{"start": 338.29, "end": 338.65, "word": " What"}, {"start": 338.65, "end": 338.75, "word": " are"}, {"start": 338.75, "end": 338.83, "word": " you"}, {"start": 338.83, "end": 339.07, "word": " talking"}, {"start": 339.07, "end": 339.27, "word": " about?"}, {"start": 339.37, "end": 339.47, "word": " I'm"}, {"start": 339.47, "end": 339.59, "word": " coming"}, {"start": 339.59, "end": 339.73, "word": " with"}, {"start": 339.73, "end": 339.89, "word": " you."}]}, {"start": 340.07, "end": 348.11, "text": " No, no. I'm going to be there when that door is opened.", "words": [{"start": 340.07, "end": 340.33, "word": " No,"}, {"start": 340.35, "end": 340.47, "word": " no."}, {"start": 346.53, "end": 346.89, "word": " I'm"}, {"start": 346.89, "end": 347.05, "word": " going"}, {"start": 347.05, "end": 347.15, "word": " to"}, {"start": 347.15, "end": 347.25, "word": " be"}, {"start": 347.25, "end": 347.39, "word": " there"}, {"start": 347.39, "end": 347.51, "word": " when"}, {"start": 347.51, "end": 347.61, "word": " that"}, {"start": 347.61, "end": 347.75, "word": " door"}, {"start": 347.75, "end": 347.87, "word": " is"}, {"start": 347.87, "end": 348.11, "word": " opened."}]}, {"start": 348.87, "end": 351.05, "text": " When we first look upon the halls of our father's throne.", "words": [{"start": 348.87, "end": 349.23, "word": " When"}, {"start": 349.23, "end": 349.35, "word": " we"}, {"start": 349.35, "end": 349.59, "word": " first"}, {"start": 349.59, "end": 349.75, "word": " look"}, {"start": 349.75, "end": 349.91, "word": " upon"}, {"start": 349.91, "end": 350.11, "word": " the"}, {"start": 350.11, "end": 350.23, "word": " halls"}, {"start": 350.23, "end": 350.37, "word": " of"}, {"start": 350.37, "end": 350.47, "word": " our"}, {"start": 350.47, "end": 350.87, "word": " father's"}, {"start": 350.87, "end": 351.05, "word": " throne."}]}, {"start": 351.21, "end": 354.49, "text": " Kitty, stay here. Rest.", "words": [{"start": 351.21, "end": 351.33, "word": " Kitty,"}, {"start": 351.57, "end": 352.93, "word": " stay"}, {"start": 352.93, "end": 353.17, "word": " here."}, {"start": 354.13, "end": 354.49, "word": " Rest."}]}, {"start": 354.93, "end": 366.1, "text": " I'll stay with the lad. My beauty lies with the wounded.", "words": [{"start": 354.93, "end": 355.29, "word": " I'll"}, {"start": 363.52, "end": 363.8, "word": " stay"}, {"start": 363.8, "end": 363.96, "word": " with"}, {"start": 363.96, "end": 364.08, "word": " the"}, {"start": 364.08, "end": 364.3, "word": " lad."}, {"start": 364.46, "end": 364.74, "word": " My"}, {"start": 364.74, "end": 365.08, "word": " beauty"}, {"start": 365.08, "end": 365.46, "word": " lies"}, {"start": 365.46, "end": 365.68, "word": " with"}, {"start": 365.68, "end": 365.82, "word": " the"}, {"start": 365.82, "end": 366.1, "word": " wounded."}]}, {"start": 368.14, "end": 371.48, "text": " Uncle, we grew up on Tales of the Mountain. Tales you told us.", "words": [{"start": 368.14, "end": 368.5, "word": " Uncle,"}, {"start": 368.5, "end": 368.86, "word": " we"}, {"start": 368.86, "end": 369.06, "word": " grew"}, {"start": 369.06, "end": 369.28, "word": " up"}, {"start": 369.28, "end": 369.38, "word": " on"}, {"start": 369.38, "end": 369.6, "word": " Tales"}, {"start": 369.6, "end": 369.74, "word": " of"}, {"start": 369.74, "end": 369.82, "word": " the"}, {"start": 369.82, "end": 370.02, "word": " Mountain."}, {"start": 370.38, "end": 370.74, "word": " Tales"}, {"start": 370.74, "end": 370.98, "word": " you"}, {"start": 370.98, "end": 371.22, "word": " told"}, {"start": 371.22, "end": 371.48, "word": " us."}]}, {"start": 371.74, "end": 373.52, "text": " You cannot take that away from him.", "words": [{"start": 371.74, "end": 372.24, "word": " You"}, {"start": 372.24, "end": 372.52, "word": " cannot"}, {"start": 372.52, "end": 372.8, "word": " take"}, {"start": 372.8, "end": 372.92, "word": " that"}, {"start": 372.92, "end": 373.08, "word": " away"}, {"start": 373.08, "end": 373.34, "word": " from"}, {"start": 373.34, "end": 373.52, "word": " him."}]}, {"start": 373.6, "end": 373.84, "text": " Fili.", "words": [{"start": 373.6, "end": 373.84, "word": " Fili."}]}, {"start": 373.96, "end": 375.48, "text": " I will carry him if I must.", "words": [{"start": 373.96, "end": 374.34, "word": " I"}, {"start": 374.34, "end": 374.46, "word": " will"}, {"start": 374.46, "end": 374.76, "word": " carry"}, {"start": 374.76, "end": 375.02, "word": " him"}, {"start": 375.02, "end": 375.18, "word": " if"}, {"start": 375.18, "end": 375.26, "word": " I"}, {"start": 375.26, "end": 375.48, "word": " must."}]}, {"start": 375.74, "end": 377.8, "text": " One day you will be king and you will understand.", "words": [{"start": 375.74, "end": 376.1, "word": " One"}, {"start": 376.1, "end": 376.28, "word": " day"}, {"start": 376.28, "end": 376.48, "word": " you"}, {"start": 376.48, "end": 376.62, "word": " will"}, {"start": 376.62, "end": 376.76, "word": " be"}, {"start": 376.76, "end": 377.02, "word": " king"}, {"start": 377.02, "end": 377.2, "word": " and"}, {"start": 377.2, "end": 377.32, "word": " you"}, {"start": 377.32, "end": 377.44, "word": " will"}, {"start": 377.44, "end": 377.8, "word": " understand."}]}, {"start": 378.68, "end": 381.72, "text": " I cannot risk the fate of this quest for the sake of one dwarf.", "words": [{"start": 378.68, "end": 379.12, "word": " I"}, {"start": 379.12, "end": 379.34, "word": " cannot"}, {"start": 379.34, "end": 379.66, "word": " risk"}, {"start": 379.66, "end": 379.92, "word": " the"}, {"start": 379.92, "end": 380.1, "word": " fate"}, {"start": 380.1, "end": 380.22, "word": " of"}, {"start": 380.22, "end": 380.34, "word": " this"}, {"start": 380.34, "end": 380.64, "word": " quest"}, {"start": 380.64, "end": 380.84, "word": " for"}, {"start": 380.84, "end": 380.92, "word": " the"}, {"start": 380.92, "end": 381.12, "word": " sake"}, {"start": 381.12, "end": 381.26, "word": " of"}, {"start": 381.26, "end": 381.4, "word": " one"}, {"start": 381.4, "end": 381.72, "word": " dwarf."}]}, {"start": 388.91, "end": 389.35, "text": " Fili.", "words": [{"start": 388.91, "end": 389.35, "word": " Fili."}]}, {"start": 389.41, "end": 390.05, "text": " Don't be a fool.", "words": [{"start": 389.41, "end": 389.69, "word": " Don't"}, {"start": 389.69, "end": 389.77, "word": " be"}, {"start": 389.77, "end": 389.89, "word": " a"}, {"start": 389.89, "end": 390.05, "word": " fool."}]}, {"start": 390.59, "end": 391.61, "text": " You belong with the company.", "words": [{"start": 390.59, "end": 391.03, "word": " You"}, {"start": 391.03, "end": 391.21, "word": " belong"}, {"start": 391.21, "end": 391.35, "word": " with"}, {"start": 391.35, "end": 391.39, "word": " the"}, {"start": 391.39, "end": 391.61, "word": " company."}]}, {"start": 391.91, "end": 393.03, "text": " I belong with my brother.", "words": [{"start": 391.91, "end": 392.29, "word": " I"}, {"start": 392.29, "end": 392.47, "word": " belong"}, {"start": 392.47, "end": 392.65, "word": " with"}, {"start": 392.65, "end": 392.77, "word": " my"}, {"start": 392.77, "end": 393.03, "word": " brother."}]}, {"start": 393.41, "end": 407.85, "text": " By my beard, is that the time?", "words": [{"start": 393.41, "end": 393.81, "word": " By"}, {"start": 405.59, "end": 405.95, "word": " my"}, {"start": 405.95, "end": 406.69, "word": " beard,"}, {"start": 406.81, "end": 406.95, "word": " is"}, {"start": 406.95, "end": 407.21, "word": " that"}, {"start": 407.21, "end": 407.45, "word": " the"}, {"start": 407.45, "end": 407.85, "word": " time?"}]}, {"start": 419.41, "end": 419.85, "text": " Fortunes!", "words": [{"start": 419.41, "end": 419.85, "word": " Fortunes!"}]}, {"start": 424.75, "end": 425.19, "text": " Goodbye!", "words": [{"start": 424.75, "end": 425.19, "word": " Goodbye!"}]}, {"start": 427.03, "end": 443.25, "text": " Did you miss the boat as well?", "words": [{"start": 427.03, "end": 427.47, "word": " Did"}, {"start": 442.19, "end": 442.43, "word": " you"}, {"start": 442.43, "end": 442.63, "word": " miss"}, {"start": 442.63, "end": 442.75, "word": " the"}, {"start": 442.75, "end": 442.91, "word": " boat"}, {"start": 442.91, "end": 443.07, "word": " as"}, {"start": 443.07, "end": 443.25, "word": " well?"}]}, {"start": 443.63, "end": 444.07, "text": " Fili.", "words": [{"start": 443.63, "end": 444.07, "word": " Fili."}]}, {"start": 444.17, "end": 444.57, "text": " Fili!", "words": [{"start": 444.17, "end": 444.57, "word": " Fili!"}]}, {"start": 451.71, "end": 453.03, "text": " Masterfully handled, sire.", "words": [{"start": 451.71, "end": 452.23, "word": " Masterfully"}, {"start": 452.23, "end": 452.59, "word": " handled,"}, {"start": 452.73, "end": 453.03, "word": " sire."}]}, {"start": 453.31, "end": 455.39, "text": " Your popularity's never been so high.", "words": [{"start": 453.31, "end": 453.73, "word": " Your"}, {"start": 453.73, "end": 454.45, "word": " popularity's"}, {"start": 454.45, "end": 454.59, "word": " never"}, {"start": 454.59, "end": 454.81, "word": " been"}, {"start": 454.81, "end": 455.07, "word": " so"}, {"start": 455.07, "end": 455.39, "word": " high."}]}, {"start": 455.59, "end": 457.85, "text": " The entire town's twittering your name.", "words": [{"start": 455.59, "end": 455.95, "word": " The"}, {"start": 455.95, "end": 456.27, "word": " entire"}, {"start": 456.27, "end": 456.91, "word": " town's"}, {"start": 456.91, "end": 457.39, "word": " twittering"}, {"start": 457.39, "end": 457.55, "word": " your"}, {"start": 457.55, "end": 457.85, "word": " name."}]}, {"start": 458.05, "end": 459.17, "text": " Yes, it was rather clever.", "words": [{"start": 458.05, "end": 458.27, "word": " Yes,"}, {"start": 458.31, "end": 458.43, "word": " it"}, {"start": 458.43, "end": 458.57, "word": " was"}, {"start": 458.57, "end": 458.79, "word": " rather"}, {"start": 458.79, "end": 459.17, "word": " clever."}]}, {"start": 459.47, "end": 461.71, "text": " Either our little friends return triumphant,", "words": [{"start": 459.47, "end": 459.99, "word": " Either"}, {"start": 459.99, "end": 460.19, "word": " our"}, {"start": 460.19, "end": 460.37, "word": " little"}, {"start": 460.37, "end": 460.67, "word": " friends"}, {"start": 460.67, "end": 460.91, "word": " return"}, {"start": 460.91, "end": 461.71, "word": " triumphant,"}]}, {"start": 461.85, "end": 464.93, "text": " in which case I stand to make a pretty penny,", "words": [{"start": 461.85, "end": 462.27, "word": " in"}, {"start": 462.27, "end": 462.43, "word": " which"}, {"start": 462.43, "end": 462.69, "word": " case"}, {"start": 462.69, "end": 462.95, "word": " I"}, {"start": 462.95, "end": 463.21, "word": " stand"}, {"start": 463.21, "end": 463.47, "word": " to"}, {"start": 463.47, "end": 463.65, "word": " make"}, {"start": 463.65, "end": 463.83, "word": " a"}, {"start": 463.83, "end": 464.55, "word": " pretty"}, {"start": 464.55, "end": 464.93, "word": " penny,"}]}, {"start": 465.07, "end": 468.83, "text": " or old Smough dines on dwarf for a day or two.", "words": [{"start": 465.07, "end": 465.43, "word": " or"}, {"start": 465.43, "end": 465.65, "word": " old"}, {"start": 465.65, "end": 466.29, "word": " Smough"}, {"start": 466.29, "end": 467.11, "word": " dines"}, {"start": 467.11, "end": 467.29, "word": " on"}, {"start": 467.29, "end": 467.69, "word": " dwarf"}, {"start": 467.69, "end": 468.05, "word": " for"}, {"start": 468.05, "end": 468.19, "word": " a"}, {"start": 468.19, "end": 468.43, "word": " day"}, {"start": 468.43, "end": 468.57, "word": " or"}, {"start": 468.57, "end": 468.83, "word": " two."}]}, {"start": 468.91, "end": 471.43, "text": " The important thing is they're off our hands.", "words": [{"start": 468.91, "end": 469.21, "word": " The"}, {"start": 469.21, "end": 469.51, "word": " important"}, {"start": 469.51, "end": 469.77, "word": " thing"}, {"start": 469.77, "end": 470.01, "word": " is"}, {"start": 470.01, "end": 470.27, "word": " they're"}, {"start": 470.27, "end": 470.55, "word": " off"}, {"start": 470.55, "end": 470.85, "word": " our"}, {"start": 470.85, "end": 471.43, "word": " hands."}]}, {"start": 471.79, "end": 472.43, "text": " Please wait!", "words": [{"start": 471.79, "end": 472.19, "word": " Please"}, {"start": 472.19, "end": 472.43, "word": " wait!"}]}, {"start": 473.37, "end": 475.09, "text": " Please, we need your help.", "words": [{"start": 473.37, "end": 473.89, "word": " Please,"}, {"start": 474.01, "end": 474.51, "word": " we"}, {"start": 474.51, "end": 474.67, "word": " need"}, {"start": 474.67, "end": 474.83, "word": " your"}, {"start": 474.83, "end": 475.09, "word": " help."}]}, {"start": 475.19, "end": 476.31, "text": " My brother is sick.", "words": [{"start": 475.19, "end": 475.67, "word": " My"}, {"start": 475.67, "end": 475.93, "word": " brother"}, {"start": 475.93, "end": 476.07, "word": " is"}, {"start": 476.07, "end": 476.31, "word": " sick."}]}, {"start": 476.43, "end": 478.29, "text": " Sick? Is it infectious?", "words": [{"start": 476.43, "end": 476.89, "word": " Sick?"}, {"start": 477.23, "end": 477.75, "word": " Is"}, {"start": 477.75, "end": 477.91, "word": " it"}, {"start": 477.91, "end": 478.29, "word": " infectious?"}]}, {"start": 478.29, "end": 482.07, "text": " Get back! Alfred! Alfred! Don't let them come any closer!", "words": [{"start": 478.29, "end": 478.89, "word": " Get"}, {"start": 478.89, "end": 479.43, "word": " back!"}, {"start": 479.83, "end": 480.35, "word": " Alfred!"}, {"start": 480.49, "end": 480.77, "word": " Alfred!"}, {"start": 480.91, "end": 481.23, "word": " Don't"}, {"start": 481.23, "end": 481.29, "word": " let"}, {"start": 481.29, "end": 481.43, "word": " them"}, {"start": 481.43, "end": 481.57, "word": " come"}, {"start": 481.57, "end": 481.71, "word": " any"}, {"start": 481.71, "end": 482.07, "word": " closer!"}]}, {"start": 482.27, "end": 484.37, "text": " Please! We need medicine!", "words": [{"start": 482.27, "end": 482.77, "word": " Please!"}, {"start": 483.05, "end": 483.57, "word": " We"}, {"start": 483.57, "end": 483.83, "word": " need"}, {"start": 483.83, "end": 484.37, "word": " medicine!"}]}, {"start": 486.07, "end": 487.75, "text": " Do I look like an apothecary?", "words": [{"start": 486.07, "end": 486.59, "word": " Do"}, {"start": 486.59, "end": 486.71, "word": " I"}, {"start": 486.71, "end": 486.91, "word": " look"}, {"start": 486.91, "end": 487.11, "word": " like"}, {"start": 487.11, "end": 487.27, "word": " an"}, {"start": 487.27, "end": 487.75, "word": " apothecary?"}]}, {"start": 488.51, "end": 491.27, "text": " Haven't we given you enough? The master's a busy man.", "words": [{"start": 488.51, "end": 489.03, "word": " Haven't"}, {"start": 489.03, "end": 489.11, "word": " we"}, {"start": 489.11, "end": 489.33, "word": " given"}, {"start": 489.33, "end": 489.49, "word": " you"}, {"start": 489.49, "end": 489.69, "word": " enough?"}, {"start": 489.97, "end": 490.15, "word": " The"}, {"start": 490.15, "end": 490.67, "word": " master's"}, {"start": 490.67, "end": 490.75, "word": " a"}, {"start": 490.75, "end": 490.99, "word": " busy"}, {"start": 490.99, "end": 491.27, "word": " man."}]}, {"start": 491.45, "end": 494.31, "text": " He hasn't got time to worry about sick dwarves.", "words": [{"start": 491.45, "end": 491.79, "word": " He"}, {"start": 491.79, "end": 492.01, "word": " hasn't"}, {"start": 492.01, "end": 492.13, "word": " got"}, {"start": 492.13, "end": 492.41, "word": " time"}, {"start": 492.41, "end": 492.63, "word": " to"}, {"start": 492.63, "end": 492.83, "word": " worry"}, {"start": 492.83, "end": 493.11, "word": " about"}, {"start": 493.11, "end": 493.51, "word": " sick"}, {"start": 493.51, "end": 494.31, "word": " dwarves."}]}, {"start": 494.79, "end": 496.77, "text": " Be gone, we are going clear off.", "words": [{"start": 494.79, "end": 495.31, "word": " Be"}, {"start": 495.31, "end": 495.59, "word": " gone,"}, {"start": 495.59, "end": 495.75, "word": " we"}, {"start": 495.75, "end": 495.77, "word": " are"}, {"start": 495.77, "end": 495.97, "word": " going"}, {"start": 495.97, "end": 496.47, "word": " clear"}, {"start": 496.47, "end": 496.77, "word": " off."}]}, {"start": 497.69, "end": 500.99, "text": " What this town needs, Alfred, is a good purge,", "words": [{"start": 497.69, "end": 498.21, "word": " What"}, {"start": 498.21, "end": 498.61, "word": " this"}, {"start": 498.61, "end": 498.83, "word": " town"}, {"start": 498.83, "end": 499.15, "word": " needs,"}, {"start": 499.33, "end": 499.67, "word": " Alfred,"}, {"start": 499.77, "end": 499.93, "word": " is"}, {"start": 499.93, "end": 500.05, "word": " a"}, {"start": 500.05, "end": 500.19, "word": " good"}, {"start": 500.19, "end": 500.99, "word": " purge,"}]}, {"start": 500.99, "end": 504.91, "text": " starting with a certain troublemaker who saw fit to question my authority.", "words": [{"start": 500.99, "end": 501.61, "word": " starting"}, {"start": 501.61, "end": 501.93, "word": " with"}, {"start": 501.93, "end": 502.07, "word": " a"}, {"start": 502.07, "end": 502.43, "word": " certain"}, {"start": 502.43, "end": 503.15, "word": " troublemaker"}, {"start": 503.15, "end": 503.37, "word": " who"}, {"start": 503.37, "end": 503.55, "word": " saw"}, {"start": 503.55, "end": 503.81, "word": " fit"}, {"start": 503.81, "end": 503.99, "word": " to"}, {"start": 503.99, "end": 504.29, "word": " question"}, {"start": 504.29, "end": 504.53, "word": " my"}, {"start": 504.53, "end": 504.91, "word": " authority."}]}, {"start": 505.33, "end": 506.95, "text": " A certain bargeman, sire?", "words": [{"start": 505.33, "end": 505.47, "word": " A"}, {"start": 505.47, "end": 505.83, "word": " certain"}, {"start": 505.83, "end": 506.59, "word": " bargeman,"}, {"start": 506.63, "end": 506.95, "word": " sire?"}]}, {"start": 506.95, "end": 507.75, "text": " Precisely.", "words": [{"start": 506.95, "end": 507.75, "word": " Precisely."}]}, {"start": 510.4, "end": 513.5, "text": " No. I'm done with dwarves. Go away.", "words": [{"start": 510.4, "end": 511.0, "word": " No."}, {"start": 511.6, "end": 512.2, "word": " I'm"}, {"start": 512.2, "end": 512.38, "word": " done"}, {"start": 512.38, "end": 512.52, "word": " with"}, {"start": 512.52, "end": 512.96, "word": " dwarves."}, {"start": 512.96, "end": 513.22, "word": " Go"}, {"start": 513.22, "end": 513.5, "word": " away."}]}, {"start": 513.78, "end": 514.6, "text": " No, no, no!", "words": [{"start": 513.78, "end": 514.12, "word": " No,"}, {"start": 514.12, "end": 514.38, "word": " no,"}, {"start": 514.38, "end": 514.6, "word": " no!"}]}, {"start": 514.6, "end": 516.7, "text": " Please. No one will help us.", "words": [{"start": 514.6, "end": 515.12, "word": " Please."}, {"start": 515.4, "end": 516.0, "word": " No"}, {"start": 516.0, "end": 516.16, "word": " one"}, {"start": 516.16, "end": 516.28, "word": " will"}, {"start": 516.28, "end": 516.5, "word": " help"}, {"start": 516.5, "end": 516.7, "word": " us."}]}, {"start": 516.98, "end": 517.64, "text": " Keeley's sick.", "words": [{"start": 516.98, "end": 517.44, "word": " Keeley's"}, {"start": 517.44, "end": 517.64, "word": " sick."}]}, {"start": 520.62, "end": 521.72, "text": " He's very sick.", "words": [{"start": 520.62, "end": 521.22, "word": " He's"}, {"start": 521.22, "end": 521.44, "word": " very"}, {"start": 521.44, "end": 521.72, "word": " sick."}]}, {"start": 522.14, "end": 562.12, "text": " He felt quiet.", "words": [{"start": 522.14, "end": 522.3, "word": " He"}, {"start": 561.5, "end": 561.7, "word": " felt"}, {"start": 561.7, "end": 562.12, "word": " quiet."}]}, {"start": 563.26, "end": 564.94, "text": " It wasn't always like this.", "words": [{"start": 563.26, "end": 563.86, "word": " It"}, {"start": 563.86, "end": 564.18, "word": " wasn't"}, {"start": 564.18, "end": 564.4, "word": " always"}, {"start": 564.4, "end": 564.72, "word": " like"}, {"start": 564.72, "end": 564.94, "word": " this."}]}, {"start": 567.16, "end": 571.12, "text": " Once, these slopes were lined with woodlands.", "words": [{"start": 567.16, "end": 567.76, "word": " Once,"}, {"start": 567.76, "end": 568.36, "word": " these"}, {"start": 568.36, "end": 568.74, "word": " slopes"}, {"start": 568.74, "end": 569.76, "word": " were"}, {"start": 569.76, "end": 570.1, "word": " lined"}, {"start": 570.1, "end": 570.68, "word": " with"}, {"start": 570.68, "end": 571.12, "word": " woodlands."}]}, {"start": 571.78, "end": 574.76, "text": " The trees were filled with birdsong.", "words": [{"start": 571.78, "end": 572.38, "word": " The"}, {"start": 572.38, "end": 572.86, "word": " trees"}, {"start": 572.86, "end": 573.64, "word": " were"}, {"start": 573.64, "end": 574.0, "word": " filled"}, {"start": 574.0, "end": 574.22, "word": " with"}, {"start": 574.22, "end": 574.76, "word": " birdsong."}]}, {"start": 580.0, "end": 581.46, "text": " Relax, Master Baggins.", "words": [{"start": 580.0, "end": 580.6, "word": " Relax,"}, {"start": 580.66, "end": 580.96, "word": " Master"}, {"start": 580.96, "end": 581.46, "word": " Baggins."}]}, {"start": 582.26, "end": 584.94, "text": " We have food, we have tools, and we're making good time.", "words": [{"start": 582.26, "end": 582.62, "word": " We"}, {"start": 582.62, "end": 582.8, "word": " have"}, {"start": 582.8, "end": 583.06, "word": " food,"}, {"start": 583.14, "end": 583.24, "word": " we"}, {"start": 583.24, "end": 583.38, "word": " have"}, {"start": 583.38, "end": 583.7, "word": " tools,"}, {"start": 583.8, "end": 583.98, "word": " and"}, {"start": 583.98, "end": 584.14, "word": " we're"}, {"start": 584.14, "end": 584.4, "word": " making"}, {"start": 584.4, "end": 584.64, "word": " good"}, {"start": 584.64, "end": 584.94, "word": " time."}]}]