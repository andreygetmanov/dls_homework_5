[{"start": 73.04, "end": 136.84, "text": " The eagles are coming.", "words": [{"start": 73.04, "end": 73.44, "word": " The"}, {"start": 136.0, "end": 136.4, "word": " eagles"}, {"start": 136.4, "end": 136.6, "word": " are"}, {"start": 136.6, "end": 136.84, "word": " coming."}]}, {"start": 188.06, "end": 190.0, "text": " Don't move. Don't move.", "words": [{"start": 188.06, "end": 188.32, "word": " Don't"}, {"start": 188.32, "end": 188.56, "word": " move."}, {"start": 189.5, "end": 189.9, "word": " Don't"}, {"start": 189.9, "end": 190.0, "word": " move."}]}, {"start": 190.0, "end": 190.38, "text": " Don't move. Lie still.", "words": [{"start": 190.0, "end": 190.0, "word": " Don't"}, {"start": 190.0, "end": 190.0, "word": " move."}, {"start": 190.06, "end": 190.18, "word": " Lie"}, {"start": 190.18, "end": 190.38, "word": " still."}]}, {"start": 192.08, "end": 192.48, "text": " Oh.", "words": [{"start": 192.08, "end": 192.48, "word": " Oh."}]}, {"start": 195.34, "end": 196.34, "text": " I'm glad you're here.", "words": [{"start": 195.34, "end": 195.74, "word": " I'm"}, {"start": 195.74, "end": 195.88, "word": " glad"}, {"start": 195.88, "end": 196.1, "word": " you're"}, {"start": 196.1, "end": 196.34, "word": " here."}]}, {"start": 196.52, "end": 203.76, "text": " No. You are not going anywhere, Thorin.", "words": [{"start": 196.52, "end": 196.92, "word": " No."}, {"start": 202.24, "end": 202.64, "word": " You"}, {"start": 202.64, "end": 202.82, "word": " are"}, {"start": 202.82, "end": 202.9, "word": " not"}, {"start": 202.9, "end": 203.02, "word": " going"}, {"start": 203.02, "end": 203.38, "word": " anywhere,"}, {"start": 203.5, "end": 203.76, "word": " Thorin."}]}, {"start": 211.22, "end": 213.18, "text": " You did what only a true friend would do.", "words": [{"start": 211.22, "end": 211.62, "word": " You"}, {"start": 211.62, "end": 211.8, "word": " did"}, {"start": 211.8, "end": 212.0, "word": " what"}, {"start": 212.0, "end": 212.2, "word": " only"}, {"start": 212.2, "end": 212.32, "word": " a"}, {"start": 212.32, "end": 212.48, "word": " true"}, {"start": 212.48, "end": 212.78, "word": " friend"}, {"start": 212.78, "end": 212.96, "word": " would"}, {"start": 212.96, "end": 213.18, "word": " do."}]}, {"start": 224.16, "end": 224.54, "text": " I'm sorry.", "words": [{"start": 224.16, "end": 224.26, "word": " I'm"}, {"start": 224.26, "end": 224.54, "word": " sorry."}]}, {"start": 225.6, "end": 227.48, "text": " That I have led you into such peril.", "words": [{"start": 225.6, "end": 226.0, "word": " That"}, {"start": 226.0, "end": 226.16, "word": " I"}, {"start": 226.16, "end": 226.28, "word": " have"}, {"start": 226.28, "end": 226.46, "word": " led"}, {"start": 226.46, "end": 226.6, "word": " you"}, {"start": 226.6, "end": 226.76, "word": " into"}, {"start": 226.76, "end": 227.04, "word": " such"}, {"start": 227.04, "end": 227.48, "word": " peril."}]}, {"start": 229.28, "end": 231.86, "text": " I'm glad to have shared in your perils, Thorin.", "words": [{"start": 229.28, "end": 229.68, "word": " I'm"}, {"start": 229.68, "end": 230.08, "word": " glad"}, {"start": 230.08, "end": 230.32, "word": " to"}, {"start": 230.32, "end": 230.44, "word": " have"}, {"start": 230.44, "end": 230.66, "word": " shared"}, {"start": 230.66, "end": 230.8, "word": " in"}, {"start": 230.8, "end": 230.9, "word": " your"}, {"start": 230.9, "end": 231.3, "word": " perils,"}, {"start": 231.44, "end": 231.86, "word": " Thorin."}]}, {"start": 232.34, "end": 233.58, "text": " Each and every one of them.", "words": [{"start": 232.34, "end": 232.74, "word": " Each"}, {"start": 232.74, "end": 232.9, "word": " and"}, {"start": 232.9, "end": 233.08, "word": " every"}, {"start": 233.08, "end": 233.28, "word": " one"}, {"start": 233.28, "end": 233.42, "word": " of"}, {"start": 233.42, "end": 233.58, "word": " them."}]}, {"start": 281.11, "end": 282.67, "text": " No, no, no, no, no.", "words": [{"start": 281.11, "end": 281.51, "word": " No,"}, {"start": 281.67, "end": 281.95, "word": " no,"}, {"start": 282.01, "end": 282.19, "word": " no,"}, {"start": 282.29, "end": 282.45, "word": " no,"}, {"start": 282.45, "end": 282.67, "word": " no."}]}, {"start": 282.87, "end": 304.96, "text": " No, Thorin. Thorin.", "words": [{"start": 282.87, "end": 283.27, "word": " No,"}, {"start": 283.27, "end": 283.89, "word": " Thorin."}, {"start": 304.56, "end": 304.96, "word": " Thorin."}]}, {"start": 366.66, "end": 368.74, "text": " I cannot go back.", "words": [{"start": 366.66, "end": 366.9, "word": " I"}, {"start": 366.9, "end": 368.16, "word": " cannot"}, {"start": 368.16, "end": 368.44, "word": " go"}, {"start": 368.44, "end": 368.74, "word": " back."}]}, {"start": 369.1, "end": 371.42, "text": " Where will you go?", "words": [{"start": 369.1, "end": 369.58, "word": " Where"}, {"start": 370.92, "end": 371.1, "word": " will"}, {"start": 371.1, "end": 371.24, "word": " you"}, {"start": 371.24, "end": 371.42, "word": " go?"}]}, {"start": 373.23, "end": 374.21, "text": " I do not know.", "words": [{"start": 373.23, "end": 373.71, "word": " I"}, {"start": 373.71, "end": 373.83, "word": " do"}, {"start": 373.83, "end": 374.01, "word": " not"}, {"start": 374.01, "end": 374.21, "word": " know."}]}, {"start": 378.25, "end": 379.23, "text": " Find the Dunedain.", "words": [{"start": 378.25, "end": 378.73, "word": " Find"}, {"start": 378.73, "end": 378.85, "word": " the"}, {"start": 378.85, "end": 379.23, "word": " Dunedain."}]}, {"start": 381.38, "end": 383.32, "text": " There's a young ranger amongst them.", "words": [{"start": 381.38, "end": 381.86, "word": " There's"}, {"start": 381.86, "end": 381.96, "word": " a"}, {"start": 381.96, "end": 382.14, "word": " young"}, {"start": 382.14, "end": 382.68, "word": " ranger"}, {"start": 382.68, "end": 382.88, "word": " amongst"}, {"start": 382.88, "end": 383.32, "word": " them."}]}, {"start": 383.42, "end": 384.4, "text": " You should meet him.", "words": [{"start": 383.42, "end": 383.72, "word": " You"}, {"start": 383.72, "end": 383.94, "word": " should"}, {"start": 383.94, "end": 384.18, "word": " meet"}, {"start": 384.18, "end": 384.4, "word": " him."}]}, {"start": 386.16, "end": 388.3, "text": " His father, Arathorn, was a good man.", "words": [{"start": 386.16, "end": 386.56, "word": " His"}, {"start": 386.56, "end": 386.9, "word": " father,"}, {"start": 387.0, "end": 387.46, "word": " Arathorn,"}, {"start": 387.56, "end": 387.76, "word": " was"}, {"start": 387.76, "end": 387.86, "word": " a"}, {"start": 387.86, "end": 388.06, "word": " good"}, {"start": 388.06, "end": 388.3, "word": " man."}]}, {"start": 389.4, "end": 393.26, "text": " His son might grow to be a great one.", "words": [{"start": 389.4, "end": 389.88, "word": " His"}, {"start": 389.88, "end": 390.22, "word": " son"}, {"start": 390.22, "end": 391.96, "word": " might"}, {"start": 391.96, "end": 392.28, "word": " grow"}, {"start": 392.28, "end": 392.58, "word": " to"}, {"start": 392.58, "end": 392.7, "word": " be"}, {"start": 392.7, "end": 392.84, "word": " a"}, {"start": 392.84, "end": 393.04, "word": " great"}, {"start": 393.04, "end": 393.26, "word": " one."}]}, {"start": 396.6, "end": 397.42, "text": " What is his name?", "words": [{"start": 396.6, "end": 396.88, "word": " What"}, {"start": 396.88, "end": 397.02, "word": " is"}, {"start": 397.02, "end": 397.2, "word": " his"}, {"start": 397.2, "end": 397.42, "word": " name?"}]}, {"start": 398.56, "end": 400.4, "text": " He's known in the wild as Strider.", "words": [{"start": 398.56, "end": 399.04, "word": " He's"}, {"start": 399.04, "end": 399.24, "word": " known"}, {"start": 399.24, "end": 399.42, "word": " in"}, {"start": 399.42, "end": 399.5, "word": " the"}, {"start": 399.5, "end": 399.8, "word": " wild"}, {"start": 399.8, "end": 400.02, "word": " as"}, {"start": 400.02, "end": 400.4, "word": " Strider."}]}, {"start": 401.74, "end": 405.42, "text": " His true name you must discover for yourself.", "words": [{"start": 401.74, "end": 402.22, "word": " His"}, {"start": 402.22, "end": 402.52, "word": " true"}, {"start": 402.52, "end": 402.84, "word": " name"}, {"start": 402.84, "end": 404.14, "word": " you"}, {"start": 404.14, "end": 404.38, "word": " must"}, {"start": 404.38, "end": 404.82, "word": " discover"}, {"start": 404.82, "end": 405.12, "word": " for"}, {"start": 405.12, "end": 405.42, "word": " yourself."}]}, {"start": 410.78, "end": 414.1, "text": " Legolas, your mother loved you.", "words": [{"start": 410.78, "end": 411.26, "word": " Legolas,"}, {"start": 412.92, "end": 413.4, "word": " your"}, {"start": 413.4, "end": 413.64, "word": " mother"}, {"start": 413.64, "end": 413.9, "word": " loved"}, {"start": 413.9, "end": 414.1, "word": " you."}]}, {"start": 414.42, "end": 458.48, "text": " They want to bury him.", "words": [{"start": 414.42, "end": 414.64, "word": " They"}, {"start": 457.42, "end": 457.64, "word": " want"}, {"start": 457.64, "end": 457.84, "word": " to"}, {"start": 457.84, "end": 458.14, "word": " bury"}, {"start": 458.14, "end": 458.48, "word": " him."}]}, {"start": 458.78, "end": 481.11, "text": " So much.", "words": [{"start": 458.78, "end": 459.22, "word": " So"}, {"start": 480.63, "end": 481.11, "word": " much."}]}]