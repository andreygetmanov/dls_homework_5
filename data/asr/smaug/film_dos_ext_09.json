word": " iron"}]}, {"start": 297.92, "end": 299.84, "text": " and forged weapons are held there under lock and key.", "words": [{"start": 297.92, "end": 297.92, "word": " and"}, {"start": 297.92, "end": 298.26, "word": " forged"}, {"start": 298.26, "end": 298.66, "word": " weapons"}, {"start": 298.66, "end": 298.82, "word": " are"}, {"start": 298.82, "end": 299.0, "word": " held"}, {"start": 299.0, "end": 299.14, "word": " there"}, {"start": 299.14, "end": 299.32, "word": " under"}, {"start": 299.32, "end": 299.54, "word": " lock"}, {"start": 299.54, "end": 299.66, "word": " and"}, {"start": 299.66, "end": 299.84, "word": " key."}]}, {"start": 300.14, "end": 303.92, "text": " Thorin, why not take what's on offer and go?", "words": [{"start": 300.14, "end": 300.62, "word": " Thorin,"}, {"start": 300.72, "end": 302.52, "word": " why"}, {"start": 302.52, "end": 302.7, "word": " not"}, {"start": 302.7, "end": 302.9, "word": " take"}, {"start": 302.9, "end": 303.16, "word": " what's"}, {"start": 303.16, "end": 303.16, "word": " on"}, {"start": 303.16, "end": 303.42, "word": " offer"}, {"start": 303.42, "end": 303.64, "word": " and"}, {"start": 303.64, "end": 303.92, "word": " go?"}]}, {"start": 304.16, "end": 305.24, "text": " I've made do with less.", "words": [{"start": 304.16, "end": 304.54, "word": " I've"}, {"start": 304.54, "end": 304.7, "word": " made"}, {"start": 304.7, "end": 304.9, "word": " do"}, {"start": 304.9, "end": 305.02, "word": " with"}, {"start": 305.02, "end": 305.24, "word": " less."}]}, {"start": 305.44, "end": 306.28, "text": " So have you.", "words": [{"start": 305.44, "end": 305.92, "word": " So"}, {"start": 305.92, "end": 306.08, "word": " have"}, {"start": 306.08, "end": 306.28, "word": " you."}]}, {"start": 308.25, "end": 309.43, "text": " I say, believe now.", "words": [{"start": 308.25, "end": 308.73, "word": " I"}, {"start": 308.73, "end": 308.97, "word": " say,"}, {"start": 308.99, "end": 309.15, "word": " believe"}, {"start": 309.15, "end": 309.43, "word": " now."}]}, {"start": 309.73, "end": 310.83, "text": " You're not going anywhere.", "words": [{"start": 309.73, "end": 310.15, "word": " You're"}, {"start": 310.15, "end": 310.21, "word": " not"}, {"start": 310.21, "end": 310.43, "word": " going"}, {"start": 310.43, "end": 310.83, "word": " anywhere."}]}, {"start": 311.31, "end": 312.59, "text": " What did you say?", "words": [{"start": 311.31, "end": 311.79, "word": " What"}, {"start": 311.79, "end": 312.03, "word": " did"}, {"start": 312.03, "end": 312.21, "word": " you"}, {"start": 312.21, "end": 312.59, "word": " say?"}]}, {"start": 312.75, "end": 313.97, "text": " There are spies watching this house,", "words": [{"start": 312.75, "end": 312.85, "word": " There"}, {"start": 312.85, "end": 312.93, "word": " are"}, {"start": 312.93, "end": 313.09, "word": " spies"}, {"start": 313.09, "end": 313.47, "word": " watching"}, {"start": 313.47, "end": 313.67, "word": " this"}, {"start": 313.67, "end": 313.97, "word": " house,"}]}, {"start": 314.03, "end": 316.09, "text": " and probably every dock and wharf in the town.", "words": [{"start": 314.03, "end": 314.15, "word": " and"}, {"start": 314.15, "end": 314.39, "word": " probably"}, {"start": 314.39, "end": 314.67, "word": " every"}, {"start": 314.67, "end": 315.01, "word": " dock"}, {"start": 315.01, "end": 315.29, "word": " and"}, {"start": 315.29, "end": 315.59, "word": " wharf"}, {"start": 315.59, "end": 315.75, "word": " in"}, {"start": 315.75, "end": 315.81, "word": " the"}, {"start": 315.81, "end": 316.09, "word": " town."}]}, {"start": 317.23, "end": 318.63, "text": " You must wait till nightfall.", "words": [{"start": 317.23, "end": 317.71, "word": " You"}, {"start": 317.71, "end": 317.91, "word": " must"}, {"start": 317.91, "end": 318.07, "word": " wait"}, {"start": 318.07, "end": 318.23, "word": " till"}, {"start": 318.23, "end": 318.63, "word": " nightfall."}]}, {"start": 349.98, "end": 354.83, "text": " Ta, don't let them leave.", "words": [{"start": 349.98, "end": 350.46, "word": " Ta,"}, {"start": 350.46, "end": 350.94, "word": " don't"}, {"start": 354.39, "end": 354.49, "word": " let"}, {"start": 354.49, "end": 354.65, "word": " them"}, {"start": 354.65, "end": 354.83, "word": " leave."}]}, {"start": 380.47, "end": 381.97, "text": " In gun and lair?", "words": [{"start": 380.47, "end": 380.91, "word": " In"}, {"start": 380.91, "end": 381.25, "word": " gun"}, {"start": 381.25, "end": 381.65, "word": " and"}, {"start": 381.65, "end": 381.97, "word": " lair?"}]}, {"start": 382.89, "end": 383.61, "text": " Keogh-heem.", "words": [{"start": 382.89, "end": 383.37, "word": " Keogh"}, {"start": 383.37, "end": 383.61, "word": "-heem."}]}, {"start": 384.91, "end": 385.53, "text": " Dungun me.", "words": [{"start": 384.91, "end": 385.39, "word": " Dungun"}, {"start": 385.39, "end": 385.53, "word": " me."}]}, {"start": 388.32, "end": 392.28, "text": " Tauriel, you cannot hunt thirty orcs on your own.", "words": [{"start": 388.32, "end": 388.88, "word": " Tauriel,"}, {"start": 388.88, "end": 389.44, "word": " you"}, {"start": 389.44, "end": 390.1, "word": " cannot"}, {"start": 390.1, "end": 390.56, "word": " hunt"}, {"start": 390.56, "end": 391.0, "word": " thirty"}, {"start": 391.0, "end": 391.42, "word": " orcs"}, {"start": 391.42, "end": 391.8, "word": " on"}, {"start": 391.8, "end": 392.0, "word": " your"}, {"start": 392.0, "end": 392.28, "word": " own."}]}, {"start": 392.58, "end": 393.92, "text": " But I'm not Aurel.", "words": [{"start": 392.58, "end": 393.14, "word": " But"}, {"start": 393.14, "end": 393.36, "word": " I'm"}, {"start": 393.36, "end": 393.56, "word": " not"}, {"start": 393.56, "end": 393.92, "word": " Aurel."}]}, {"start": 395.38, "end": 396.74, "text": " You knew I would come.", "words": [{"start": 395.38, "end": 395.94, "word": " You"}, {"start": 395.94, "end": 396.14, "word": " knew"}, {"start": 396.14, "end": 396.3, "word": " I"}, {"start": 396.3, "end": 396.42, "word": " would"}, {"start": 396.42, "end": 396.74, "word": " come."}]}, {"start": 399.17, "end": 400.95, "text": " The king is angry, Tauriel.", "words": [{"start": 399.17, "end": 399.73, "word": " The"}, {"start": 399.73, "end": 399.93, "word": " king"}, {"start": 399.93, "end": 400.11, "word": " is"}, {"start": 400.11, "end": 400.43, "word": " angry,"}, {"start": 400.53, "end": 400.95, "word": " Tauriel."}]}, {"start": 401.35, "end": 404.69, "text": " For six hundred years my father has protected you, favored you.", "words": [{"start": 401.35, "end": 401.91, "word": " For"}, {"start": 401.91, "end": 402.13, "word": " six"}, {"start": 402.13, "end": 402.33, "word": " hundred"}, {"start": 402.33, "end": 402.61, "word": " years"}, {"start": 402.61, "end": 402.79, "word": " my"}, {"start": 402.79, "end": 403.07, "word": " father"}, {"start": 403.07, "end": 403.23, "word": " has"}, {"start": 403.23, "end": 403.55, "word": " protected"}, {"start": 403.55, "end": 403.89, "word": " you,"}, {"start": 403.99, "end": 404.43, "word": " favored"}, {"start": 404.43, "end": 404.69, "word": " you."}]}, {"start": 405.19, "end": 408.11, "text": " You defied his orders. You betrayed his trust.", "words": [{"start": 405.19, "end": 405.75, "word": " You"}, {"start": 405.75, "end": 406.17, "word": " defied"}, {"start": 406.17, "end": 406.27, "word": " his"}, {"start": 406.27, "end": 406.55, "word": " orders."}, {"start": 406.81, "end": 407.11, "word": " You"}, {"start": 407.11, "end": 407.39, "word": " betrayed"}, {"start": 407.39, "end": 407.69, "word": " his"}, {"start": 407.69, "end": 408.11, "word": " trust."}]}, {"start": 414.77, "end": 422.95, "text": " The king has never let orc filth from our lands, yet he would let this orc pack cross", "words": [{"start": 414.77, "end": 415.27, "word": " The"}, {"start": 415.27, "end": 415.53, "word": " king"}, {"start": 415.53, "end": 419.19, "word": " has"}, {"start": 419.19, "end": 419.53, "word": " never"}, {"start": 419.53, "end": 419.77, "word": " let"}, {"start": 419.77, "end": 420.09, "word": " orc"}, {"start": 420.09, "end": 420.43, "word": " filth"}, {"start": 420.43, "end": 420.63, "word": " from"}, {"start": 420.63, "end": 420.83, "word": " our"}, {"start": 420.83, "end": 421.17, "word": " lands,"}, {"start": 421.35, "end": 421.69, "word": " yet"}, {"start": 421.69, "end": 421.81, "word": " he"}, {"start": 421.81, "end": 421.93, "word": " would"}, {"start": 421.93, "end": 422.09, "word": " let"}, {"start": 422.09, "end": 422.25, "word": " this"}, {"start": 422.25, "end": 422.47, "word": " orc"}, {"start": 422.47, "end": 422.67, "word": " pack"}, {"start": 422.67, "end": 422.95, "word": " cross"}]}, {"start": 422.95, "end": 424.45, "text": " our borders and kill our prisoners.", "words": [{"start": 422.95, "end": 423.21, "word": " our"}, {"start": 423.21, "end": 423.61, "word": " borders"}, {"start": 423.61, "end": 423.77, "word": " and"}, {"start": 423.77, "end": 423.99, "word": " kill"}, {"start": 423.99, "end": 424.15, "word": " our"}, {"start": 424.15, "end": 424.45, "word": " prisoners."}]}, {"start": 424.81, "end": 426.15, "text": " It is not our fight.", "words": [{"start": 424.81, "end": 425.29, "word": " It"}, {"start": 425.29, "end": 425.43, "word": " is"}, {"start": 425.43, "end": 425.63, "word": " not"}, {"start": 425.63, "end": 425.81, "word": " our"}, {"start": 425.81, "end": 426.15, "word": " fight."}]}, {"start": 426.33, "end": 427.43, "text": " It is our fight.", "words": [{"start": 426.33, "end": 426.69, "word": " It"}, {"start": 426.69, "end": 426.87, "word": " is"}, {"start": 426.87, "end": 427.09, "word": " our"}, {"start": 427.09, "end": 427.43, "word": " fight."}]}, {"start": 428.45, "end": 429.93, "text": " It will not end here.", "words": [{"start": 428.45, "end": 428.95, "word": " It"}, {"start": 428.95, "end": 429.03, "word": " will"}, {"start": 429.03, "end": 429.25, "word": " not"}, {"start": 429.25, "end": 429.51, "word": " end"}, {"start": 429.51, "end": 429.93, "word": " here."}]}, {"start": 430.25, "end": 432.77, "text": " With every victory, this evil will grow.", "words": [{"start": 430.25, "end": 430.75, "word": " With"}, {"start": 430.75, "end": 431.21, "word": " every"}, {"start": 431.21, "end": 431.77, "word": " victory,"}, {"start": 431.85, "end": 431.97, "word": " this"}, {"start": 431.97, "end": 432.31, "word": " evil"}, {"start": 432.31, "end": 432.45, "word": " will"}, {"start": 432.45, "end": 432.77, "word": " grow."}]}, {"start": 433.45, "end": 436.03, "text": " If your father has his way, we will do nothing.", "words": [{"start": 433.45, "end": 433.95, "word": " If"}, {"start": 433.95, "end": 434.09, "word": " your"}, {"start": 434.09, "end": 434.39, "word": " father"}, {"start": 434.39, "end": 434.61, "word": " has"}, {"start": 434.61, "end": 434.79, "word": " his"}, {"start": 434.79, "end": 435.05, "word": " way,"}, {"start": 435.19, "end": 435.45, "word": " we"}, {"start": 435.45, "end": 435.61, "word": " will"}, {"start": 435.61, "end": 435.73, "word": " do"}, {"start": 435.73, "end": 436.03, "word": " nothing."}]}, {"start": 436.03, "end": 442.95, "text": " We will hide within our walls, live our lives away from the light, and let darkness descend.", "words": [{"start": 436.03, "end": 436.85, "word": " We"}, {"start": 436.85, "end": 437.05, "word": " will"}, {"start": 437.05, "end": 437.33, "word": " hide"}, {"start": 437.33, "end": 437.61, "word": " within"}, {"start": 437.61, "end": 437.85, "word": " our"}, {"start": 437.85, "end": 438.21, "word": " walls,"}, {"start": 438.39, "end": 439.31, "word": " live"}, {"start": 439.31, "end": 439.53, "word": " our"}, {"start": 439.53, "end": 439.95, "word": " lives"}, {"start": 439.95, "end": 440.17, "word": " away"}, {"start": 440.17, "end": 440.41, "word": " from"}, {"start": 440.41, "end": 440.53, "word": " the"}, {"start": 440.53, "end": 440.81, "word": " light,"}, {"start": 440.91, "end": 441.97, "word": " and"}, {"start": 441.97, "end": 442.11, "word": " let"}, {"start": 442.11, "end": 442.53, "word": " darkness"}, {"start": 442.53, "end": 442.95, "word": " descend."}]}, {"start": 444.78, "end": 446.42, "text": " Are we not part of this world?", "words": [{"start": 444.78, "end": 445.3, "word": " Are"}, {"start": 445.3, "end": 445.44, "word": " we"}, {"start": 445.44, "end": 445.58, "word": " not"}, {"start": 445.58, "end": 445.78, "word": " part"}, {"start": 445.78, "end": 445.98, "word": " of"}, {"start": 445.98, "end": 446.1, "word": " this"}, {"start": 446.1, "end": 446.42, "word": " world?"}]}, {"start": 447.96, "end": 452.42, "text": " Tell me, Mere Lung, when did we let evil become stronger than us?", "words": [{"start": 447.96, "end": 448.48, "word": " Tell"}, {"start": 448.48, "end": 448.78, "word": " me,"}, {"start": 448.82, "end": 449.02, "word": " Mere"}, {"start": 449.02, "end": 449.32, "word": " Lung,"}, {"start": 449.36, "end": 449.96, "word": " when"}, {"start": 449.96, "end": 450.22, "word": " did"}, {"start": 450.22, "end": 450.38, "word": " we"}, {"start": 450.38, "end": 450.6, "word": " let"}, {"start": 450.6, "end": 450.96, "word": " evil"}, {"start": 450.96, "end": 451.28, "word": " become"}, {"start": 451.28, "end": 451.9, "word": " stronger"}, {"start": 451.9, "end": 452.16, "word": " than"}, {"start": 452.16, "end": 452.42, "word": " us?"}]}, {"start": 458.25, "end": 459.87, "text": " Allobard, who are you after?", "words": [{"start": 458.25, "end": 458.77, "word": " Allobard,"}, {"start": 458.91, "end": 459.35, "word": " who"}, {"start": 459.35, "end": 459.49, "word": " are"}, {"start": 459.49, "end": 459.57, "word": " you"}, {"start": 459.57, "end": 459.87, "word": " after?"}]}, {"start": 461.41, "end": 465.59, "text": " There was a tapestry. An old one. Where's it gone?", "words": [{"start": 461.41, "end": 461.93, "word": " There"}, {"start": 461.93, "end": 462.05, "word": " was"}, {"start": 462.05, "end": 462.13, "word": " a"}, {"start": 462.13, "end": 462.53, "word": " tapestry."}, {"start": 463.67, "end": 464.19, "word": " An"}, {"start": 464.19, "end": 464.45, "word": " old"}, {"start": 464.45, "end": 464.67, "word": " one."}, {"start": 464.87, "end": 465.39, "word": " Where's"}, {"start": 465.39, "end": 465.39, "word": " it"}, {"start": 465.39, "end": 465.59, "word": " gone?"}]}, {"start": 465.73, "end": 467.03, "text": " What tapestry are you talking about?", "words": [{"start": 465.73, "end": 465.85, "word": " What"}, {"start": 465.85, "end": 466.35, "word": " tapestry"}, {"start": 466.35, "end": 466.53, "word": " are"}, {"start": 466.53, "end": 466.63, "word": " you"}, {"start": 466.63, "end": 466.83, "word": " talking"}, {"start": 466.83, "end": 467.03, "word": " about?"}]}, {"start": 467.77, "end": 468.41, "text": " This one.", "words": [{"start": 467.77, "end": 468.29, "word": " This"}, {"start": 468.29, "end": 468.41, "word": " one."}]}, {"start": 469.11, "end": 470.89, "text": " They were dwarves, I tell you.", "words": [{"start": 469.11, "end": 469.71, "word": " They"}, {"start": 469.71, "end": 469.89, "word": " were"}, {"start": 469.89, "end": 470.37, "word": " dwarves,"}, {"start": 470.37, "end": 470.51, "word": " I"}, {"start": 470.51, "end": 470.69, "word": " tell"}, {"start": 470.69, "end": 470.89, "word": " you."}]}, {"start": 470.89, "end": 471.95, "text": " Appeared out of nowhere.", "words": [{"start": 470.89, "end": 471.25, "word": " Appeared"}, {"start": 471.25, "end": 471.47, "word": " out"}, {"start": 471.47, "end": 471.63, "word": " of"}, {"start": 471.63, "end": 471.95, "word": " nowhere."}]}, {"start": 472.27, "end": 474.17, "text": " Full beards, fierce eyes.", "words": [{"start": 472.27, "end": 472.69, "word": " Full"}, {"start": 472.69, "end": 473.17, "word": " beards,"}, {"start": 473.25, "end": 473.71, "word": " fierce"}, {"start": 473.71, "end": 474.17, "word": " eyes."}]}, {"start": 474.55, "end": 475.91, "text": " I've never seen them like.", "words": [{"start": 474.55, "end": 475.15, "word": " I've"}, {"start": 475.15, "end": 475.27, "word": " never"}, {"start": 475.27, "end": 475.53, "word": " seen"}, {"start": 475.53, "end": 475.69, "word": " them"}, {"start": 475.69, "end": 475.91, "word": " like."}]}, {"start": 476.37, "end": 478.41, "text": " What are dwarves doing in these parts?", "words": [{"start": 476.37, "end": 476.97, "word": " What"}, {"start": 476.97, "end": 477.05, "word": " are"}, {"start": 477.05, "end": 477.57, "word": " dwarves"}, {"start": 477.57, "end": 477.77, "word": " doing"}, {"start": 477.77, "end": 477.93, "word": " in"}, {"start": 477.93, "end": 478.11, "word": " these"}, {"start": 478.11, "end": 478.41, "word": " parts?"}]}, {"start": 478.81, "end": 479.85, "text": " It's the prophecy.", "words": [{"start": 478.81, "end": 479.37, "word": " It's"}, {"start": 479.37, "end": 479.45, "word": " the"}, {"start": 479.45, "end": 479.85, "word": " prophecy."}]}, {"start": 480.27, "end": 480.87, "text": " Prophecy?", "words": [{"start": 480.27, "end": 480.87, "word": " Prophecy?"}]}, {"start": 481.15, "end": 483.05, "text": " Prophecy of Durin's folk.", "words": [{"start": 481.15, "end": 481.75, "word": " Prophecy"}, {"start": 481.75, "end": 481.85, "word": " of"}, {"start": 481.85, "end": 482.73, "word": " Durin's"}, {"start": 482.73, "end": 483.05, "word": " folk."}]}, {"start": 498.23, "end": 499.77, "text": " The all-teens will come true.", "words": [{"start": 498.23, "end": 498.63, "word": " The"}, {"start": 498.63, "end": 498.81, "word": " all"}, {"start": 498.81, "end": 499.07, "word": "-teens"}, {"start": 499.07, "end": 499.27, "word": " will"}, {"start": 499.27, "end": 499.47, "word": " come"}, {"start": 499.47, "end": 499.77, "word": " true."}]}, {"start": 500.13, "end": 501.89, "text": " Vast holes of treasure.", "words": [{"start": 500.13, "end": 500.69, "word": " Vast"}, {"start": 500.69, "end": 501.07, "word": " holes"}, {"start": 501.07, "end": 501.47, "word": " of"}, {"start": 501.47, "end": 501.89, "word": " treasure."}]}, {"start": 502.45, "end": 504.59, "text": " Silver and gold and jewels beyond measure.", "words": [{"start": 502.45, "end": 502.93, "word": " Silver"}, {"start": 502.93, "end": 503.13, "word": " and"}, {"start": 503.13, "end": 503.53, "word": " gold"}, {"start": 503.53, "end": 503.75, "word": " and"}, {"start": 503.75, "end": 503.99, "word": " jewels"}, {"start": 503.99, "end": 504.21, "word": " beyond"}, {"start": 504.21, "end": 504.59, "word": " measure."}]}, {"start": 504.89, "end": 505.85, "text": " Can you imagine?", "words": [{"start": 504.89, "end": 505.25, "word": " Can"}, {"start": 505.25, "end": 505.45, "word": " you"}, {"start": 505.45, "end": 505.85, "word": " imagine?"}]}, {"start": 506.11, "end": 507.09, "text": " Can it really be true?", "words": [{"start": 506.11, "end": 506.41, "word": " Can"}, {"start": 506.41, "end": 506.57, "word": " it"}, {"start": 506.57, "end": 506.75, "word": " really"}, {"start": 506.75, "end": 506.87, "word": " be"}, {"start": 506.87, "end": 507.09, "word": " true?"}]}, {"start": 507.71, "end": 509.61, "text": " Has the Lord of Silver Fountains returned?", "words": [{"start": 507.71, "end": 508.01, "word": " Has"}, {"start": 508.01, "end": 508.17, "word": " the"}, {"start": 508.17, "end": 508.39, "word": " Lord"}, {"start": 508.39, "end": 508.57, "word": " of"}, {"start": 508.57, "end": 508.77, "word": " Silver"}, {"start": 508.77, "end": 509.31, "word": " Fountains"}, {"start": 509.31, "end": 509.61, "word": " returned?"}]}, {"start": 510.37, "end": 512.59, "text": " The Lord of Silver Fountains?", "words": [{"start": 510.37, "end": 510.97, "word": " The"}, {"start": 510.97, "end": 511.29, "word": " Lord"}, {"start": 511.29, "end": 511.49, "word": " of"}, {"start": 511.49, "end": 511.85, "word": " Silver"}, {"start": 511.85, "end": 512.59, "word": " Fountains?"}]}, {"start": 513.13, "end": 518.96, "text": " The king of Carvenstall, the king beneath the mountain.", "words": [{"start": 513.13, "end": 513.63, "word": " The"}, {"start": 513.63, "end": 514.09, "word": " king"}, {"start": 514.09, "end": 514.35, "word": " of"}, {"start": 514.35, "end": 515.21, "word": " Carvenstall,"}, {"start": 515.37, "end": 515.91, "word": " the"}, {"start": 518.02, "end": 518.22, "word": " king"}, {"start": 518.22, "end": 518.5, "word": " beneath"}, {"start": 518.5, "end": 518.68, "word": " the"}, {"start": 518.68, "end": 518.96, "word": " mountain."}]}, {"start": 519.16, "end": 527.87, "text": " Hell shall ring in gladness at the mountain king's return,", "words": [{"start": 519.16, "end": 519.56, "word": " Hell"}, {"start": 524.81, "end": 525.09, "word": " shall"}, {"start": 525.09, "end": 525.45, "word": " ring"}, {"start": 525.45, "end": 525.65, "word": " in"}, {"start": 525.65, "end": 526.19, "word": " gladness"}, {"start": 526.19, "end": 526.41, "word": " at"}, {"start": 526.41, "end": 526.55, "word": " the"}, {"start": 526.55, "end": 526.81, "word": " mountain"}, {"start": 526.81, "end": 527.43, "word": " king's"}, {"start": 527.43, "end": 527.87, "word": " return,"}]}, {"start": 528.71, "end": 533.55, "text": " but all shall fail in sadness, and the lake will shine.", "words": [{"start": 528.71, "end": 529.23, "word": " but"}, {"start": 529.23, "end": 529.59, "word": " all"}, {"start": 529.59, "end": 529.91, "word": " shall"}, {"start": 529.91, "end": 530.35, "word": " fail"}, {"start": 530.35, "end": 530.57, "word": " in"}, {"start": 530.57, "end": 531.11, "word": " sadness,"}, {"start": 531.39, "end": 532.37, "word": " and"}, {"start": 532.37, "end": 532.55, "word": " the"}, {"start": 532.55, "end": 532.85, "word": " lake"}, {"start": 532.85, "end": 533.01, "word": " will"}, {"start": 533.01, "end": 533.55, "word": " shine."}]}, {"start": 537.12, "end": 539.22, "text": " Da, I tried to stop them.", "words": [{"start": 537.12, "end": 537.56, "word": " Da,"}, {"start": 537.72, "end": 538.2, "word": " I"}, {"start": 538.2, "end": 538.46, "word": " tried"}, {"start": 538.46, "end": 538.7, "word": " to"}, {"start": 538.7, "end": 539.0, "word": " stop"}, {"start": 539.0, "end": 539.22, "word": " them."}]}, {"start": 539.3, "end": 540.12, "text": " How long have they been gone?", "words": [{"start": 539.3, "end": 539.44, "word": " How"}, {"start": 539.44, "end": 539.58, "word": " long"}, {"start": 539.58, "end": 539.62, "word": " have"}, {"start": 539.62, "end": 539.78, "word": " they"}, {"start": 539.78, "end": 539.86, "word": " been"}, {"start": 539.86, "end": 540.12, "word": " gone?"}]}, {"start": 540.56, "end": 565.08, "text": " Who dragged out that nonsense?", "words": [{"start": 540.56, "end": 540.76, "word": " Who"}, {"start": 562.42, "end": 563.96, "word": " dragged"}, {"start": 563.96, "end": 564.34, "word": " out"}, {"start": 564.34, "end": 564.52, "word": " that"}, {"start": 564.52, "end": 565.08, "word": " nonsense?"}]}, {"start": 565.54, "end": 566.54, "text": " People, sire.", "words": [{"start": 565.54, "end": 566.06, "word": " People,"}, {"start": 566.22, "end": 566.54, "word": " sire."}]}, {"start": 567.3, "end": 571.24, "text": " The gathering in the streets are saying that a king will return to the lonely mountain,", "words": [{"start": 567.3, "end": 567.82, "word": " The"}, {"start": 567.82, "end": 568.14, "word": " gathering"}, {"start": 568.14, "end": 568.36, "word": " in"}, {"start": 568.36, "end": 568.42, "word": " the"}, {"start": 568.42, "end": 568.8, "word": " streets"}, {"start": 568.8, "end": 568.98, "word": " are"}, {"start": 568.98, "end": 569.2, "word": " saying"}, {"start": 569.2, "end": 569.38, "word": " that"}, {"start": 569.38, "end": 569.48, "word": " a"}, {"start": 569.48, "end": 569.72, "word": " king"}, {"start": 569.72, "end": 569.94, "word": " will"}, {"start": 569.94, "end": 570.3, "word": " return"}, {"start": 570.3, "end": 570.56, "word": " to"}, {"start": 570.56, "end": 570.66, "word": " the"}, {"start": 570.66, "end": 570.9, "word": " lonely"}, {"start": 570.9, "end": 571.24, "word": " mountain,"}]}, {"start": 571.88, "end": 574.64, "text": " and that the rivers will once more run with gold.", "words": [{"start": 571.88, "end": 572.4, "word": " and"}, {"start": 572.4, "end": 572.54, "word": " that"}, {"start": 572.54, "end": 572.64, "word": " the"}, {"start": 572.64, "end": 572.98, "word": " rivers"}, {"start": 572.98, "end": 573.24, "word": " will"}, {"start": 573.24, "end": 573.44, "word": " once"}, {"start": 573.44, "end": 573.72, "word": " more"}, {"start": 573.72, "end": 574.04, "word": " run"}, {"start": 574.04, "end": 574.3, "word": " with"}, {"start": 574.3, "end": 574.64, "word": " gold."}]}, {"start": 576.26, "end": 579.74, "text": " Rivers of gold, poppy, cock.", "words": [{"start": 576.26, "end": 576.74, "word": " Rivers"}, {"start": 576.74, "end": 576.96, "word": " of"}, {"start": 576.96, "end": 577.46, "word": " gold,"}, {"start": 577.58, "end": 578.52, "word": " poppy,"}, {"start": 578.54, "end": 579.74, "word": " cock."}]}, {"start": 580.22, "end": 584.38, "text": " As you say, sire. But people will believe what they want to believe.", "words": [{"start": 580.22, "end": 580.7, "word": " As"}, {"start": 580.7, "end": 580.84, "word": " you"}, {"start": 580.84, "end": 581.14, "word": " say,"}, {"start": 581.26, "end": 581.64, "word": " sire."}, {"start": 582.32, "end": 582.8, "word": " But"}, {"start": 582.8, "end": 583.1, "word": " people"}, {"start": 583.1, "end": 583.24, "word": " will"}, {"start": 583.24, "end": 583.56, "word": " believe"}, {"start": 583.56, "end": 583.74, "word": " what"}, {"start": 583.74, "end": 583.84, "word": " they"}, {"start": 583.84, "end": 584.08, "word": " want"}, {"start": 584.08, "end": 584.14, "word": " to"}, {"start": 584.14, "end": 584.38, "word": " believe."}]}, {"start": 585.4, "end": 587.6, "text": " It's been a long time since they've seen any riches.", "words": [{"start": 585.4, "end": 585.88, "word": " It's"}, {"start": 585.88, "end": 585.94, "word": " been"}, {"start": 585.94, "end": 586.04, "word": " a"}, {"start": 586.04, "end": 586.16, "word": " long"}, {"start": 586.16, "end": 586.4, "word": " time"}, {"start": 586.4, "end": 586.6, "word": " since"}, {"start": 586.6, "end": 586.82, "word": " they've"}, {"start": 586.82, "end": 587.02, "word": " seen"}, {"start": 587.02, "end": 587.26, "word": " any"}, {"start": 587.26, "end": 587.6, "word": " riches."}]}, {"start": 588.22, "end": 590.6, "text": " The old tales offer them hope.", "words": [{"start": 588.22, "end": 588.7, "word": " The"}, {"start": 588.7, "end": 588.84, "word": " old"}, {"start": 588.84, "end": 589.2, "word": " tales"}, {"start": 589.2, "end": 590.2, "word": " offer"}, {"start": 590.2, "end": 590.36, "word": " them"}, {"start": 590.36, "end": 590.6, "word": " hope."}]}]